{
  "name": "@papercusp/git-graph",
  "version": "0.0.1",
  "private": true,
  "description": "React components for rendering a git commit graph (commit list, commit detail, diff tooltips). Brand-value-free; styling injected by consumers via git-graph.css.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/git-graph.css": "./src/git-graph.css",
    "./git-graph.css": "./src/git-graph.css"
  },
  "peerDependencies": {
    "@radix-ui/react-select": "*",
    "@radix-ui/react-tooltip": "*",
    "lucide-react": "*",
    "react": "^18 || ^19"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.23",
    "react-diff-view": "^3.3.3"
  }
}
