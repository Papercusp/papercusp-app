{
  "name": "@papercusp/agent-roster",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Headless agent-roster presentation — fleet grouping/ordering, activity-liveness and thinking predicates, display-name and glyph resolution, machine tabs, and the row/section rendering. Data arrives as props; host chrome (popover, tooltip, dots), labels and row/bulk actions enter through injected components and callbacks, so no host path is imported.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./logic": {
      "types": "./src/logic.ts",
      "import": "./src/logic.ts",
      "default": "./src/logic.ts"
    },
    "./styles": {
      "types": "./src/roster-styles.ts",
      "import": "./src/roster-styles.ts",
      "default": "./src/roster-styles.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./sessions": {
      "types": "./src/sessions.ts",
      "import": "./src/sessions.ts",
      "default": "./src/sessions.ts"
    }
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@papercusp/test-config": "*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.4"
  }
}
