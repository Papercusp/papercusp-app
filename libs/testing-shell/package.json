{
  "name": "@papercusp/testing-shell",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Shared testing-domains registry + UI shell. Consumed by /admin/testing (operator-vite) and the harness Tests tab (operator). Registry is pure data; the panel/shell take an injected dataSource so the same component drives both the admin and harness API surfaces.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": ["./src/llm/asserts/*.ts"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./registry": {
      "types": "./src/registry.ts",
      "import": "./src/registry.ts",
      "default": "./src/registry.ts"
    },
    "./data-source": {
      "types": "./src/data-source.ts",
      "import": "./src/data-source.ts",
      "default": "./src/data-source.ts"
    },
    "./census": {
      "types": "./src/census/index.ts",
      "import": "./src/census/index.ts",
      "default": "./src/census/index.ts"
    },
    "./glob": {
      "types": "./src/glob.ts",
      "import": "./src/glob.ts",
      "default": "./src/glob.ts"
    },
    "./llm": {
      "types": "./src/llm/index.ts",
      "import": "./src/llm/index.ts",
      "default": "./src/llm/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./server/k6-routes": {
      "types": "./src/server/k6-routes.ts",
      "import": "./src/server/k6-routes.ts",
      "default": "./src/server/k6-routes.ts"
    },
    "./web/chaos-runner": {
      "default": "./src/web/chaos-runner.mjs"
    },
    "./server/stagehand-runner": {
      "default": "./src/server/stagehand-runner.mjs"
    }
  },
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "@papercusp/test-config": "*",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "@papercusp/model-pricing": "*",
    "react": ">=18",
    "nuqs": ">=2",
    "hono": ">=4",
    "playwright": "*",
    "@browserbasehq/stagehand": "*",
    "gremlins.js": ">=2",
    "fast-check": ">=4"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "@browserbasehq/stagehand": {
      "optional": true
    },
    "gremlins.js": {
      "optional": true
    }
  }
}
