--
-- Completion of mig 295 (WI-148 workspace-identity restamp) for the harness-
-- keyed harness_shared tables 295 did not cover, which still hold rows under
-- workspace_id='default'. Discharges data-scoping-audit P-007 +
-- workspace-data-isolation-leaks P-002 + P-006 (the audit found these are one
-- migration). Owner-gated; LOCKSTEP with the same coord/identity restart 295/391
-- used (migrations-before-serve → health + path-verify → rollback-on-fail).
--
-- CONTRACT (inherited verbatim from 295 — DO NOT weaken):
--   * Registry-driven + COLLISION-SAFE: a 'default' row moves only when its
--     harness maps to EXACTLY ONE non-default workspace. A slug in >1 non-default
--     workspaces, or in none, is LEFT under 'default' (fail-safe).
--   * IDEMPOTENT: every move is gated `WHERE workspace_id='default'`; a re-run, or
--     a clean DB with no 'default' residue, moves 0 rows.
--   * Capture/CDC triggers on the moved tables are quieted for the bulk correction
--     so a workspace-id fix does not storm substrate_outbox as fresh local writes
--     (391's "only triggers actually present are touched" idiom).
--   * The runner wraps this file in ONE transaction; a failure (incl. the guard)
--     rolls back the whole move AND restores every disabled trigger. No
--     \set / BEGIN / COMMIT here (the runner owns the txn).
--
-- ROLLBACK: inverse per-table UPDATE over the same _wsmap425
--   (SET workspace_id='default' ... WHERE workspace_id = m.real_ws AND <key> = m.slug);
--   write the exact inverse here once the table list is filled.

-- ── 1. collision-safe map: slug → its UNIQUE non-default workspace ────────────
--    (verbatim from 295; session-temp so it survives each statement's implicit
--    commit under plain `psql -f` as well as the runner's single-txn wrap.)
DROP TABLE IF EXISTS _wsmap425;
CREATE TEMP TABLE _wsmap425 AS
SELECT slug, real_ws FROM (
  SELECT slug, max(workspace_id) AS real_ws, count(*) AS n FROM (
    SELECT DISTINCT r.workspace_id, p->>'slug' AS slug
      FROM harness_shared.harness_registry r,
           jsonb_array_elements(COALESCE(r.payload->'projects','[]'::jsonb)) p
     WHERE r.workspace_id NOT IN ('default','*','scratch')
  ) d GROUP BY slug
) m WHERE n = 1;

