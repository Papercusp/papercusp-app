-- Migration 1163 — indexed simple-token recall for compact transcript terms.
--
-- English stemming intentionally makes a pasted compact domain/product token
-- such as `furnishedfinder` incomparable with the visible label `Furnished
-- Finder`; the simple dictionary preserves literal tokens from URLs and other
-- identifiers. This is an additive, generated column so ingest writers need
-- no new code path, and the GIN index keeps the fallback bounded on the
-- session_turns corpus.
--
-- The `.DRAFT` suffix is intentional while the source/test pair is authored:
-- the migration runner only applies the armed `.sql` filename.

ALTER TABLE harness_shared.session_turns
  ADD COLUMN IF NOT EXISTS text_simple_tsv tsvector
    GENERATED ALWAYS AS (
      to_tsvector('simple', lower(left(text, 20000)))
    ) STORED;

CREATE INDEX IF NOT EXISTS session_turns_simple_tsv_idx
  ON harness_shared.session_turns USING gin (text_simple_tsv);

COMMENT ON COLUMN harness_shared.session_turns.text_simple_tsv IS
  'Literal normalized-token index for bounded compact URL/domain transcript search; distinct from English-stemmed text_tsv.';
