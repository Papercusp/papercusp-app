DO $session_part_tool_names$
DECLARE
  changed bigint;
BEGIN
  LOOP
    WITH batch AS MATERIALIZED (
      SELECT p.ctid, m.canonical
        FROM harness_shared.session_turn_parts AS p
        JOIN session_part_tool_name_backfill_map AS m
          ON m.alias = p.tool_name
       WHERE p.workspace_id = 'default'
         AND p.tool_name IS DISTINCT FROM m.canonical
       ORDER BY p.ingested_at ASC, p.source_kind ASC, p.session_id ASC, p.part_idx ASC
       LIMIT 50000
    )
    UPDATE harness_shared.session_turn_parts AS p
       SET tool_name = batch.canonical
      FROM batch
     WHERE p.ctid = batch.ctid;

    GET DIAGNOSTICS changed = ROW_COUNT;
    EXIT WHEN changed = 0;
  END LOOP;
END
$session_part_tool_names$;

