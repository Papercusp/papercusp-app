    },
    "./prompt-build": {
      "types": "./src/prompt-build.ts",
      "import": "./src/prompt-build.ts",
      "default": "./src/prompt-build.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:legacy": "node --test --test-global-setup=monorepo-host-preflight.mjs --import tsx src/**/*.test.ts",
    "typecheck": "node ../../../../scripts/lint-tsc-orchestrator.mjs"
  },
  "dependencies": {
    "@papercusp/file-claim": "*",
    "@papercusp/model-pricing": "*",
    "@papercusp/locks": "*",
    "@papercusp/harness": "*",
    "@papercusp/rules": "*",
    "@papercusp/step-program": "*",
    "postgres": "^3.4.5",
    "tsx": "^4.7.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@papercusp/test-config": "*",
    "vitest": "^4.1.4"
  }
}
