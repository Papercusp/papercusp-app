{
  "name": "@papercusp/orchestrator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "TypeScript port of the Papercusp harness orchestrator. Default since v0.0.x — set PAPERCUSP_USE_TS_ORCHESTRATOR=0 only as an emergency escape hatch back to the deprecated bash run.sh. Drops the bash prereq for Windows users while keeping the agent CLI shell-out (default `omp -p` via Meridian + Claude Max OAuth, or `claude -p` when AGENT_BACKEND=claude-code) so Claude Max subscriptions continue to work without API keys.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./state": {
      "types": "./src/state.ts",
      "import": "./src/state.ts",
      "default": "./src/state.ts"
    },
    "./role-prompt": {
      "types": "./src/role-prompt-from-slug.ts",
      "import": "./src/role-prompt-from-slug.ts",
      "default": "./src/role-prompt-from-slug.ts"
    },
    "./role-models": {
      "types": "./src/role-models.ts",
      "import": "./src/role-models.ts",
      "default": "./src/role-models.ts"
    },
    "./managed-capability-contract": {
      "types": "./src/managed-capability-contract.ts",
      "import": "./src/managed-capability-contract.ts",
      "default": "./src/managed-capability-contract.ts"
    },
    "./managed-capability-policy": {
      "types": "./src/managed-capability-policy.ts",
      "import": "./src/managed-capability-policy.ts",
      "default": "./src/managed-capability-policy.ts"
    },
    "./native-scheduler-deny": {
      "types": "./src/native-scheduler-deny.ts",
      "import": "./src/native-scheduler-deny.ts",
      "default": "./src/native-scheduler-deny.ts"
    },
    "./native-tool-search-deny": {
      "types": "./src/native-tool-search-deny.ts",
      "import": "./src/native-tool-search-deny.ts",
      "default": "./src/native-tool-search-deny.ts"
    },
    "./no-subagent-deny": {
      "types": "./src/no-subagent-deny.ts",
      "import": "./src/no-subagent-deny.ts",
      "default": "./src/no-subagent-deny.ts"
    },
    "./owner-desktop-notify-deny": {
      "types": "./src/owner-desktop-notify-deny.ts",
      "import": "./src/owner-desktop-notify-deny.ts",
      "default": "./src/owner-desktop-notify-deny.ts"
