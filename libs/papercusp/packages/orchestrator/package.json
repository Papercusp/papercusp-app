    },
    "./mode-catalog": {
      "types": "./src/blueprint/mode-catalog.generated.ts",
      "import": "./src/blueprint/mode-catalog.generated.ts",
      "default": "./src/blueprint/mode-catalog.generated.ts"
    },
    "./blueprint/params": {
      "types": "./src/blueprint/params.ts",
      "import": "./src/blueprint/params.ts",
      "default": "./src/blueprint/params.ts"
    },
    "./blueprint/schema": {
      "types": "./src/blueprint/schema.ts",
      "import": "./src/blueprint/schema.ts",
      "default": "./src/blueprint/schema.ts"
    },
    "./run-output-pg": {
      "types": "./src/run-output-pg.ts",
      "import": "./src/run-output-pg.ts",
