      "default": "./src/session-launch-dirs.ts"
    },
    "./fleet-claude-token": {
      "types": "./src/fleet-claude-token.ts",
      "import": "./src/fleet-claude-token.ts",
      "default": "./src/fleet-claude-token.ts"
    },
    "./spawn-signing-core": {
      "types": "./src/spawn-signing-core.ts",
      "import": "./src/spawn-signing-core.ts",
      "default": "./src/spawn-signing-core.ts"
    },
    "./codex-gateway-config": {
      "types": "./src/codex-gateway-config.ts",
      "import": "./src/codex-gateway-config.ts",
      "default": "./src/codex-gateway-config.ts"
    },
    "./omp-gateway-config": {
      "types": "./src/omp-gateway-config.ts",
