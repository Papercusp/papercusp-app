{
  "$schema": "https://papercuspai.com/schema/papercusp-plugin.schema.json",
  "kind": "plugin",
  "name": "@papercupai/meeting-prep-brief",
  "version": "0.1.0",
  "papercusp": "^0.1.0",
  "description": "Starter trigger pack: an upcoming Calendar event launches a private pre-meeting brief.",
  "author": "Papercusp",
  "publisher": "@papercupai",
  "license": "MIT",
  "versionPin": { "mode": "exact" },
  "capabilities": [],
  "oauth": [
    {
      "provider": "google",
      "scopes": [
        "https://www.googleapis.com/auth/gmail.readonly",
        "https://www.googleapis.com/auth/calendar.readonly",
        "https://www.googleapis.com/auth/contacts.readonly"
      ],
      "fieldName": "googleWorkspace"
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["googleWorkspace"],
    "properties": {
      "googleWorkspace": {
        "type": "string",
        "title": "Google Workspace connection",
        "secret": true,
        "shareable": false,
        "snapshotPolicy": "strip",
        "oauth": {
          "provider": "google",
          "scopes": [
            "https://www.googleapis.com/auth/gmail.readonly",
            "https://www.googleapis.com/auth/calendar.readonly",
            "https://www.googleapis.com/auth/contacts.readonly"
          ]
        },
        "description": "OAuth credential for Calendar plus optional Gmail/Contacts context. It is stripped from snapshots."
      }
    }
  },
  "triggerPack": {
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leadMinutes": {
          "type": "integer",
          "title": "Lead time in minutes",
          "minimum": 1,
          "maximum": 1440,
          "default": 15
        },
        "briefStyle": {
          "type": "string",
          "title": "Brief style",
          "enum": ["concise", "detailed"],
          "default": "concise"
        }
      }
    },
    "defaultStormPolicy": {
      "maxRuns": 3,
      "windowSeconds": 3600
    },
    "targets": [
      {
        "id": "prepare-brief",
        "kind": "plan",
        "path": "plan.md",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trigger"],
          "properties": {
            "trigger": {
              "type": "object",
              "additionalProperties": true,
              "required": ["key", "source", "event", "sourceId", "externalId", "dedupeKey", "payload"],
              "properties": {
                "key": { "const": "ext:gcal:event-upcoming" },
                "source": { "const": "gcal" },
                "event": { "const": "event-upcoming" },
                "sourceId": { "type": "string", "minLength": 1 },
                "externalId": { "type": "string", "minLength": 1 },
                "dedupeKey": { "type": "string", "minLength": 1 },
                "payload": {
                  "type": "object",
                  "datatype": "calendar-event",
                  "additionalProperties": true,
                  "required": ["id", "start", "attendees"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "summary": { "type": "string" },
                    "start": { "type": "string", "minLength": 1 },
                    "end": { "type": "string" },
                    "attendees": { "type": "array", "minItems": 1 }
                  }
                }
              }
            },
            "leadMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440,
              "default": 15
            },
            "briefStyle": {
              "type": "string",
              "enum": ["concise", "detailed"],
              "default": "concise"
            }
          }
        }
      }
    ],
    "bindings": [
      {
        "id": "upcoming-meeting-to-brief",
        "source": {
          "kind": "external",
          "sourceKind": "gcal",
          "oauthField": "googleWorkspace"
        },
        "target": "prepare-brief",
        "eventPattern": "ext:gcal:event-upcoming",
        "filter": {
          "attendees.0": { "exists": true }
        },
        "mapping": {
          "mode": "payload-context"
        }
      }
    ],
    "edges": []
  },
  "icon": "CalendarClock"
}
