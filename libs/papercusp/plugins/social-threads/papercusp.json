{
  "$schema": "https://papercuspai.com/schema/papercusp-plugin.schema.json",
  "kind": "plugin",
  "name": "@papercupai/social-threads",
  "version": "0.1.0",
  "papercusp": "^0.1.0",
  "description": "Threads platform trigger pack: Watches a Threads account for its own posts and for replies in its conversations. Records each event and publishes nothing.",
  "author": "Papercusp",
  "publisher": "@papercupai",
  "license": "MIT",
  "versionPin": {
    "mode": "exact"
  },
  "capabilities": [],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "threadsToken"
    ],
    "properties": {
      "threadsUserId": {
        "type": "string",
        "title": "Threads user id",
        "shareable": true,
        "description": "The Threads account to watch. Public, so it travels with a share."
      },
      "threadsToken": {
        "type": "string",
        "title": "Threads access token",
        "secret": true,
        "shareable": false,
        "snapshotPolicy": "strip",
        "description": "A Threads access token. Deliberately NOT an OAuth-connect field: Threads authorizes against graph.threads.net under a SEPARATE app id, and those endpoints are not yet verified here."
      }
    }
  },
  "triggerPack": {
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "escalationGuidance": {
          "type": "string",
          "title": "What needs a human",
          "default": "Anything hostile, legal, financial, or that would commit the owner to something they have not said.",
          "maxLength": 1000
        }
      }
    },
    "defaultStormPolicy": {
      "maxRuns": 16,
      "windowSeconds": 300
    },
    "targets": [
      {
        "id": "record-threads-event",
        "kind": "plan",
        "path": "plan.md",
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trigger"
          ],
          "properties": {
            "trigger": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "key",
                "source",
                "event",
                "sourceId",
                "externalId",
                "dedupeKey",
                "payload"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^ext:threads:(post|reply)$"
                },
                "source": {
                  "type": "string",
                  "const": "threads"
                },
                "event": {
                  "type": "string",
                  "enum": [
                    "post",
                    "reply"
                  ]
                },
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "externalId": {
                  "type": "string",
                  "minLength": 1
                },
                "dedupeKey": {
                  "type": "string",
                  "minLength": 1
                },
                "payload": {
                  "type": "object",
                  "datatype": "social-post",
                  "additionalProperties": true,
                  "required": [
                    "id",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string"
                    },
                    "author": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "replyToId": {
                      "type": "string"
                    },
                    "occurredAt": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "escalationGuidance": {
              "type": "string",
              "maxLength": 1000,
              "default": "Anything hostile, legal, financial, or that would commit the owner to something they have not said."
            }
          }
        }
      }
    ],
    "bindings": [
      {
        "id": "threads-post",
        "source": {
          "kind": "external",
          "sourceKind": "threads"
        },
        "target": "record-threads-event",
        "eventPattern": "ext:threads:post",
        "filter": {
          "all": [
            {
              "id": {
                "exists": true
              }
            },
            {
              "text": {
                "exists": true
              }
            }
          ]
        },
        "mapping": {
          "mode": "payload-context"
        }
      },
      {
        "id": "threads-reply",
        "source": {
          "kind": "external",
          "sourceKind": "threads"
        },
        "target": "record-threads-event",
        "eventPattern": "ext:threads:reply",
        "filter": {
          "all": [
            {
              "id": {
                "exists": true
              }
            },
            {
              "text": {
                "exists": true
              }
            }
          ]
        },
        "mapping": {
          "mode": "payload-context"
        }
      }
    ],
    "edges": []
  },
  "icon": "AtSign"
}
