{
  "name": "@papercusp/papercusp-shared",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./agent": {
      "types": "./src/agent/index.ts",
      "import": "./src/agent/index.ts",
      "default": "./src/agent/index.ts"
    },
    "./agent/turn-error": {
      "types": "./src/agent/turn-error.ts",
      "import": "./src/agent/turn-error.ts",
      "default": "./src/agent/turn-error.ts"
    },
    "./resilience": {
      "types": "./src/resilience/index.ts",
      "import": "./src/resilience/index.ts",
      "default": "./src/resilience/index.ts"
    },
    "./*.css": "./src/*.css"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.81.0",
    "@papercusp/grid-core": "*",
    "@papercusp/model-pricing": "*",
    "@papercusp/module-singleton": "*"
  },
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "@papercusp/test-config": "*",
    "fast-check": "^4.7.0",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "@radix-ui/react-tooltip": "^1.2.8"
  }
}
