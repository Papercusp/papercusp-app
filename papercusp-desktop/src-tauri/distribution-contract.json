{
  "schemaVersion": 1,
  "contract": "papercusp-gui-server-distribution-v1",
  "decisions": [
    "linux-desktop-split-server-like-mac-win-2026-07-19#D-001",
    "linux-desktop-split-server-like-mac-win-2026-07-19#D-002",
    "linux-desktop-split-server-like-mac-win-2026-07-19#D-003",
    "linux-desktop-split-server-like-mac-win-2026-07-19#D-004",
    "linux-desktop-split-server-like-mac-win-2026-07-19#D-005"
  ],
  "sharedSpa": {
    "source": "apps/operator-vite/dist",
    "guiResourceGlob": "sidecar/spa/**/*",
    "serverResourceGlob": "sidecar/spa/**/*",
    "browserTransport": [
      "http",
      "sse"
    ],
    "desktopTransport": [
      "tauri-endpoint-ipc",
      "http-fallback",
      "sse-adapter"
    ],
    "nativeOnlySeams": [
      "tauri-command",
      "binary-transfer",
      "native-pty",
      "websocket"
    ],
    "rule": "One generated SPA and one client API. The browser keeps native HTTP/SSE; Tauri installs adapters without forking UI code."
  },
  "gui": {
    "productName": "Papercusp GUI",
    "identifier": "com.papercusp.gui",
    "packageNames": {
      "linux": "papercusp-gui",
      "macos": "Papercusp GUI.app",
      "windows": "Papercusp GUI"
    },
    "installedIdentities": {
      "linuxExecutable": "/usr/bin/papercusp-desktop",
      "linuxDesktopEntry": "Papercusp GUI.desktop",
      "linuxIcon": "papercusp-desktop",
      "linuxResourceRoot": "/usr/lib/Papercusp GUI",
      "macosInstallRoot": "/Applications/Papercusp GUI.app",
      "windowsInstallRoot": "%LOCALAPPDATA%\\Papercusp GUI"
    },
    "resourceAllowlist": [
      {
        "glob": "sidecar/spa/**/*",
        "owner": "shared-generated-ui",
        "platforms": [
          "linux",
          "macos",
          "windows"
        ]
      },
      {
        "glob": "resources/libPapercuspTermShim.dylib",
        "owner": "gui-shell",
        "platforms": [
          "macos"
        ],
        "optional": true
      }
    ],
    "forbiddenResourcePrefixes": [
      "seed/",
      "sidecar/apps/",
      "sidecar/bin/",
      "sidecar/db-sql/",
      "sidecar/env-sidecars/",
      "sidecar/harness/",
      "sidecar/internal-docs/",
      "sidecar/node_modules/",
      "sidecar/prompts/",
      "sidecar/rubrics/",
      "sidecar/scripts/",
      "sidecar/source.tar.zst",
      "sidecar/templates/",
      "sidecar/serve.mjs",
      "resources/papercup-bootstrap.sh",
      "resources/papercup-rootfs-recipe",
      "resources/papercup-runtime.tar.gz"
    ],
    "requiredCapabilities": [
      "render-shared-spa-before-server-ready",
      "discover-running-server",
      "launch-installed-server",
      "show-install-server-guidance",
      "negotiate-server-version",
      "preserve-browser-http-sse",
      "install-desktop-ipc-adapters"
    ],
    "connection": {
      "discoveryRecord": "~/.papercusp/operator.json",
      "readinessProbe": "/api/health",
      "versionProbe": "/api/desktop/version",
      "missingServerState": "install-papercusp-server",
      "missingServerChoices": [
        "install-or-start-local-server",
        "connect-remote-or-hosted-server"
      ],
      "remoteTransport": "credential-free-https-origin-with-browser-http-sse",
      "rule": "Never self-host. Attach to a healthy Server or render explicit install/start/retry guidance without looping silently."
    },
    "versionNegotiation": {
      "serverFields": [
        "appVersion",
        "sidecarSha"
      ],
      "releaseRule": "gui-and-server-must-share-release-version",
      "sourceRule": "same-source-build-sha-required-when-both-shas-are-known",
      "unknownRule": "unknown provenance is diagnostic and cannot satisfy release verification"
    },
    "budgets": {
      "unit": "bytes",
      "initialDownloadCeiling": 262144000,
      "measurement": [
        "compressed-artifact-bytes",
        "unpacked-unique-inode-bytes",
        "unpacked-logical-bytes",
        "archive-member-bytes"
      ],
      "hardlinks": "count-each-inode-once-and-report-logical-bytes-separately",
      "archives": "inspect-members-and-report-container-bytes-separately",
      "tighteningRule": "A platform with a fresh artifact must pin exact measured bytes plus explicit compressed and unpacked ceilings; pending platforms retain the 250 MiB download safety ceiling but cannot pass distribution census until measured.",
      "platforms": {
        "linux": {
          "status": "fresh-0.0.18-exact-source-artifacts",
          "formats": {
            "deb": {
              "downloadBytes": 49561648,
              "unpackedBytes": 259870182,
              "downloadCeilingBytes": 67108864,
              "unpackedCeilingBytes": 268435456,
              "sourceArtifactSha256": "dc092e0bb13cc19faf1e282f448da58fb21e02b7093faa821c607dfc7ed548a3"
            },
            "appimage": {
              "downloadBytes": 145484280,
              "unpackedBytes": 532806788,
              "downloadCeilingBytes": 157286400,
              "unpackedCeilingBytes": 536870912,
              "sourceArtifactSha256": "1c373f53c64afb6f348600dbcced32dd6193671fcf272474274ff47cdaab0958"
            }
          },
          "mustRemeasureFreshArtifact": true
        },
        "macos": {
          "status": "pending-fresh-artifact",
          "mustRemeasureFreshArtifact": true
        },
        "windows": {
          "status": "pending-fresh-artifact",
          "mustRemeasureFreshArtifact": true
        }
      }
    }
  },
  "server": {
    "productName": "Papercusp Server",
    "identifier": "com.papercusp.server",
    "packageNames": {
      "linux": "papercusp-server",
      "macos": "Papercusp Server.app",
      "windows": "Papercusp Server"
    },
    "installedIdentities": {
      "linuxExecutable": "/usr/bin/papercusp-server",
      "linuxDesktopEntry": "Papercusp Server.desktop",
      "linuxIcon": "papercusp-server",
      "linuxResourceRoot": "/usr/lib/Papercusp Server",
      "linuxUserUnit": "/usr/lib/systemd/user/papercusp-server.service",
      "macosInstallRoot": "/Applications/Papercusp Server.app",
      "macosServiceDaemon": "/Library/LaunchDaemons/com.papercusp.server.plist",
      "linuxBootStartHelper": "systemd/enable-boot-start.sh",
      "windowsInstallRoot": "%LOCALAPPDATA%\\Papercusp Server"
    },
    "requiredResources": [
      "sidecar/serve.mjs",
      "sidecar/sidecar-preload.js",
      "sidecar/spa/index.html",
      "sidecar/bin/node",
      "sidecar/db-sql/",
      "sidecar/harness/",
      "sidecar/internal-docs/",
      "sidecar/node_modules/",
      "sidecar/prompts/",
      "sidecar/rubrics/",
      "sidecar/scripts/",
      "sidecar/templates/"
    ],
    "requiredCapabilities": [
      "operator-health",
      "embedded-postgres",
      "workspace-host",
      "browser-spa-http-sse",
      "desktop-endpoint-ipc",
      "mcp",
      "agent-runtime",
      "local-embedding",
      "docs-search",
      "environment-sidecars"
    ],
    "optionalPacks": [
      {
        "name": "local-models",
        "required": true,
        "manifestPath": "sidecar/node_modules/@huggingface/transformers/models/papercusp-model-assets.json",
        "installRoot": "sidecar/node_modules/@huggingface/transformers/models/onnx-community",
        "cachePolicy": {
          "mode": "installed-local-only",
          "remoteFetch": "forbidden-on-vm-release",
          "readyWhen": "every-declared-file-matches-size-and-sha256",
          "missingOrCorrupt": "refuse-startup",
          "recovery": "replace-with-a-signed-runtime-containing-the-declared-pack"
        },
        "compatibility": {
          "transformersPackage": "4.2.0",
          "executionProvider": "cpu",
          "runtimeDefaults": [
            "harrier",
            "gemma"
          ]
        },
        "paths": [
          "sidecar/node_modules/@huggingface/transformers/models/onnx-community/harrier-oss-v1-0.6b-ONNX/",
          "sidecar/node_modules/@huggingface/transformers/models/onnx-community/embeddinggemma-300m-ONNX/"
        ],
        "forbidden": [
          "*.tmp.*",
          "*.partial",
          "*.part"
        ],
