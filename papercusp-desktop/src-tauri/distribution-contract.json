      },
      {
        "name": "dev-source",
        "paths": [
          "sidecar/source.tar.zst"
        ]
      },
      {
        "name": "bootstrap-seed",
        "paths": [
          "seed/**/*"
        ]
      },
      {
        "name": "doc-vector-seed",
        "paths": [
          "doc-vector-seed/**/*"
        ]
      },
      {
        "name": "windows-wsl-runtime",
        "platforms": [
          "windows"
        ],
        "paths": [
          "resources/papercup-bootstrap.sh",
          "resources/papercup-rootfs-recipe",
          "resources/papercup-runtime.tar.gz"
        ]
      }
    ],
    "capabilitySmoke": {
      "health": "/api/health",
      "version": "/api/desktop/version",
      "spa": "/",
      "stream": "endpoint-ipc-or-sse-round-trip",
      "database": "embedded-postgres-ready",
      "agent": "mcp-initialize-and-read-only-tool"
    }
  },
  "coinstall": {
    "conflicts": [],
    "replaces": [],
    "sharedExecutablePaths": [],
    "singleInstanceScope": "bundle-identifier",
    "updaterProducts": [
      "gui",
      "server"
    ],
    "uninstallRule": "Each product may remove only files and processes proven to belong to its own package/bundle identifier."
  },
  "verification": {
    "freshSameSourceArtifactsRequired": true,
    "archiveAware": true,
    "installedTreeAware": true,
    "browserTransportParityRequired": true,
    "desktopTransportParityRequired": true,
    "guiOnlyFailureMustBeGraceful": true,
    "serverOnlyOperationMustBeSupported": true
  }
}
