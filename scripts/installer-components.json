        "**/sidecar/bin/pui.exe",
        "**/sidecar/bin/papercup",
        "**/sidecar/bin/papercup.exe",
        "**/sidecar/bin/papercusp-*",
        "**/node_modules/@papercusp/**",
        "**/node_modules/@papercupai/**",
        "**/sidecar/orchestrator/package.json",
        "**/sidecar/harness/package.json",
        "**/sidecar/env-sidecars/*/harness/package.json",
        "**/sidecar/templates/*/package.json",
        "**/sidecar/templates/*/*/package.json"
