      "name": "Node.js runtime",
      "kind": "program",
      "license": "MIT",
      "paths": ["**/sidecar/bin/node", "**/sidecar/bin/node.exe"],
      "reason": "Official Node.js binary. MIT; its bundled components (OpenSSL Apache-2.0, ICU Unicode, libuv MIT, V8 BSD-3-Clause) are permissive.",
      "obligations": "Ship Node's LICENSE file (it lists the bundled components)."
    },
    {
      "name": "PostgreSQL client tools linked with GNU readline",
      "kind": "program",
      "license": "PostgreSQL AND GPL-3.0-or-later",
      "aggregate": true,
      "paths": ["**/sidecar/bin/.pg-real/**", "**/sidecar/bin/pg_dump", "**/sidecar/bin/pg_dumpall", "**/sidecar/bin/pg_restore", "**/sidecar/bin/psql"],
      "reason": "pg_dump/pg_dumpall/pg_restore/psql are PostgreSQL-licensed, but .pg-real/lib ships libreadline.so.8 (GPL-3.0-or-later) and libtinfo, so the shipped psql is a GPL-3 combination. It runs as a separate program the app invokes, not linked into the app.",
      "obligations": "Offer the corresponding source of readline (and psql) with the release, or rebuild psql against libedit to drop the GPL component."
    },
