    {
      "name": "Papercusp first-party binaries and packages",
      "kind": "first-party",
      "allow": true,
      "paths": [
        "**/usr/bin/papercusp-*",
        "**/Papercusp*.app/Contents/MacOS/papercusp-*",
        "**/Papercusp*.app/Contents/Info.plist",
