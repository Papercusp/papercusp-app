#!/usr/bin/env bash
# Enroll this desktop in the Defguard mesh as a peer ("network device").
#
# Generates a persistent WireGuard keypair (stored in
# ~/.papercusp/mesh/), registers the desktop with Defguard via the admin
# API, fetches the wg-quick config, writes it to /etc/wireguard/, and
# prints the one sudo command needed to bring the interface up + enable
# the systemd unit.
#
# Idempotent: re-running with an existing key reuses it. To rotate, run
# `bin/mesh-revoke-desktop` first.
#
# Reads from $PAPERCUSP_REPO/apps/operator/.env.local:
#   DEFGUARD_URL          (default: https://mesh.papercuspai.com)
#   DEFGUARD_API_TOKEN    (required)
#
# EI-8815 (verified live 2026-07-09): on the current instance, Bearer-token
# auth with DEFGUARD_API_TOKEN against /api/v1/me and
# /api/v1/device/network/ip/1 returns `401 {"msg":"Session is required"}` —
# this script does NOT currently work end-to-end even with a valid token. The
# WI-3454 re-enroll worked around it via browser-session auth instead. If you
# hit the same "could not fetch available IP" error below, see
# infra/defguard/README.md's EI-8815 note before assuming your token is bad.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/.." && pwd)"
ENV_FILE="$REPO/apps/operator/.env.local"
KEY_DIR="$HOME/.papercusp/mesh"
WG_CONF_OUT="$KEY_DIR/papercusp.conf"
SYSTEMD_UNIT_OUT="$KEY_DIR/wg-quick@papercusp.service"

if [ ! -f "$ENV_FILE" ]; then
  echo "==> ERROR: $ENV_FILE not found" >&2
  exit 1
fi

# Source DEFGUARD_* vars only (avoid polluting shell with other secrets).
DEFGUARD_URL=$(grep -E '^DEFGUARD_URL=' "$ENV_FILE" | cut -d= -f2- | tr -d '"')
DEFGUARD_URL=${DEFGUARD_URL:-https://mesh.papercuspai.com}
DEFGUARD_API_TOKEN=$(grep -E '^DEFGUARD_API_TOKEN=' "$ENV_FILE" | cut -d= -f2- | tr -d '"')
if [ -z "$DEFGUARD_API_TOKEN" ]; then
  echo "==> ERROR: DEFGUARD_API_TOKEN missing in $ENV_FILE" >&2
  exit 1
fi

mkdir -p "$KEY_DIR"
chmod 700 "$KEY_DIR"
PRIV_PATH="$KEY_DIR/private.key"
PUB_PATH="$KEY_DIR/public.key"

if [ ! -f "$PRIV_PATH" ]; then
  echo "==> generating WireGuard keypair (one-time, persistent)"
  if command -v wg >/dev/null 2>&1; then
    wg genkey | tee "$PRIV_PATH" | wg pubkey > "$PUB_PATH"
  else
    # openssl X25519 produces 32-byte keys compatible with WireGuard.
    openssl genpkey -algorithm X25519 -outform der -out "$KEY_DIR/x25519.der" 2>/dev/null
    openssl pkey -in "$KEY_DIR/x25519.der" -inform der -outform der 2>/dev/null \
      | tail -c 32 | base64 > "$PRIV_PATH"
    openssl pkey -in "$KEY_DIR/x25519.der" -inform der -pubout -outform der 2>/dev/null \
      | tail -c 32 | base64 > "$PUB_PATH"
    rm -f "$KEY_DIR/x25519.der"
  fi
  chmod 600 "$PRIV_PATH" "$PUB_PATH"
fi

PRIV_KEY=$(tr -d '\n' < "$PRIV_PATH")
PUB_KEY=$(tr -d '\n' < "$PUB_PATH")
DESKTOP_NAME="papercusp-$(hostname -s)"
echo "==> desktop name: $DESKTOP_NAME"
echo "==> public key:   $PUB_KEY"

echo "==> requesting available IP from Defguard"
AVAIL_JSON=$(curl -fsS -H "Authorization: Bearer $DEFGUARD_API_TOKEN" \
  "$DEFGUARD_URL/api/v1/device/network/ip/1") || {
  echo "==> ERROR: could not fetch available IP" >&2
  exit 1
}
ASSIGNED_IP=$(echo "$AVAIL_JSON" | python3 -c "import json,sys; print(json.load(sys.stdin)[0]['ip'])")
echo "==> assigned IP:  $ASSIGNED_IP"

echo "==> registering device with Defguard"
REG_JSON=$(curl -fsS -X POST -H "Authorization: Bearer $DEFGUARD_API_TOKEN" \
  -H "content-type: application/json" \
  "$DEFGUARD_URL/api/v1/device/network" \
  -d "{
    \"name\": \"$DESKTOP_NAME\",
    \"description\": \"Papercusp desktop ($(hostname))\",
    \"location_id\": 1,
    \"assigned_ips\": [\"$ASSIGNED_IP\"],
    \"wireguard_pubkey\": \"$PUB_KEY\"
  }") || {
  echo "==> ERROR: device registration failed (probably already exists; delete via Defguard UI to retry)" >&2
  exit 1
}

# Defguard returns config text with placeholder PrivateKey; substitute ours.
SERVER_PUBKEY=$(echo "$REG_JSON" | python3 -c "import json,sys; print(json.load(sys.stdin)['config']['pubkey'])")
ENDPOINT=$(echo "$REG_JSON" | python3 -c "import json,sys; print(json.load(sys.stdin)['config']['endpoint'])")
ALLOWED=$(echo "$REG_JSON" | python3 -c "import json,sys; print(','.join(json.load(sys.stdin)['config']['allowed_ips']))")

cat > "$WG_CONF_OUT" <<EOF
[Interface]
PrivateKey = $PRIV_KEY
Address = $ASSIGNED_IP/24
MTU = 1420

[Peer]
PublicKey = $SERVER_PUBKEY
AllowedIPs = $ALLOWED
Endpoint = $ENDPOINT
PersistentKeepalive = 25
EOF
chmod 600 "$WG_CONF_OUT"
echo "==> wg-quick config: $WG_CONF_OUT"

cat > "$SYSTEMD_UNIT_OUT" <<EOF
# papercusp mesh — generated by bin/mesh-enroll-desktop
[Unit]
Description=Papercusp WireGuard tunnel (papercusp-mesh)
After=network-online.target nss-lookup.target
Wants=network-online.target nss-lookup.target

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/usr/bin/wg-quick up /etc/wireguard/papercusp.conf
ExecStop=/usr/bin/wg-quick down /etc/wireguard/papercusp.conf

[Install]
WantedBy=multi-user.target
EOF

cat <<EOF

==> done generating mesh config. To activate, run (requires sudo):

  sudo cp $WG_CONF_OUT /etc/wireguard/papercusp.conf
  sudo cp $SYSTEMD_UNIT_OUT /etc/systemd/system/papercusp-mesh.service
  sudo chmod 600 /etc/wireguard/papercusp.conf
  sudo systemctl daemon-reload
  sudo systemctl enable --now papercusp-mesh.service

Verify with:  sudo wg show     # should list 'papercusp' interface
              ip addr show     # should include $ASSIGNED_IP

Mesh address: $ASSIGNED_IP   (other peers reach this desktop here)
EOF
