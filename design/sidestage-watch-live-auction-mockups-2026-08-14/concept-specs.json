  "module": {
    "id": "conditional-current-offer",
    "name": "Conditional current offer",
    "thesis": "Keep one predictable right-hand offer slot and let its contents evolve with the sale instead of inserting a second auction surface below the stream.",
    "states": [
      "Now selling",
      "Live auction",
      "Settling",
      "Sold"
    ],
    "implementationNotes": [
      "The no-auction state preserves the existing Now Selling product card and Hold item action.",
      "The live state transforms the same slot in place with the ring countdown, current bid, compact bid feed, leader, amount input, and Place bid action.",
      "Settling disables bid controls while the server confirms the winner.",
      "Sold keeps the final result and winner in the same slot.",
      "No separate Live auction block appears below the video."
    ],
    "ir": {
      "irVersion": "0.1",
      "surface": "sidestage-watch-conditional-current-offer",
      "ecosystem": "react-tailwind",
      "layout": {
        "kind": "stack",
        "direction": "vertical",
        "gap": {
          "token": "--ss-gap"
        },
        "children": [
          {
            "kind": "header",
            "title": {
              "key": "offer.module.title",
              "default": "Current offer"
            },
            "copy": {
              "key": "offer.module.subtitle",
              "default": "One right-hand slot that keeps the product offer stable as an auction starts, settles, and sells."
            },
            "a11y": {
              "role": "banner"
            }
          },
          {
            "kind": "card",
