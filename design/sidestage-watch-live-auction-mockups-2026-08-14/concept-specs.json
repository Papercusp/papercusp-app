  "roomTabs": {
    "id": "watch-room-context-tabs",
    "name": "Watch room context tabs",
    "sourceDecision": "sidestage-watch-live-auction-mockups-2026-08-14#D-004",
    "thesis": "Let viewers move between conversation, item context, and seller trust without moving or obscuring the current-offer module.",
    "registryReuse": [
      "action.primary",
      "action.secondary",
      "feedback.banner"
    ],
    "states": [
      "Chat",
      "Details",
      "Seller"
    ],
    "implementationNotes": [
      "The existing tabs become one ARIA tablist with one stable content panel directly below the video.",
      "Chat is the default state and includes recent messages plus a composer preview.",
      "Details carries condition, measurements, materials, fulfillment, story, and auction terms.",
      "Seller carries identity, verification, reputation, fulfillment performance, follow, and shop actions.",
      "The right-hand current-offer module remains visible and independent while tabs switch.",
      "Arrow keys plus Home and End move and activate tabs; selected state is expressed with aria-selected."
    ],
