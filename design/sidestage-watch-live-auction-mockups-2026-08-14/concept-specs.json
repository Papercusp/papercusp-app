                        "binding": {
                          "slot": "closingCall",
                          "shape": "AuctionClosingCall"
                        },
                        "a11y": {
                          "role": "status",
                          "ariaLive": "polite"
                        }
                      }
                    ]
                  },
                  {
                    "kind": "list",
