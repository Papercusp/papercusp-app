{
  "name": "@papercusp/operator-vite",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:nohmr": "bin/vite-watch-singleton",
    "//prebuild": "WI-7088 + cdn-egress-fixes-2026-08-02 P-001: publicDir is apps/operator/public, and the vditor + monaco runtime mirrors there are gitignored/generated. postinstall normally populates them, but a deploy that skips node_modules would leave them absent — so re-assert here. Both are idempotent + version-stamped, so this is a no-op once current.",
    "prebuild": "bash ../operator/scripts/setup-vditor-runtime.sh && bash ../operator/scripts/setup-monaco-runtime.sh && bash ../operator/scripts/setup-excalidraw-runtime.sh && bash ../operator/scripts/setup-porcupine-runtime.sh",
    "build": "bin/vite-build-singleflight",
    "preview": "vite preview",
    "test": "vitest run",
    "generate:routes": "node scripts/generate-route-tree.mjs",
    "pretypecheck": "npm run generate:routes",
    "typecheck": "node ../../scripts/lint-tsc-operator-vite.mjs",
    "typecheck:raw": "bash ../../scripts/pc-heavy.sh tsc --noEmit"
  },
  "dependencies": {
    "@bprogress/react": "^1.2.7",
    "@hono/node-server": "^2.0.3",
    "@novnc/novnc": "^1.7.0",
    "@papercusp/agent-roster": "file:../../libs/generic/agent-roster",
    "@papercusp/card-stack": "file:../../libs/generic/card-stack",
    "@papercusp/facets": "file:../../libs/generic/facets",
    "@papercusp/flags": "file:../../libs/flags",
    "@papercusp/grid-core": "file:../../libs/generic/papergrid/grid-core",
    "@papercusp/lexicon": "file:../../libs/generic/lexicon",
    "@papercusp/module-singleton": "file:../../libs/generic/module-singleton",
    "@papercusp/operator-core": "file:../../packages/operator-core",
    "@papercusp/operator-ui": "file:../../packages/operator-ui",
    "@papercusp/p2p-voice": "file:../../libs/generic/p2p-voice",
    "@papercusp/sse": "file:../../libs/generic/sse",
    "@papercusp/sync": "file:../../libs/generic/sync",
    "@papercusp/testing-shell": "file:../../libs/testing-shell",
    "@papercusp/ui-primitives": "file:../../libs/generic/ui-primitives",
    "@tanstack/react-router": "^1.170.6",
    "@udecode/plate-markdown": "^48.0.2",
    "buffer": "^5.7.1",
    "hono": "^4.13.7",
    "lodash": "^4.17.19",
    "marked": "^15.0.12",
    "react": "^19.2.6",
    "react-css-highlight": "^3.1.0",
    "react-dom": "^19.2.6",
    "react-responsive-carousel": "^3.2.23"
  },
  "devDependencies": {
    "@papercusp/test-config": "*",
    "@tanstack/router-plugin": "^1.168.9",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.4"
  }
}
