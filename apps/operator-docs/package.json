{
  "name": "@papercupai/operator-docs",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "clean:preview": "rm -rf src/content/docs/preview dist-preview",
    "build": "bash scripts/docs-build-singleflight",
    "build:inner": "npm run clean:preview && astro build && tsx scripts/emit-md-twins.ts && bash scripts/postbuild-copy.sh && node ../../scripts/check-docs-mirror.mjs",
    "build:from-pg": "npm --prefix ../.. run gen:authored-docs:materialize && npm run build:inner",
    "build:preview": "rm -rf src/content/docs/preview && DOCS_PREVIEW=1 astro build",
    "preview": "astro preview",
    "serve:preview": "DOCS_PREVIEW=1 astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/react": "^5.0.5",
    "@astrojs/starlight": "^0.39.2",
    "@papercusp/docs-engine": "*",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "astro": "6.4.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.35.0",
    "starlight-llms-txt": "^0.10.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "starlight-openapi": "^0.25.3",
    "starlight-typedoc": "^0.23.0",
    "tsx": "^4.19.2"
  }
}
