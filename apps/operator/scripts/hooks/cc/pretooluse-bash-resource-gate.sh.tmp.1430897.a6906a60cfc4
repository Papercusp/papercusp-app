#!/usr/bin/env bash
# PreToolUse hook — gate raw `Bash` commands against the named-resource lock
# registry (plan named-resource-locks-drain, P-026/D-013). When a command
# would collide with an in-flight EXCLUSIVE hold on a registered resource
# (e.g. a peer is mid `dev:restart`), block it; otherwise proceed.
#
# ALSO: the native-scheduler lockout (native-scheduler-lockout-2026-06-09
# P-010) — when this session is an AGENT session (PAPERCUSP_AGENT_SESSION=1:
# role panes, the brain/Queen — OR PAPERCUSP_FLEET_SLUG set, the backstop for
# a fleet member whose launch path dropped the marker, EI-18815668439722436;
# the owner's own plain sessions set neither), deny persistent OS schedulers
# (crontab/at/batch/systemd-run) at command position. Local regex, no HTTP.
# Catches the compound forms (`cd x && crontab …`) the launch-time
# Bash(crontab:*) prefix deny-patterns can't. Wakes belong in the harness
# routines table (hive:declare-wake) — the only scheduler that
# Pause/hive:status/the liveness backstop can see.
#
# Cheap by design: a local keyword pre-filter lets the overwhelming majority
# of commands (ls/git/grep/…) return immediately with NO HTTP call. Only a
# command that looks destructive (systemctl/overmind/psql/npm run dev) is
# checked against the operator via locks:check_command.
#
# Fail-open everywhere: not installed, operator unreachable, or any parse
# error → ALLOW (cooperative enforcement only works while the system is up).
# Only an explicit decision === 'block' denies.
#
# NOTE: the pre-filter tokens mirror the seeded resources' match_patterns; a
# new resource with a novel pattern needs a token added here (or drop the
# pre-filter to always-check). Decision logic is server-side (registry-driven).

set -euo pipefail

OPERATOR_URL="${PAPERCUSP_OPERATOR_URL:-http://localhost:3070}"
TOKEN_PATH="${HOME}/.papercusp/superuser-token"
AGENT_ID_PATH="${HOME}/.papercusp/su-agent-id"

if [ ! -s "$TOKEN_PATH" ] || [ ! -s "$AGENT_ID_PATH" ]; then
  exit 0
fi

AGENT_ID=$(cat "$AGENT_ID_PATH")
INPUT=$(cat)

# ── BYTECODE CACHE (EI-20226903620041425, owner-approved 2026-08-31) ─────────────
# The ~291KB body below arrives on STDIN, and CPython never writes a __pycache__
# entry for a program read from stdin -- so before this, every single bash call by
# every agent re-tokenized and re-compiled all of it. Measured on this box:
# compile() alone = 38-49ms (load-dependent), against 0.7ms to unmarshal the same
# code object from a .pyc. It is CPU-bound, so it degraded worst exactly under
# fleet load, when everything is already slow.
#
# The fix is delivery-only: the heredoc stays the single source of truth (the
# single-file install is load-bearing -- install-standalone-mcp.sh:258 copies this
# one file, papercusp-files.ts:874 manifests it, worker-plugin/hooks/hooks.json:12
# names it by absolute path), and the bootstrap below materializes it ONCE to a
# content-addressed module that python can then import with a warm .pyc.
#
# WHY IT IS SHAPED LIKE THIS -- each line is load-bearing, do not "simplify":
#
#   * `python3 -c` NOT `python3 script.py`: CPython only writes __pycache__ for an
#     IMPORTED module, never for __main__. The import is the whole point.
#   * KEYED ON CONTENT HASH, not size+mtime: the key changes when the hook changes,
#     so a stale body is unreachable by construction rather than by expiry. Costs
#     ~0.3ms in-process (vs a 3.7ms `sha256sum` spawn if this were done in bash),
#     and it closes the one new risk this introduces -- that the gate now executes
#     a file from a cache dir rather than the installed .sh.
#   * THE CACHED FILE IS RE-HASHED BEFORE IMPORT, not merely size-checked. A
#     content-addressed NAME only proves what the file was called, not what it
#     contains; without this, a same-length rewrite of the correctly-named file
#     would be imported as the gate. This is cheap (~0.5ms of a ~46ms saving) and
#     it also catches the realistic accident -- a half-written file from a crashed
#     or ENOSPC'd peer. Note it is not a privilege boundary: anything that can
#     write this cache dir can equally rewrite the installed hook or edit
#     settings.json, so treat it as corruption defence, not as a sandbox.
#   * FALLBACK IS THE OLD PATH, NOT `exit 0`. This wrapper fails OPEN (see the
#     `|| exit 0` below), so a cache bug must never be able to skip the gate. The
#     try/except covers ONLY cache PREPARATION -- it decides which way to run the
#     body BEFORE any of it executes. A prepared-cache import is then NOT wrapped:
#     if the gate itself throws, that propagates to the same fail-open it always
#     had. Consequence: the worst case here is "as slow as it used to be", never
#     "the gate silently stopped running", and the body can never double-execute.
#   * `except Exception`, NEVER a bare `except:`. allow()/deny() both raise
#     SystemExit; a bare except would swallow the gate's own verdict and re-run
#     the body through the fallback -- duplicating its HTTP call and journal write.
#   * sys.path.APPEND, not insert(0): the cache dir must not shadow stdlib.
#
# Not a correctness risk, but worth knowing: if the cache dir is unwritable or
# PYTHONDONTWRITEBYTECODE is set, no .pyc materializes and we simply pay the old
# compile every call. That degrades silently -- by design, since the alternative
# in a fail-open safety gate is worse.
#
# DEFERRED, deliberately: `python3 -S` is a further ~25ms, and is NOT taken. On a
# host whose python needs site.py the interpreter would fail to start, the
# `|| exit 0` would fire, and that host's gate would be off forever with no
# signal. It only becomes safe once this wrapper can tell "the hook could not
# start" from "the hook ran and allowed". Do not add it without fixing that first.
GATE_BOOTSTRAP='
import sys, os, time, hashlib
_src = sys.stdin.read()
_raw = _src.encode("utf-8")
_mod = None
try:
    _key = "pcgate_" + hashlib.sha256(_raw).hexdigest()[:16]
    _dir = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "papercusp-hooks")
    _py = os.path.join(_dir, _key + ".py")
    try:
        with open(_py, "rb") as _fh:
            _have = _fh.read()
    except OSError:
        _have = None
    # Verify-or-(re)write, NOT write-if-absent. An entry that fails the hash is
    # REPAIRED rather than merely bypassed: a bypass would be correct but would
    # cost this box the speedup permanently and silently after a single bad write
    # (a crashed or ENOSPC-d peer), which is the failure mode nobody would notice.
    if _have is None or len(_have) != len(_raw) or hashlib.sha256(_have).hexdigest()[:16] != _key[7:]:
        os.makedirs(_dir, exist_ok=True)
        _tmp = "%s.%d.tmp" % (_py, os.getpid())
        with open(_tmp, "wb") as _fh:
            _fh.write(_raw)
        os.replace(_tmp, _py)
        # CPython validates a .pyc against its source mtime+size, so a repaired
        # .py invalidates its own stale .pyc -- nothing to clean up here.
        _cut = time.time() - 1209600
        for _old in os.listdir(_dir):
            if _old.startswith("pcgate_") and _old != _key + ".py":
                try:
                    _op = os.path.join(_dir, _old)
                    if os.path.getmtime(_op) < _cut:
                        os.remove(_op)
                except OSError:
                    pass
    sys.path.append(_dir)
    _mod = _key
except Exception:
    _mod = None
if _mod:
    __import__(_mod)
else:
    exec(compile(_src, "<resource-gate>", "exec"), {"__name__": "__main__"})
'

python3 -c "$GATE_BOOTSTRAP" "$OPERATOR_URL" "$TOKEN_PATH" "$AGENT_ID" "$(dirname "$0")" 3<<<"$INPUT" <<'PYEOF' || { echo '[resource-gate] hook error — allowing (fail-open)' >&2; exit 0; }
import hashlib, json, os, re, shlex, sys, tempfile, time

# ── urllib is imported LAZILY: it is ~34ms of a ~140ms invocation, on a path most
# calls never reach (WI-38077).
#
# This hook is PreToolUse on Bash, so EVERY bash call by EVERY agent pays its
# startup. Measured at load1=66: 140-150ms per invocation, of which `import
# urllib.request` is ~34ms cumulative -- it drags in http.client (27ms) and
# email.parser (13ms). But urllib is used at exactly three sites: the operator
# call at the very END of this file, and a rare say-once advisory delivery ping.
# allow() and deny() both sys.exit BEFORE either one, so on the common path that
# 34ms bought nothing. Deferring it measured 140-150ms -> 100-108ms (~30%), with
# byte-identical allow and deny verdicts across the 323-test suite.
#
# `install_opener` MUST still run before the first request (localhost operator:
# never via an egress http(s)_proxy, which 502s the local call and turns it into
# a false fail-open), so it is folded into the one-time import below rather than
# left at module scope where it would force the eager import it is avoiding.
#
# Both names are attribute-accessed only (`urllib.request.Request`,
# `urllib.parse.quote`, `urllib.request.urlopen`) -- there is no reflection over
# the real module object -- which is what makes this substitution transparent.
class _LazyModule:
    __slots__ = ('_name', '_module')

    def __init__(self, name):
        self._name = name
        self._module = None

    def __getattr__(self, attr):
        if self._module is None:
            import importlib
            self._module = importlib.import_module(self._name)
            if self._name == 'urllib.request':
                self._module.install_opener(
                    self._module.build_opener(self._module.ProxyHandler({}))
                )
        return getattr(self._module, attr)


class _UrllibNamespace:
    request = _LazyModule('urllib.request')
    parse = _LazyModule('urllib.parse')


urllib = _UrllibNamespace()

operator_url, token_path, agent_id, hook_dir = sys.argv[1:5]
sys.path.insert(0, hook_dir)
from mcp_response import read_hook_payload, read_token_file, with_native_session  # noqa: E402
raw = read_hook_payload()
token = read_token_file(token_path)

# Soft advisory attached to an ALLOW verdict (coord-delivery-residual-gaps
# P-003). None = plain silent allow; a string rides out as additionalContext
# on an explicit permissionDecision:'allow' payload. Denies always win — the
# advisory only decorates commands every gate already passed.
ADVISORY = None

# Adding an advisory? If it covers a common command shape, pin it OFF in the
# test suite's shared `runGate` env and opt in from the describe that tests it;
# see `PC_HEAVY_LOAD1_OVERRIDE` for the precedent. ADVISORY is a single slot,
# so leaving a new advisory on can redact unrelated `expectAllow` assertions.

# `_shell_write_guard` runs before the cd + restore-path advisory below, but a
# variable-driven restore can match both. Keep its soft notice pending until
# the more specific cwd-drift check has had a chance to choose the message (or
# prove the restore is safely scoped/anchored). This avoids the generic notice
# masking a specific advisory, while preserving it for ordinary variable-write
# commands.
_PENDING_SHELL_WRITE_ADVISORY = None

# ── Say-once advisory suppression (context-injection-audit P-020, D-030+D-031) ──
#
# This gate is a STATELESS function of the current command, so before this it
# had no dedup of any kind — every matching command re-emitted the FULL
# advisory verbatim. Measured 2026-07-28 in ONE session: the ~700-char SIGPIPE
# advisory fired 3x and the bash→tool routing advisory 4x, byte-identical,
# against a TURN_START_BUDGET_CHARS of 4,000 for ALL of memory. This file is
# 109KB carrying 29 distinct advisory classes and is subject to no budget at
# all — it outspends the one channel that IS disciplined.
#
# The fix is the coord rail's cursor semantics: say it once, then suppress.
# It is deliberately a HYBRID, because the two halves have different hot paths:
#
#   * the SUPPRESSION DECISION runs on EVERY guarded call (~10,216/day
#     fleet-wide) on the latency-critical path of every bash command, so it is
#     a LOCAL seen-set file — zero network, zero operator dependency;
#   * the DELIVERY RECORD is written only on an advisory's FIRST appearance in
#     a session (~590/day), so it can afford one fire-and-forget call. It goes
#     to activity:report, NOT coord (D-031): a coord row is a MESSAGE that
#     lands in agents' inboxes and fires migration 126's unconditional
#     pg_notify waking every live LISTEN connection (34 measured), whereas
#     agent_activity carries 1 trigger and already absorbs 58,764 rows/day
#     from this same hook family.
#
# FAIL-OPEN IN BOTH DIRECTIONS: any error resolving, reading or writing the
# seen-set means we EMIT — the legacy behaviour — never suppress. A dedup bug
# must never silently swallow a safety advisory.


def _session_key():
    """Stable per-session id, matching the precedence the file-lock hook uses."""
    sid = os.environ.get('PAPERCUSP_SID')
    if not (isinstance(sid, str) and sid):
        try:
            sid = payload.get('session_id')
        except Exception:
            sid = None
    if not (isinstance(sid, str) and sid):
        sid = agent_id
    return re.sub(r'[^A-Za-z0-9_.-]', '_', str(sid))[:120]


# NESTED-CLI POLICY (WI-10004953): this gate acts AS the su for a CLI nested inside it (a
# `claude -p` from an su's Bash tool, or under a capability:bash job, inherits the su's
# PAPERCUSP_SID). That is deliberate for ENFORCEMENT, as with the lock hooks: the nested
# CLI runs commands on the su's behalf, so the su's own exclusive must not gate it and
# its background jobs are the su's. The one exception is the say-once advisory seen-set
# below: an advisory shown to the NESTED model was never seen by the su, so recording it
# under the su's key would suppress that advisory for the su for a day and log a
# delivery the su never received. The seen-set alone is keyed on the nested CLI's own
# native session id.
_ADVISORY_KEY = []


def _nested_cli():
    """The cached nested-CLI verdict (pc_nested_cli.sh); any failure answers False."""
    try:
        import subprocess
        r = subprocess.run(
            ['bash', os.path.join(hook_dir, 'pc_nested_cli.sh')],
            env={**os.environ, 'PC_NESTED_CLI_START_PID': str(os.getppid())},
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=2,
        )
        return r.returncode == 0
    except Exception:
        return False


def _advisory_session_key():
    """The say-once seen-set key: the su's key, or the nested CLI's own native session."""
    if _ADVISORY_KEY:
        return _ADVISORY_KEY[0]
    key = _session_key()
    try:
        native = payload.get('session_id')
        if os.environ.get('PAPERCUSP_SID') and isinstance(native, str) and native and _nested_cli():
            key = re.sub(r'[^A-Za-z0-9_.-]', '_', 'nested-' + native)[:120]
    except Exception:
        pass
    _ADVISORY_KEY.append(key)
    return key


def _advisory_class_key(text):
    """A stable CLASS key for an advisory — deliberately NOT a hash of the text.

    The bash→tool routing advisory embeds the offending command, so the same
    advisory class arrives with different bytes every time (observed 4x in one
    session with 4 different commands). Hashing the raw text would therefore
    dedup nothing for exactly the advisory that repeats most. So: prefer the
    explicit EI tag when the advisory carries one (25 of the 29 classes do),
    and otherwise hash only the advisory's stable LEAD paragraph, with the
    spans that vary per fire normalised out.

    THE LEAD-PARAGRAPH RULE IS LOAD-BEARING, and was added after the first
    implementation was observed missing live (2026-08-01, three fires in one
    session). Every advisory here opens with a fixed self-identifying sentence
    and then interpolates a per-command body, so hashing the WHOLE text keys on
    that body:
      * bash→tool builds a bullet per detected substitution, so the same class
        hashed differently with one bullet (`sed`) vs two (`sed` + `tail`);
      * long-foreground-exec interpolates the timeout into its first sentence,
        so a 300s call and a 400s call were two different classes.
    Both re-fired in one session — the exact repetition P-020 exists to stop.
    Cutting at the first blank line, and normalising digit runs as well as
    backticked spans, makes both stable without needing a tag per class.
    """
    m = re.search(r'EI-\d+', text)
    if m:
        return m.group(0)
    lead = re.split(r'\n\s*\n', text.strip(), maxsplit=1)[0]
    norm = re.sub(r'`[^`]*`', '`X`', lead)
    norm = re.sub(r'\d+', 'N', norm)
    norm = re.sub(r'\s+', ' ', norm).strip()
    return 'adv-' + hashlib.sha1(norm.encode('utf-8', 'replace')).hexdigest()[:16]


# A session key must never suppress an advisory FOREVER. The seen-set is keyed
# on a session id, and session ids RECUR — a fixture/harness that reuses one, a
# long-lived pane, a plain collision. Without an expiry the first fire of a
# class is the ONLY one that box ever sees, which is exactly the "silently
# swallow a safety advisory" failure this dedup promises above not to be.
_ADVISORY_SEEN_TTL_SEC = 24 * 3600
# Bound the opportunistic prune's work — it must stay cheap, not be exhaustive.
_ADVISORY_SEEN_PRUNE_SCAN = 500


def _advisory_seen_dir():
    """Per-$HOME seen-set, alongside this hook's other state (_BG_TRACK_FILE).

    Deliberately NOT tempfile.gettempdir(): /tmp is machine-global — shared by
    every user, install and test run on the box — and invisible to anything
    that cleans up ~/.papercusp. Keying suppression there silently broke the
    hermetic-fake-$HOME contract every caller of this hook is tested against:
    state leaked in from unrelated runs and suppressed advisories that had
    never fired for that caller at all (WI-6671).
    """
    return os.path.join(os.path.expanduser('~'), '.papercusp', 'advisory-seen')


def _prune_advisory_seen(base):
    """Drop seen-sets past the TTL so the dir cannot grow without bound.

    Best-effort, and deliberately only on the FIRST-write path (~590/day) —
    never on the suppression decision (~10,216/day), which stays one stat plus
    one small read on the latency-critical path of every bash command.
    """
    try:
        now = time.time()
        for name in os.listdir(base)[:_ADVISORY_SEEN_PRUNE_SCAN]:
            p = os.path.join(base, name)
            try:
                if now - os.path.getmtime(p) > _ADVISORY_SEEN_TTL_SEC:
                    os.unlink(p)
            except OSError:
                pass
    except Exception:
        pass


def _claim_advisory(key):
    """True if THIS call is the first to say `key` in this session.

    Append-only file, one key per line. A short O_APPEND write is atomic on
    local filesystems, so two hook processes racing the same advisory can at
    worst both emit once — the race can never SUPPRESS a first emit, which is
    the only direction that would lose information.

    A seen-set older than _ADVISORY_SEEN_TTL_SEC is treated as a NEW session
    (re-armed by truncation, not appended to), so a recurring session id
    re-arms instead of suppressing for the life of the box. The re-arm race is
    the same safe direction: two racing processes can only make an advisory
    emit twice, never suppress its first emit.
    """
    try:
        base = _advisory_seen_dir()
        os.makedirs(base, exist_ok=True)
        path = os.path.join(base, _advisory_session_key())
        fresh = True  # no seen-set yet, or one old enough to have lapsed
        try:
            if time.time() - os.path.getmtime(path) <= _ADVISORY_SEEN_TTL_SEC:
                fresh = False
                with open(path, 'r', encoding='utf-8') as fh:
                    if key in {ln.strip() for ln in fh}:
                        return False
        except OSError:
            pass  # missing or unreadable — treat as a first fire, never suppress
        if fresh:
            _prune_advisory_seen(base)
        with open(path, 'w' if fresh else 'a', encoding='utf-8') as fh:
            fh.write(key + '\n')
        return True
    except Exception:
        return True  # fail-open: emit rather than risk swallowing an advisory


def _record_delivery(key):
    """Best-effort audit ledger: 'did the guard warn it, and when?' (P-020).

    Fires only on an advisory's FIRST appearance in a session. Never raises and
    never affects the verdict — a ledger write must not make a bash command
    slower to fail than to succeed.
    """
    if os.environ.get('PAPERCUSP_ADVISORY_LEDGER') == '0':
        return
    try:
        arguments = {
            'kind': 'lifecycle',
            'owner': agent_id,
            'session_id': _advisory_session_key(),
            'status': 'advisory',
            'summary': 'advisory delivered (say-once): ' + key,
        }
        harness_slug = os.environ.get('PAPERCUSP_HARNESS_SLUG')
        if harness_slug:
            arguments['harness_slug'] = harness_slug
        native_session_id = payload.get('session_id') or os.environ.get('PAPERCUSP_NATIVE_SESSION_ID') or ''
        body = json.dumps({
            'jsonrpc': '2.0', 'id': 1, 'method': 'tools/call',
            'params': {
                'name': 'activity:report',
                'arguments': arguments,
                '_meta': {'format': 'json'},
            },
        }).encode()
        req = urllib.request.Request(
            with_native_session(
                operator_url.rstrip('/') + '/api/mcp?superuser=1&origin=hook&client='
                + urllib.parse.quote(agent_id, safe=''),
                native_session_id,
            ),
            data=body,
            headers={
                'Authorization': 'Bearer ' + token,
                'Content-Type': 'application/json',
                'Accept': 'application/json, text/event-stream',
            },
            method='POST',
        )
        urllib.request.urlopen(req, timeout=2).close()
    except Exception:
        pass


def allow():
    global ADVISORY
    if ADVISORY:
        _key = _advisory_class_key(ADVISORY)
        if _claim_advisory(_key):
            _record_delivery(_key)
        else:
            ADVISORY = None  # already said this session — say it once
    if ADVISORY:
        json.dump({'hookSpecificOutput': {
            'hookEventName': 'PreToolUse',
            'permissionDecision': 'allow',
            # Generic on purpose: FOUR different guards now ride this channel
            # (long-foreground-exec, background-pipe exit code, tauri --token,
            # bash→tool substitution), so naming only the first one mislabels
            # the other three. The specific text is in additionalContext.
            'permissionDecisionReason': 'advisory (non-blocking)',
            'additionalContext': ADVISORY,
        }}, sys.stdout)
    sys.exit(0)

# ══ DENIAL FORENSICS (EI-19421518638516187) ══
#
# Before this, a denial produced a reason naming the RESOLVED TARGET and nothing
# else — no matched text, no log anywhere. The denied command was gone the moment
# the turn moved on, so every false-positive report against this gate was
# reconstructed from memory afterwards.
#
# That is not a small loss. FOUR tickets from three agents
# (EI-19418179098729784, EI-19417957171220978, EI-19323309702408274,
# EI-19385448516432576) ALL named the wrong root cause, each blaming the
# construct next to the `>`; every one of those verbatim commands actually
# ALLOWS. The real trigger (EI-19420133701663526) was an odd quote inside a `#`
# COMMENT breaking quote parity — and a hand-written repro drops the boring
# comment line, which was the load-bearing part. Recovering it cost ~25 tool
# calls against a purpose-built harness. The guard knew the answer at deny time
# and threw it away.
#
# The fix is deliberately two-layer, because the two failures are different:
#   1. the REASON carries the matched POST-NORMALIZATION fragment, so the denied
#      agent sees immediately that the guard is looking at text which does not
#      resemble what they typed — that IS the diagnosis, delivered at the moment
#      of confusion, and it would have made all four tickets self-diagnosing.
#   2. the LOG persists the verbatim command + the guard's own view of it, so a
#      ticket can carry primary evidence instead of a reconstruction.
# Precedent for the log lives in this very directory (ask-gate-mirror.errors.log).

# Populated by a guard just before it denies: the normalized text it matched
# against, plus the offset of the match. Kept as a dict so a guard that never
# sets it (most of them) costs nothing and logs a null.
_DENY_VIEW = {}


def _matched_fragment(clean, at, width=36):
    """~`width` chars either side of the match, from the POST-normalization text.

    Newlines are rendered as ⏎ so a multi-line command stays one readable line,
    and truncation is marked, so the reader can tell a fragment from the whole.
    """
    try:
        if not clean or at is None or at < 0 or at > len(clean):
            return ''
        lo, hi = max(0, at - width), min(len(clean), at + width)
        frag = clean[lo:hi].replace('\n', '⏎').replace('\t', ' ')
        return ('…' if lo > 0 else '') + frag + ('…' if hi < len(clean) else '')
    except Exception:
        return ''


_DENIAL_LOG_MAX_BYTES = 1 << 20  # 1 MiB, then rotated to a single .1 sibling


def _log_denial(reason):
    """Append one JSON line describing this denial. Never raises, never blocks."""
    try:
        _dir = os.path.join(os.path.expanduser('~'), '.papercusp', 'hooks', 'cc')
        os.makedirs(_dir, exist_ok=True)
        _path = os.path.join(_dir, 'bash-resource-gate.denials.log')
        try:
            if os.path.getsize(_path) > _DENIAL_LOG_MAX_BYTES:
                os.replace(_path, _path + '.1')
        except OSError:
            pass  # missing (first write) or unrotatable — append anyway
        _g = globals()
        _clean = _DENY_VIEW.get('clean')
        _rec = {
            'ts': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
            'cwd': (_g.get('payload') or {}).get('cwd'),
            # The VERBATIM command — the thing a from-memory repro loses.
            'command': _g.get('command'),
            # The guard's own view of it. When these two disagree, that
            # disagreement is the bug (that is exactly how the parity break read).
            'normalized': _clean,
            'matchedFragment': _matched_fragment(_clean, _DENY_VIEW.get('at')),
            'reason': reason,
        }
        with open(_path, 'a') as _f:
            _f.write(json.dumps(_rec, ensure_ascii=False) + '\n')
    except Exception:
        pass  # forensics must NEVER turn a deny into a crash (i.e. a fail-open)


def deny(reason):
    # `inReason` is opt-IN, not default (EI-18828567391761902 + EI-18691482279179647).
    # A guard scanning SHELL text can safely quote its match back: the fragment is
    # shell syntax, and the reader recognises it. A guard scanning an interpreter
    # PAYLOAD cannot — that text is arbitrary user code, mostly prose, and quoting
    # a slice of it makes the guard look like it matched the prose. Two existing
    # tests enforce exactly that ("quotes back a real path token, never a prose
    # fragment"), and they caught this when the fragment was attached
    # unconditionally. The log gets the fragment either way, which is where the
    # person writing the ticket needs it.
    _frag = (_matched_fragment(_DENY_VIEW.get('clean'), _DENY_VIEW.get('at'))
             if _DENY_VIEW.get('inReason') else '')
    if _frag:
        reason = (
            '%s\n\nWhat the guard actually matched, AFTER normalization '
            '(quotes/comments/heredoc bodies stripped): `%s`\nIf that does not '
            'resemble your command, the normalizer mis-parsed it — that is the '
            'bug, not the construct you are looking at. Full record (verbatim '
            'command + this view): ~/.papercusp/hooks/cc/bash-resource-gate.denials.log'
            % (reason, _frag)
        )
    _log_denial(reason)
    json.dump({'hookSpecificOutput': {
        'hookEventName': 'PreToolUse',
        'permissionDecision': 'deny',
        'permissionDecisionReason': reason,
    }}, sys.stdout)
    sys.exit(0)

try:
    payload = json.loads(raw)
except Exception:
    allow()

tool_name = payload.get('tool_name', '') or ''
tool_input = payload.get('tool_input', {})
# 'Bash' is claude's name; exec_command/local_shell/shell are codex's shell
# tool names (the codex hooks.json attaches this script too — README table).
#
# EI-21971958067151594 — `mcp__<server>__capability_bash` is THE SAME SHELL
# reached over MCP, and it was silently exempt from this entire file. Measured
# 2026-08-31 on a box with 3 live bridges: `tauri-agent-tools dom --selector
# body` was DENIED as `Bash` and RAN as `capability:bash`, reading a foreign
# 2669x1391 webview; the self-matching-`pgrep` wait-loop likewise ran to its
# timeout. So EVERY deny in this file — the tauri target guard, `pkill -f`, the
# destructive-git set, the OS-scheduler lockout, the systemd-exit guard — was
# bypassable by spelling the same command through the MCP tool, and CLAUDE.md
# actively ROUTES agents onto that spelling ("long jobs: background them at the
# LAUNCH"). Exactly the spelling-shaped hole EI-18695939815676668 closed on the
# OMP side (isShellTool: `bash*` OR `shell`); this is its Claude-side twin.
#
# ANCHORED on purpose: `capability_bash_output` / `capability_bash_kill` take a
# `bash_id`, never a `command` — they are readers, not shells, and a loose
# prefix match would drag them in. The `command`-shape check below is a second
# net, but the name test is the one that states the intent.
_MCP_SHELL_TOOL_RE = re.compile(r'^mcp__.+__capability_bash$')


def _is_shell_tool(name):
    lowered = name.lower()
    return (lowered in ('bash', 'exec_command', 'local_shell', 'shell')
            or bool(_MCP_SHELL_TOOL_RE.match(lowered)))


if not _is_shell_tool(tool_name):
    allow()

command = tool_input.get('command') if isinstance(tool_input, dict) else None
if not isinstance(command, str) or not command.strip():
    allow()

# ── Long-foreground-exec advisory (coord-delivery-residual-gaps P-003) ──────
# A foreground Bash run blocks the session's turn for its whole duration: coord
# messages, wakes, and yields cannot reach the agent until it returns — the
# mid-exec deafness window (see the coord-mid-turn-delivery insight). When the
# caller EXPLICITLY requests a foreground timeout past the 2-min default, that
# is a declared intent to hold the turn for minutes — nudge it toward the
# native background primitive instead. STRICTLY per-backend: only Claude's
# `Bash` tool has `run_in_background` (same-session detach — the harness
# re-invokes the SAME session on exit; no delegation, no context loss), so only
# tool_name 'bash' gets the nudge. Codex shells (exec_command/local_shell/
# shell) have no native background primitive in our integration — no nudge
# (their deafness window is covered by the wake + escalation-ladder legs); OMP
# nudges its own `job` primitive from its own hook, not this script. SOFT by
# design: sets the ADVISORY string only — the command always proceeds, and any
# later deny gate still wins.
try:
    if tool_name.lower() == 'bash':
        _t = tool_input.get('timeout')
        _bg = tool_input.get('run_in_background')
        if not _bg and isinstance(_t, (int, float)) and _t > 120_000:
            ADVISORY = (
                f'long-foreground-exec advisory: this Bash call requests a FOREGROUND '
                f'timeout of {int(_t / 1000)}s. A foreground run holds your turn for its whole '
                f'duration — coord messages, wakes, and yield requests cannot reach you '
                f'until it returns (the mid-exec deafness window). For anything expected '
                f'to run >2min, prefer `run_in_background: true`: it stays in THIS session '
                f'(no delegation, no context loss) — the command detaches, you keep taking '
                f'turns, and you are re-invoked when it exits. Advisory only; this command '
                f'is proceeding as issued.'
            )
except Exception:
    pass  # advisory must never wedge a command

# Native-scheduler lockout (native-scheduler-lockout-2026-06-09 P-010): agent
# sessions must not create persistent OS schedules — a crontab entry outlives
# the hive as a zombie wake source that Pause/hive:status/the liveness
# backstop can't see. Command-position match (start / after ;&|/newline /
# sudo) so prose args ("look at this") never false-positive. Local decision,
# no HTTP; the owner's own sessions never carry the marker (D-003).
#
# EI-9937: the ;&|/newline separators in the command-position anchor are SHELL
# operators — but a `;`/`&`/`|` INSIDE a quoted argument is literal data, not a
# separator. So a read-only `grep -E "at|batch" code-run-batch-nudge.ts` (a regex
# alternation naming these very tokens) or a `"...; batch..."` string was denied
# as if it created an OS schedule. Strip quoted spans BEFORE matching: quoted
# content can only ever REMOVE a would-be separator, so every genuine (unquoted)
# `crontab -e`/`batch < f`/`&& crontab`/`sudo crontab` deny is preserved.
def _cmd_subst_end(s, i):
    # s[i:i+2] == '$(' — index just PAST the matching ')', or -1 when unbalanced.
    # Skips quoted spans so a ')' inside a quoted argument cannot close the
    # substitution, and recurses through nested substitutions via _dq_end.
    n, depth, j = len(s), 0, i + 1
    while j < n:
        c = s[j]
        if c == '\\':
            j += 2
            continue
        if c == "'":
            k = s.find("'", j + 1)
            if k == -1:
                return -1
            j = k + 1
            continue
        if c == '"':
            k = _dq_end(s, j)
            if k == -1:
                return -1
            j = k + 1
            continue
        if c == '`':
            k = s.find('`', j + 1)
            if k == -1:
                return -1
            j = k + 1
            continue
        if c == '(':
            depth += 1
        elif c == ')':
            depth -= 1
            if depth == 0:
                return j + 1
        j += 1
    return -1


def _dq_end(s, i):
    # s[i] == '"' — index of the quote that actually CLOSES this span, or -1.
    #
    # EI-23804564629952456. A command substitution RESTARTS shell quoting, so a
    # `"` inside `$( )` or backticks does NOT close the enclosing double-quoted
    # string. A flat scanner that stops at the first `"` therefore picks the
    # wrong terminator and INVERTS the quoted/unquoted classification for the
    # rest of the span: genuinely-quoted text is exposed to every matcher while
    # genuinely-live shell text is blanked. Measured, one root cause, both
    # directions — a false POSITIVE (`echo "n=$(psql -c "SELECT … > now() …")"`
    # denied as a redirect to a file named `now`) and a false NEGATIVE (a real
    # `> <tree path>` inside `$( )` inside `"…"` hidden from the shell-write
    # guard, while the same redirect in a BARE `$( )` is caught).
    #
    # An unbalanced `$(` or an unpaired backtick falls through to ordinary
    # character handling rather than bailing, so a malformed command degrades to
    # the previous behaviour instead of dropping the rest of the input.
    n, j = len(s), i + 1
    while j < n:
        c = s[j]
        if c == '\\':
            j += 2
            continue
        if c == '"':
            return j
        if c == '$' and j + 1 < n and s[j + 1] == '(':
            k = _cmd_subst_end(s, j)
            if k != -1:
                j = k
                continue
        elif c == '`':
            k = s.find('`', j + 1)
            if k != -1:
                j = k + 1
                continue
        j += 1
    return -1


def _blank_except_substitutions(inner, preserve_expansions):
    # The body of a double-quoted span is inert DATA — except for its command
    # substitutions, which the shell EXECUTES. Blank the data (as before) and
    # normalize the live code recursively, so `"…$(cat a > tree/b)…"` stays
    # scannable while `"…$(psql -c "SELECT … > now()")…"` does not expose the
    # SQL operator. Returns a single space when the span holds no substitution,
    # so the overwhelmingly common case emits byte-identical output to before.
    parts, k, m, found = [], 0, len(inner), False
    while k < m:
        ch = inner[k]
        if ch == '\\':
            k += 2
            continue
        if ch == '$' and k + 1 < m and inner[k + 1] == '(':
            e = _cmd_subst_end(inner, k)
            if e != -1:
                parts.append(_strip_quotes_and_comments(inner[k + 2:e - 1], preserve_expansions))
                found = True
                k = e
                continue
        elif ch == '`':
            e = inner.find('`', k + 1)
            if e != -1:
                parts.append(_strip_quotes_and_comments(inner[k + 1:e], preserve_expansions))
                found = True
                k = e + 1
                continue
        k += 1
    if not found:
        return ' '
    return ' ' + ' '.join(parts) + ' '


def _strip_quotes_and_comments(s, preserve_expansions=False):
    # THE shared normalizer for every scanner in this file: removes quoted spans
    # AND `#`-to-end-of-line comments in ONE quote-aware pass.
    #
    # QUOTES: replace single- and double-quoted spans with a single space so
    # operators (;&|) inside a quoted arg are not read as command separators, and
    # adjacent tokens are neither glued (a false negative) nor made adjacent to a
    # separator (a false positive). An unterminated quote drops the rest (only
    # ever more permissive). A backslash-escaped quote inside "..." doesn't close.
    #
    # COMMENTS: a `#` starts a comment only when the scanner is OUTSIDE quotes
    # AND it sits at start-of-output or after whitespace — so `$#`, `a#b` and
    # `http://host/path#frag` are untouched, while `echo "x # y"` keeps its
    # quoted `#` as data. The newline is deliberately NOT consumed: callers split
    # segments on [;&|\n]. Comment text is never executed, so removing it before
    # any guard matches is always correct (EI-19385448516432576: `grep -n foo
    # bar.ts # payload->x is the field` was denied as a redirect targeting `x`).
    #
    # WHY ONE PASS, AND WHY HERE (EI-19420133701663526). Comment-stripping used
    # to be a SECOND pass applied to this function's output, at the redirect
    # scanner only. Two passes cannot agree on what is quoted, because each
    # assumes the other already ran:
    #   - quotes-then-comments (what shipped) lets an ODD quote character inside
    #     a COMMENT break quote parity: this function ran first, read the
    #     comment's stray quote as an OPENING quote, and deleted everything up to
    #     the next quote — the opening quote of a real later argument. That
    #     produced both a false POSITIVE (a genuinely-quoted `>` exposed and
    #     denied — EI-19418179098729784 plus 3 duplicate reports) and a false
    #     NEGATIVE: `# note "` before `cat foo > <tree path> && echo "x"` had its
    #     entire redirect swallowed by the deleted span, and was ALLOWED.
    #   - comments-then-quotes (the reverse) reopens the hole that ordering
    #     existed to avoid: `echo "x # y" > tree/file.txt` would treat the quoted
    #     `#` as a comment introducer and swallow its own real redirect.
    # Scanning once removes the ordering question entirely, and doing it in the
    # SHARED normalizer rather than at one call site is what makes the fix
    # class-wide. The parity break was never redirect-specific: measured against
    # the two-pass build, the same `# note "` prefix also hid `git reset --hard`,
    # `git clean -fd`, `git checkout -- :/`, `git stash`, `pkill -f`, `crontab`
    # and the self-matching-pgrep guard — i.e. every deny-guard that called this
    # function WITHOUT the redirect scanner's comment pass. All are covered by
    # tests now; both quote characters trigger it, so a fix verified on `"` alone
    # leaves half the hole open.
    #
    # Like the sibling strippers this only ever REMOVES characters, so it can
    # never manufacture a match. The shell-write guard opts into preserving a
    # simple variable-only DOUBLE-QUOTED span (e.g. `"$f"`) as `$f`: the span
    # is a target candidate that cannot be resolved safely, and erasing it
    # would turn a variable-driven in-place rewrite into a completely silent
    # allow. Other quoted content, and all single-quoted content, stays blank;
    # preserving arbitrary quoted text would re-open the operator false-positive
    # class this normalizer exists to prevent.
    _quoted_expansion_only = re.compile(
        r'^\$(?:(?:[A-Za-z_][A-Za-z0-9_]*|\{[A-Za-z_][A-Za-z0-9_]*'
        r'(?:\[[^]]+\])?\}|[0-9@*#?$!-])[/._A-Za-z0-9-]*)$'
    )
    out, i, n = [], 0, len(s)
    while i < n:
        c = s[i]
        if c == '#' and (not out or out[-1].isspace()):
            j = s.find('\n', i)
            if j == -1:
                break  # comment runs to end of input — nothing after it
            i = j      # leave the newline itself to be emitted normally
            continue
        if c == "'":
            j = s.find("'", i + 1)
            if j == -1:
                break
            out.append(' ')
            i = j + 1
            continue
        if c == '"':
            # _dq_end, not a flat scan to the next `"`: a command substitution
            # restarts quoting, so its inner quotes must not close this span
            # (EI-23804564629952456 — see _dq_end for both failure directions).
            j = _dq_end(s, i)
            if j == -1:
                break
            inner = s[i + 1:j]
            if preserve_expansions and _quoted_expansion_only.fullmatch(inner):
                out.append(' ' + inner + ' ')
            else:
                out.append(_blank_except_substitutions(inner, preserve_expansions))
            i = j + 1
            continue
        out.append(c)
        i += 1
    return ''.join(out)

# ── Foreground shell-backgrounding advisory (EI-20202551640426512) ────────
# A foreground capability:bash call that embeds `nohup` or an unquoted shell
# background operator (`&`) is not actually detached from the capability
# wrapper. When that wrapper reaches its deadline, the child can die with it;
# the wrapper's exit code, a vanished PID, and a partial redirect log can then
# all look like successful completion. The native `run_in_background` mode is
# the supported same-session detach and reports the job's real result through
# capability:bash_output.
#
# This is deliberately advisory-only: the command still proceeds exactly as
# issued. The quote-aware normalizer keeps prose such as `echo "a & b"` and
# Bash's `&>` redirect from producing a misleading warning.
#
# Two established launch wrappers are intentionally exempt: `pc-heavy.sh`
# owns the self-throttled verification lifecycle, and `bin/vm-federation.sh`
# is the repo's explicit VM launcher. Their detached forms are covered by
# dedicated hook regressions and are not foreground result claims.
try:
    if tool_name.lower() == 'bash' and not tool_input.get('run_in_background'):
        _foreground_bg_cmd = _strip_quotes_and_comments(command)
        _has_shell_bg = bool(re.search(r'(?<![&>])&(?![&>])', _foreground_bg_cmd))
        _has_detach_wrapper = bool(re.search(r'\b(?:nohup|setsid)\b', _foreground_bg_cmd))
        _established_detach = bool(re.search(r'(?:scripts/)?pc-heavy\.sh\b|(?:\./)?bin/vm-federation\.sh\b', _foreground_bg_cmd))
        if (_has_shell_bg or _has_detach_wrapper) and not _established_detach:
            _deadline = tool_input.get('timeout')
            _deadline_text = (
                f'{int(_deadline / 1000)}s'
                if isinstance(_deadline, (int, float)) and _deadline > 0
                else 'the default 120s'
            )
            _shape = []
            if _has_detach_wrapper:
                _shape.append('`nohup`/`setsid`')
            if _has_shell_bg:
                _shape.append('a shell background operator `&`')
            # EI-20349478936631977: a TRUE detach wrapper adds a second, opposite
            # hazard the deadline text above cannot express. `nohup`/`setsid`
            # survives the wrapper, so the child is left in this session's
            # terminal scope — and systemd creates `vte-spawn-*.scope` with
            # KillMode=process. When the session ends, only the scope's MAIN
            # process is signalled: the detached child keeps running, owned by
            # nothing, while the unit reads inactive(dead) (D-015 — unit state
            # LAUNDERS the residue). It is then invisible to the residue census
            # too, which protects any pid holding a listening socket, so a leaked
            # SERVER is the one shape that guard can never report. That is how an
            # abandoned profiling host held ~70 GiB for 12h after its session
            # ended. Named only for nohup/setsid: a bare `&` is the common,
            # usually-harmless case and must not pay this text on every call.
            _orphan_clause = (
                'Lifetime, separately: `nohup`/`setsid` outlives this session. The child '
                'stays in your terminal scope, which systemd sets KillMode=process, so '
                'session end signals only the scope leader and your process keeps running '
                'unowned while the unit reads inactive(dead). Nothing reaps it and the '
                'residue census cannot report it if it holds a listening socket. If it '
                'must outlive the turn, give it an enforced deadline via '
                '`run_in_background: true` (SIGTERM then SIGKILL at `timeout`), or put it '
                'in its own reaped scope with `systemd-run --user --scope`. '
                if _has_detach_wrapper
                else ''
            )
            ADVISORY = (
                'foreground shell-backgrounding advisory (EI-20202551640426512): this '
                f'foreground Bash call contains {" and ".join(_shape)}, but the capability '
                f'wrapper still owns {_deadline_text} and may terminate the child with it. '
                'A wrapper exit code, vanished PID, or partial log is not proof that the '
                'job finished successfully. For long work use `run_in_background: true` '
                f'and read the real result from `capability:bash_output`. {_orphan_clause}'
                'Advisory only; this command is proceeding as issued.'
            )
except Exception:
    pass  # advisory must never wedge a command

# ══ SCANNABLE COMMAND — the shared normalizer every DENY guard matches through ══
#
# EI-19294800751120438. Before this existed, every deny-guard in this file
# re-implemented its own matching on RAW text: split on [;&|\n], peel a
# hand-maintained wrapper NAME-list (_WRAP_STRIP), re.match an anchored pattern.
# Measured 4 DENY / 14 probes on the shared-tree git guard — `bash -c "..."`,
# `sh -c`, `eval`, `git "reset" "--hard"`, `$(echo git) reset --hard`,
# `x=git; $x reset --hard`, `echo "..." | bash`, `env -S "..."` and
# `timeout 60 ...` ALL sailed through, and the same held for the pkill,
# systemctl-exit and crontab guards. The wrapper name-list is what rotted:
# the 2026-07-06 `rtk git reset --hard` bypass was fixed by ADDING `rtk` to the
# list, which left `timeout` (and every future wrapper) open.
#
# The fix is structural, ported from yc-software/qm's src/policy/command-policy.ts
# (`scannableCommand`), which scored 13/14 on the same probes running OUR rules:
#
#   scannable = dequote(strip_written_heredocs(cmd))
#               + "\n" + scannable(each executed-shell payload)   [recursive]
#
# Two properties make it drop-in for the existing guards:
#   1. Payloads are joined with NEWLINES, and every guard already splits on
#      [;&|\n] — so a `bash -c "git reset --hard"` payload arrives as its own
#      segment for free, with no change to any guard's patterns.
#   2. Quoted spans that are a single BARE WORD are unquoted in place (catching
#      `git "reset" "--hard"`), while quoted spans holding a whole command
#      collapse to "" in the base and are recovered as a separate payload line.
#
# Wrapper handling is STRUCTURAL (parse the argv, find the real command word)
# rather than a name-list, so `timeout`/`nice`/`sudo`/`env -S` cannot rot again.
#
# Guards keep their own patterns; only the TEXT they match against changes.
# Regression table: __tests__/bash-resource-gate.test.ts.

_SCAN_BARE_WORD_RE = re.compile(r'^[\w@%+=:,./-]*$')
_SCAN_MAX_DEPTH = 8
_SCAN_SHELLS = ('bash', 'sh', 'dash', 'zsh', 'ksh')


def _scan_bare_word(inner):
    """qm's unquoteBareWord: the quoted span's content, iff it is one safe word."""
    return inner if _SCAN_BARE_WORD_RE.match(inner) else None


def _scan_decode_ansi_c(value):
    """Decode a $'...' ANSI-C span so \\x67\\x69\\x74 cannot hide a keyword."""
    def _hex(m):
        return chr(int(m.group(1), 16))

    def _octal(m):
        return chr(int(m.group(1), 8))

    simple = {'a': '\a', 'b': '\b', 'e': '\x1b', 'f': '\f',
              'n': '\n', 'r': '\r', 't': '\t', 'v': '\v'}
    value = re.sub(r'\\x([0-9a-fA-F]{1,2})', _hex, value)
    value = re.sub(r'\\u([0-9a-fA-F]{4})', _hex, value)
    value = re.sub(r'\\U([0-9a-fA-F]{8})', _hex, value)
    value = re.sub(r'\\([0-7]{1,3})', _octal, value)
    return re.sub(r'\\([\\\'"abefnrtv])',
                  lambda m: simple.get(m.group(1), m.group(1)), value)


def _scan_heredoc_runs_shell(command_line):
    """True when the heredoc on this line is PIPED INTO a shell (so its body is
    executed and must be scanned) rather than merely written to a file."""
    for m in re.finditer(r'(?:^|[|;&]\s*)(?:\S*/)?(?:ba|da|k|z)?sh((?:\s+[^|;&]*)?)',
                         command_line):
        if not re.search(r'(?:^|\s)-[^-\s]*c(?:\s|$)', m.group(1) or ''):
            return True
    return False


def _scan_strip_heredocs(cmd, *, strip_nonexecuted=False):
    def _repl(m):
        pre, post = m.group(1), m.group(4)
        line = pre + post
        if not _scan_heredoc_runs_shell(line) and (strip_nonexecuted or '>' in line):
            return ''
        return m.group(0)

    return re.sub(
        r'^([^\n]*)<<-?\s*(["\']?)([A-Za-z_]\w*)\2([^\n]*)\n([\s\S]*?)^\s*\3\s*$',
        _repl, cmd, flags=re.M)


def _scan_strip_written_heredocs(cmd):
    """Drop heredoc BODIES that are only written to a file — their content is
    inert data (`cat <<EOF > notes.txt` describing a dangerous command is not
    running it). Bodies fed to a shell are KEPT so they stay scannable."""
    return _scan_strip_heredocs(cmd)


def _scan_strip_nonexecuted_heredocs(cmd):
    """Drop heredoc bodies that are data, not shell commands.

    Heavy-admission scans shell command positions, so a `cat <<EOF` body is
    not executable command text even when it is printed to stdout. Keep bodies
    that are piped into a shell: those really can execute a heavy command.
    Other interpreters are data from the shell's perspective too; their own
    language is outside this lightweight admission matcher.
    """
    return _scan_strip_heredocs(cmd, strip_nonexecuted=True)


# Shell metacharacters neutralized when a MULTI-WORD quoted span is unwrapped.
# Blanking them keeps the span's words visible to a guard while guaranteeing the
# unwrap can never manufacture a separator/redirect that wasn't there. Both
# redirect directions matter: a quoted ASCII arrow such as `=>` must not expose
# its `>` when the span is made scannable (EI-21540753943219201).
_SCAN_INERT_METACHARS = re.compile(r'[;&|<>()`{}>\n]')


def _scan_unquote_span(inner):
    """The scannable text for a quoted span.

    qm collapses a multi-word span to `""` — correct for qm, whose rules are
    UNANCHORED substrings, so the payload is recovered on its own line anyway.
    Here it LOSES information a guard needs: `pkill -f "npm run test"` became
    `pkill -f ""` and the pkill guard (which matches on the pattern ARGUMENT)
    stopped firing — a real regression caught by the existing suite.

    So keep the content and neutralize the metacharacters instead. The words stay
    matchable; `echo "done; ok" && crontab -e` cannot gain a fake `;` separator.
    Guards stay anchored (`re.match`), so surfacing inner words does NOT create
    false positives: `git commit -m "explain git reset --hard"` still starts its
    segment with `git commit`, which no destructive-git pattern matches."""
    word = _scan_bare_word(inner)
    if word is not None:
        return word
    return _SCAN_INERT_METACHARS.sub(' ', inner)


def _scan_dequote(cmd):
    """Unquote quoted spans, decode $'...', unescape backslashes.
    A quoted span containing a command substitution keeps the substitution."""
    def _dq(m):
        span = m.group(0)
        subs = re.findall(r'\$\([^)]*\)|`[^`]*`', span)
        if subs:
            return ' '.join(subs)
        return _scan_unquote_span(span[1:-1])

    def _ansi(m):
        return _scan_unquote_span(_scan_decode_ansi_c(m.group(1)))

    def _sq(m):
        return _scan_unquote_span(m.group(0)[1:-1])

    out = re.sub(r'"(?:[^"\\]|\\.)*"', _dq, cmd)
    out = re.sub(r"\$'((?:[^'\\]|\\.)*)'", _ansi, out)
    out = re.sub(r"'[^']*'", _sq, out)
    return re.sub(r'\\([\w@%+=:,./-])', r'\1', out)


def _scan_command_substitution(text, start):
    """Body + end offset of the $( ... ) beginning at `start`, honouring nesting
    and quotes. None when unterminated."""
    depth, quote, j = 1, '', start + 2
    while j < len(text):
        c = text[j]
        if c == '\\':
            j += 2
            continue
        if quote:
            if c == quote:
                quote = ''
            j += 1
            continue
        if c in ('"', "'"):
            quote = c
        elif c == '$' and j + 1 < len(text) and text[j + 1] == '(':
            depth += 1
            j += 1
        elif c == ')':
            depth -= 1
            if depth == 0:
                return text[start + 2:j], j + 1
        j += 1
    return None


def _scan_shell(text):
    """Tokenize into command word-lists (split on shell operators/newlines) and
    collect the bodies of every $( ) / backtick substitution as `nested`."""
    commands, nested, words = [], [], []
    i, n = 0, len(text)

    def _flush():
        if words:
            commands.append(list(words))
            del words[:]

    while i < n:
        c = text[i]
        if c.isspace():
            if c == '\n':
                _flush()
            i += 1
            continue
        if c == '#' and not words:
            while i < n and text[i] != '\n':
                i += 1
            continue
        if c in ';|&(){}':
            _flush()
            while i < n and text[i] in ';|&(){}':
                i += 1
            continue
        word, started = '', False
        while i < n and not text[i].isspace() and (
                text[i] not in ';|&(){}' or (text[i] == '&' and word.endswith(('<', '>')))):
            c = text[i]
            if c == '\\':
                if i + 1 < n and text[i + 1] == '\n':
                    i += 2
                elif i + 1 < n:
                    started = True
                    word += text[i + 1]
                    i += 2
                else:
                    i += 1
                continue
            if c == "'":
                started = True
                end = text.find("'", i + 1)
                if end < 0:
                    word += text[i + 1:]
                    i = n
                else:
                    word += text[i + 1:end]
                    i = end + 1
                continue
            if c == '"':
                started = True
                i += 1
                while i < n and text[i] != '"':
                    if text[i] == '\\':
                        if i + 1 < n:
                            word += text[i + 1]
                            i += 2
                        else:
                            i += 1
                        continue
                    if text[i] == '$' and i + 1 < n and text[i + 1] == '(':
                        sub = _scan_command_substitution(text, i)
                        if sub is None:
                            word += text[i]
                            i += 1
                        else:
                            nested.append(sub[0])
                            i = sub[1]
                        continue
                    if text[i] == '`':
                        end = text.find('`', i + 1)
                        if end < 0:
                            i += 1
                        else:
                            nested.append(text[i + 1:end])
                            i = end + 1
                        continue
                    word += text[i]
                    i += 1
                if i < n and text[i] == '"':
                    i += 1
                continue
            if c == '$' and i + 1 < n and text[i + 1] == '(':
                started = True
                sub = _scan_command_substitution(text, i)
                if sub is None:
                    word += text[i]
                    i += 1
                else:
                    nested.append(sub[0])
                    i = sub[1]
                continue
            if c == '`':
                started = True
                end = text.find('`', i + 1)
                if end < 0:
                    i += 1
                else:
                    nested.append(text[i + 1:end])
                    i = end + 1
                continue
            word += c
            started = True
            i += 1
        if started or word:
            words.append(word)
    _flush()
    return commands, nested


def _scan_command_start(words):
    """Index of the real command word, skipping VAR=val assignments, shell
    keywords and redirections."""
    i = 0
    while i < len(words):
        w = words[i]
        if re.match(r'^[A-Za-z_]\w*=', w) or re.match(r'^(?:if|then|elif|else|while|until|do|!)$', w):
            i += 1
        elif re.match(r'^\d*(?:>>?|<<?|<>|>&|<&)$', w):
            i += 2
        elif re.match(r'^\d*(?:>>?|<<?|<>|>&|<&).+', w):
            i += 1
        else:
            break
    return i


def _scan_option_end(words, start, value_options):
    """Index just past a wrapper's own options — where its wrapped command begins."""
    i = start
    while i < len(words):
        w = words[i]
        if w == '--':
            return i + 1
        if not w.startswith('-') or w == '-':
            return i
        if w.split('=')[0] in value_options and '=' not in w:
            i += 1
        i += 1
    return i


def _scan_env_split_words(args):
    """`env -S 'cmd args'` / `env --split-string=...` — the payload is a shell string."""
    idx = -1
    for i, a in enumerate(args):
        if a == '-S' or a.startswith('-S') or a == '--split-string' or a.startswith('--split-string='):
            idx = i
            break
    if idx < 0:
        return None
    arg = args[idx]
    compact = arg.startswith('-S') and len(arg) > 2
    if '=' in arg:
        value = arg.split('=', 1)[1]
    elif compact:
        value = arg[2:]
    else:
        value = args[idx + 1] if idx + 1 < len(args) else None
    rest = args[idx + (1 if ('=' in arg or compact) else 2):]
    if value is None:
        return []
    cmds, _ = _scan_shell(' '.join([value] + rest))
    return cmds[0] if cmds else []


def _scan_unwrapped(inner):
    """Emit a structural wrapper's INNER command line as its own payload, then
    keep descending.

    This is the one place papercusp deliberately diverges from qm. qm's rules are
    UNANCHORED substring patterns, so `timeout 60 git reset --hard` matches their
    base text directly and peeling is only needed for nesting. Every guard here
    uses an ANCHORED `re.match` (stricter — far fewer false positives on prose
    like `rg -n 'pkill'`), which means the segment must actually START with the
    real command word. So the wrapper has to be stripped into its own line, or an
    anchored guard can never see it."""
    if not inner:
        return []
    return [' '.join(inner)] + _scan_segment_payloads(inner)


def _scan_segment_payloads(words):
    """Shell payloads executed BY this command: a `-c` script, or the wrapped
    command of a structural wrapper. Recurses so `timeout 60 sudo bash -c X`
    yields X. This replaces the hand-maintained wrapper NAME-list."""
    start = _scan_command_start(words)
    if start >= len(words):
        return []
    exe = words[start].split('/')[-1]
    args = words[start + 1:]

    if exe in _SCAN_SHELLS:
        for i, a in enumerate(args):
            if re.match(r'^-[^-]*c', a):
                # `-c` script is the next word (or glued, e.g. `-xc`).
                return [args[i + 1]] if i + 1 < len(args) else []
        return []
    if exe == 'eval':
        return [' '.join(args)] if args else []
    if exe == 'env':
        split = _scan_env_split_words(args)
        if split is not None:
            return _scan_unwrapped(split)
        nxt = _scan_option_end(args, 0, {'-u', '--unset', '-C', '--chdir', '-S', '--split-string'})
        while nxt < len(args) and re.match(r'^[A-Za-z_]\w*=', args[nxt]):
            nxt += 1
        return _scan_unwrapped(args[nxt:])
    if exe == 'sudo':
        nxt = _scan_option_end(args, 0, {
            '-u', '--user', '-g', '--group', '-h', '--host', '-p', '--prompt',
            '-C', '--chdir', '-T', '--command-timeout', '-R', '--chroot', '-t', '--type'})
        return _scan_unwrapped(args[nxt:])
    if exe == 'timeout':
        nxt = _scan_option_end(args, 0, {'-s', '--signal', '-k', '--kill-after'})
        return _scan_unwrapped(args[nxt + 1:])
    if exe == 'nice':
        return _scan_unwrapped(args[_scan_option_end(args, 0, {'-n', '--adjustment'}):])
    if exe == 'ionice':
        return _scan_unwrapped(args[_scan_option_end(args, 0, {'-c', '-n', '-p'}):])
    if exe == 'time':
        return _scan_unwrapped(args[_scan_option_end(args, 0, {'-o', '--output', '-f', '--format'}):])
    if exe == 'xargs':
        nxt = _scan_option_end(args, 0, {
            '-a', '--arg-file', '-d', '--delimiter', '-E', '--eof', '-I', '--replace',
            '-L', '--max-lines', '-n', '--max-args', '-P', '--max-procs', '-s', '--max-chars'})
        return _scan_unwrapped(args[nxt:])
    if exe in ('command', 'exec', 'nohup', 'setsid', 'stdbuf', 'nocache', 'nocorrect', 'rtk', 'doas', 'coproc'):
        value_opts = {'-a'} if exe == 'exec' else ({'-i', '-o', '-e'} if exe == 'stdbuf' else set())
        return _scan_unwrapped(args[_scan_option_end(args, 0, value_opts):])
    return []


def _scan_segment_consumes_stdin(words):
    """True when this pipeline stage feeds its STDIN to a shell (so the upstream
    `echo "..."` is executed): `| bash`, `| sh -s`, `| sudo bash`, …"""
    start = _scan_command_start(words)
    if start >= len(words):
        return False
    exe = words[start].split('/')[-1]
    args = words[start + 1:]
    if exe in _SCAN_SHELLS:
        stdin_scripts = {'-', '/dev/stdin', '/dev/fd/0', '/proc/self/fd/0'}
        i = 0
        while i < len(args):
            a = args[i]
            if re.match(r'^-[^-]*c', a):
                return False
            if a == '-s':
                return True
            if a in ('-O', '-o', '--rcfile', '--init-file'):
                i += 2
                continue
            if a == '--':
                return i + 1 >= len(args) or args[i + 1] in stdin_scripts
            if not a.startswith('-') or a == '-':
                return a in stdin_scripts
            i += 1
        return True
    if exe == 'env':
        split = _scan_env_split_words(args)
        if split is not None:
            return _scan_segment_consumes_stdin(split)
        nxt = _scan_option_end(args, 0, {'-u', '--unset', '-C', '--chdir', '-S', '--split-string'})
        while nxt < len(args) and re.match(r'^[A-Za-z_]\w*=', args[nxt]):
            nxt += 1
        return _scan_segment_consumes_stdin(args[nxt:])
    if exe in ('sudo', 'command', 'exec', 'nohup', 'setsid', 'rtk', 'doas', 'nice', 'timeout'):
        return _scan_segment_consumes_stdin(args[_scan_option_end(args, 0, set()):])
    return False


def _scan_pipelines(text):
    """Split into pipelines of segments so `echo X | bash` can be recognized."""
    pipelines, pipeline, start, quote = [], [], 0, ''

    def _finish_segment(end):
        seg = text[start:end].strip()
        if seg:
            pipeline.append(seg)

    i = 0
    while i < len(text):
        ch = text[i]
        if ch == '\\':
            i += 2
            continue
        if quote:
            if ch == quote:
                quote = ''
            i += 1
            continue
        if ch in ('"', "'", '`'):
            quote = ch
            i += 1
            continue
        if ch in '|&' and i + 1 < len(text) and text[i + 1] == ch:
            _finish_segment(i)
            if len(pipeline) > 1:
                pipelines.append(list(pipeline))
            del pipeline[:]
            i += 2
            start = i
            continue
        if ch == '|':
            _finish_segment(i)
            i += 2 if (i + 1 < len(text) and text[i + 1] == '&') else 1
            start = i
            continue
        if ch in ';\n&':
            _finish_segment(i)
            if len(pipeline) > 1:
                pipelines.append(list(pipeline))
            del pipeline[:]
            i += 1
            start = i
            continue
        i += 1
    _finish_segment(len(text))
    if len(pipeline) > 1:
        pipelines.append(list(pipeline))
    return pipelines


def _scan_piped_payloads(text):
    """`echo "git reset --hard" | bash` — the upstream literal is executed."""
    out = []
    for pipeline in _scan_pipelines(text):
        for idx in range(1, len(pipeline)):
            cmds, _ = _scan_shell(pipeline[idx])
            if not cmds or not _scan_segment_consumes_stdin(cmds[0]):
                continue
            upstream = pipeline[idx - 1]
            up_cmds, _ = _scan_shell(upstream)
            if not up_cmds:
                continue
            words = up_cmds[0]
            s = _scan_command_start(words)
            if s < len(words) and words[s].split('/')[-1] in ('echo', 'printf', 'cat'):
                out.append(' '.join(words[s + 1:]))
            else:
                out.append(upstream)
    return out


def _scan_here_string_payloads(text):
    """`bash <<< "git reset --hard"` — the here-string body is executed. Strip the
    ENCLOSING quotes before emitting: left on, the recursive dequote would see a
    multi-word quoted span, reject it as a non-bare-word and collapse it to ""."""
    out = []
    for m in re.finditer(r'<<<\s*(.+)', text):
        body = m.group(1).strip()
        if len(body) >= 2 and body[0] == body[-1] and body[0] in ('"', "'"):
            body = body[1:-1]
        if body:
            out.append(body)
    return out


_SCAN_SUBST_RE = re.compile(r'\$\(([^()]*)\)|`([^`]*)`')


def _scan_inlined_substitutions(text):
    """Emit a variant with simple command substitutions INLINED in place.

    `$(echo git) reset --hard` must produce a line that literally STARTS with
    `git`, because every guard anchors with re.match. Appending the substitution
    body as its own segment (which _scan_shell already does) is not enough — that
    segment is `echo git`, which no guard matches. So substitute the value in:
    `echo|printf <word>` contributes <word>; anything else collapses to nothing
    (never to its own text, which would re-introduce the wrapper word)."""
    def _inline(m):
        body = (m.group(1) if m.group(1) is not None else m.group(2) or '').strip()
        words = body.split()
        if len(words) >= 2 and words[0].split('/')[-1] in ('echo', 'printf'):
            return ' '.join(w for w in words[1:] if not w.startswith('-'))
        return ''

    if not _SCAN_SUBST_RE.search(text):
        return []
    out = _SCAN_SUBST_RE.sub(_inline, text)
    out = re.sub(r'\s+', ' ', out).strip()
    return [out] if out and out != text.strip() else []


def _scan_variable_payloads(text):
    """`x=git; $x reset --hard` — substitute simple literal assignments so the
    keyword is visible. Only plain `name=word` at a command position."""
    assigns = dict(re.findall(r'(?:^|[;&|\n]\s*)([A-Za-z_]\w*)=([\w@%+=:,./-]+)', text))
    if not assigns:
        return []
    def _sub(m):
        return assigns.get(m.group(1) or m.group(2), m.group(0))
    out = re.sub(r'\$\{(\w+)\}|\$(\w+)', _sub, text)
    return [out] if out != text else []


def _scan_executed_payloads(text):
    cmds, nested = _scan_shell(text)
    out = list(nested)
    for words in cmds:
        out.extend(_scan_segment_payloads(words))
    out.extend(_scan_piped_payloads(text))
    out.extend(_scan_here_string_payloads(text))
    out.extend(_scan_variable_payloads(text))
    out.extend(_scan_inlined_substitutions(text))
    return [p for p in out if p and p.strip()]


def _strip_comments_outside_quotes(s):
    """Remove `#`-to-end-of-line comments, leaving everything else BYTE-IDENTICAL.

    The sibling of `_strip_quotes_and_comments`, for the one caller that still
    needs its quotes intact: `_scannable_command` hands its output to
    `_scan_dequote`, which must see the real quoting to unquote it correctly. So
    quoted spans are copied VERBATIM here (quotes included) rather than blanked,
    and an unterminated quote copies the rest rather than dropping it —
    `_scan_dequote` handles unbalanced quotes itself, and dropping text is the
    permissive direction this whole fix exists to close.

    WHY THIS IS NEEDED (EI-19420133701663526). Making the shared quote-stripper
    comment-aware fixed the redirect/interpreter scanners, but every OTHER deny
    guard matches against `_scannable_command`, which reaches `_scan_dequote`
    without ever stripping comments — so the identical parity break still hid
    them. Measured against that build, prefixing `# note "` to an otherwise-denied
    command flipped `git reset --hard`, `git clean -fd`, `git checkout -- :/`,
    `git stash`, `pkill -f` and the self-matching-pgrep guard from DENY to ALLOW.

    The mechanism is subtler than the redirect leg's and worth stating, because
    nothing here deletes the dangerous command: the comment's stray quote pairs
    with the opening quote of a real later argument, so `_scan_dequote` treats
    everything between them — INCLUDING the newline and the `&&` — as quoted
    DATA and neutralises those separators. The dangerous command survives intact
    but is flattened onto the comment's line, which demotes it out of COMMAND
    POSITION, and every one of those guards anchors on command position. Traced:
        `# note "` + newline + `git reset --hard && echo "x"`
      becomes  `# note  git reset --hard    echo x"`   (one line, git mid-line)
    Stripping the comment first restores the newline as a real separator, so
    `git reset --hard` lands at the start of its own segment again.

    Comment rule matches its sibling: a `#` introduces a comment only outside
    quotes AND at start-of-output or after whitespace, so `$#`, `a#b` and
    `http://host/path#frag` survive. The newline is not consumed — guards split
    segments on [;&|\\n] and that separator is exactly what must be preserved.
    """
    out, i, n = [], 0, len(s)
    while i < n:
        c = s[i]
        if c == '#' and (not out or out[-1].isspace()):
            j = s.find('\n', i)
            if j == -1:
                break  # comment runs to end of input — nothing after it
            i = j      # leave the newline itself as a real separator
            continue
        if c == "'":
            j = s.find("'", i + 1)
            if j == -1:
                out.append(s[i:])
                break
            out.append(s[i:j + 1])
            i = j + 1
            continue
        if c == '"':
            j = i + 1
            while j < n:
                if s[j] == '\\':
                    j += 2
                    continue
                if s[j] == '"':
                    break
                j += 1
            if j >= n:
                out.append(s[i:])
                break
            out.append(s[i:j + 1])
            i = j + 1
            continue
        out.append(c)
        i += 1
    return ''.join(out)


def _scannable_command(cmd, _depth=0):
    """The text every DENY guard should match against. Newline-joined so guards
    that already split on [;&|\\n] pick up nested payloads as free segments."""
    try:
        stripped = _scan_strip_written_heredocs(cmd)
        # Comments go BEFORE both dequoting and payload extraction: text inside a
        # `#` comment is never executed, so a payload found there would be a false
        # positive, and a stray quote there would corrupt the dequote (above).
        stripped = _strip_comments_outside_quotes(stripped)
        base = _scan_dequote(stripped)
        if _depth >= _SCAN_MAX_DEPTH:
            return base
        payloads = _scan_executed_payloads(stripped)
        if not payloads:
            return base
        seen, parts = set(), [base]
        for p in payloads:
            if p in seen:
                continue
            seen.add(p)
            parts.append(_scannable_command(p, _depth + 1))
        return '\n'.join(parts)
    except Exception:
        # A normalizer fault must never wedge every Bash call, and must never
        # make a guard MORE permissive than it was before: fall back to raw.
        return cmd


_SCANNABLE_CACHE = {}


def _scannable():
    """Memoized scannable form of THIS invocation's command. Lazy so a call that
    exits early on an advisory never pays for the normalization.

    Use for an ANCHORED guard (`re.match` at command position). Such a guard is
    safe to hand unquoted inner words: prose lands mid-segment, never at command
    position, so `git commit -m "explain git reset --hard"` cannot match."""
    if 'v' not in _SCANNABLE_CACHE:
        _SCANNABLE_CACHE['v'] = _scannable_command(command)
    return _SCANNABLE_CACHE['v']


def _scannable_quote_stripped():
    """Scannable form for a guard that must NOT see quoted PROSE.

    Some guards match a subcommand anywhere in the text rather than at command
    position (the tauri-agent-tools target guard, the scheduler keyword guard).
    Those relied on `_strip_quotes_and_comments` DELETING quoted spans, so a sentence like
    `echo "you could run tauri-agent-tools eval ..."` was not read as an
    invocation — surfacing the words instead re-created exactly that false deny
    (caught by the existing suite, EI-10939 / EI-9937).

    So keep the original base treatment (quoted spans removed) and append only the
    EXECUTED payload lines, which are genuine code rather than prose. That closes
    the `bash -c "crontab -e"` hole without weakening the prose exemption."""
    if 'qs' not in _SCANNABLE_CACHE:
        try:
            # Interpreter heredocs are data from the shell's perspective. A
            # Python variable named `batch` must not look like the `batch`
            # scheduler; shell-fed heredocs remain scannable.
            shell_scannable = _scan_strip_nonexecuted_heredocs(command)
            payloads = _scan_executed_payloads(shell_scannable)
            parts = [_strip_quotes_and_comments(shell_scannable)]
            seen = set()
            for p in payloads:
                if p in seen:
                    continue
                seen.add(p)
                parts.append(_scannable_command(p))
            _SCANNABLE_CACHE['qs'] = '\n'.join(parts)
        except Exception:
            _SCANNABLE_CACHE['qs'] = _strip_quotes_and_comments(command)
    return _SCANNABLE_CACHE['qs']


def _pgrep_short_flags_have_f(flags_str):
    # Case-sensitive: -f/--full is full-cmdline match; -F is pidfile (not it).
    for _g in re.findall(r'-([A-Za-z]+)', flags_str):
        if 'f' in _g:
            return True
    return False


# A one-shot full-cmdline query is not an infinite loop, so denying it would be
# disproportionate. Its answer is still untrustworthy when the pattern is
# literal and unbracketed: the invoking `bash -c` carries that same text in its
# argv, which manufactures a plausible PID even when no target exists. This is
# the quieter half of WI-7134's live failure — three of four owner-id lookups
# returned the querying shell rather than the fleet member.
#
# This runs before the generic pipeline advisories below. `pgrep -f … | head`
# is the most tempting way to turn the contaminated set into one plausible PID,
# so the specific self-match diagnosis must win the single advisory slot.
_PGREP_ONESHOT_ADVISORY = (
    'bare pgrep -f self-match advisory (WI-7134): this command is proceeding, '
    'but its result includes your own invoking shell whenever the unbracketed '
    'pattern appears literally in the command. A plausible PID is therefore '
    'not proof that the target exists. For a Papercusp-managed agent/task use '
    '`processes:list { coordOwnerId: "<coord-owner-id>", live: true }`; its '
    '`confinement` result includes the derived cgroup path, scope unit, source, '
    'and whether the task is inside the operator cgroup. For a raw host pattern '
    'use `node scripts/proc-guard.mjs check <pattern>`, which excludes the '
    "caller and its ancestors. If raw pgrep is essential, bracket the first "
    "character (`pgrep -f '[l]int-tsc'`) so the pattern cannot match its own "
    'argv. Advisory only; this command is proceeding as issued.'
)


def _unbracketed_pgrep_full_match(cmd):
    """Return a bounded one-shot `pgrep -f` invocation, or None.

    `_scannable()` has already dequoted executed shell payloads and placed
    nested `bash -c` / command-substitution bodies on their own lines. Splitting
    on shell control operators therefore gives us command-position matching
    without treating quoted prose as an invocation.
    """
    for _segment in re.split(r'(?:&&|\|\||[;&|\n])', cmd):
        _candidate = _segment.strip()
        if not _candidate:
            continue
        # Shell control words and negation may prefix a real command while
        # leaving it at command position. Loop forms are denied by the stronger
        # guard below after this advisory is selected; deny() still wins.
        while True:
            _trimmed = re.sub(
                r'^(?:(?:if|then|elif|do|while|until)\s+|!\s*|command\s+)',
                '',
                _candidate,
                count=1,
            )
            if _trimmed == _candidate:
                break
            _candidate = _trimmed.lstrip()

        _call = re.match(r'(?:\S*/)?pgrep\b(.*)$', _candidate)
        if not _call:
            continue

        _has_full = False
        _after_double_dash = False
        _pattern = None
        for _token in re.findall(r'\S+', _call.group(1)):
            if not _after_double_dash and _token == '--':
                _after_double_dash = True
                continue
            if not _after_double_dash and _token.startswith('-') and _token != '-':
                if _token == '--full' or (
                        not _token.startswith('--')
                        and _pgrep_short_flags_have_f(_token)):
                    _has_full = True
                continue
            _pattern = _token
            break

        if _has_full and _pattern and '[' not in _pattern:
            return _candidate[:160]
    return None


if not ADVISORY:
    _pgrep_oneshot = _unbracketed_pgrep_full_match(_scannable())
    if _pgrep_oneshot:
        ADVISORY = _PGREP_ONESHOT_ADVISORY

# Shared by the background notification guard and the foreground verification
# guard below. The filter list is intentionally heuristic: every downstream
# pipeline stage replaces the upstream status, but these are the common output
# readers/formatters that make a failed verification look plausibly green.
_PIPE_TAIL_RE = re.compile(
    r'(?<!\|)\|(?!\|)\s*(?:\S*/)?'
    r'(?:tail|head|grep|egrep|fgrep|tee|wc|sed|awk|sort|uniq|cut|tr'
    r'|jq|column|xargs|cat|tac|nl|less|more)'
    r'\b[^|;&\n]*$'
)

# Foreground pipelines are ubiquitous, so warning on EVERY `cmd | filter`
# would drown useful advisories in ordinary exploration (`ps | grep`,
# `git status | tail`). Restrict that path to commands whose upstream stage
# declares build/test/verification intent. Background jobs retain the broader
# matcher because their completion notification is itself the verdict surface.
_PIPE_VERIFICATION_RE = re.compile(
    r'\b(?:cargo\s+(?:test|check|build|clippy)|go\s+test|'
    r'(?:python\s+-m\s+)?pytest|(?:npm|pnpm|yarn|bun)\s+(?:test|run\s+'
    r'(?:test(?::[\w:-]+)?|build|check|lint(?::[\w:-]+)?|typecheck))|'
    r'(?:npx\s+)?(?:vitest|tsc|eslint)\b|deno\s+test|dotnet\s+(?:test|build)|'
    r'mvn\s+(?:test|verify|package)|gradle\s+(?:test|check|build)|'
    r'make\s+(?:test|check|build)|cmake\s+--build|mix\s+test|swift\s+test|'
    r'xcodebuild\b|rspec\b)'
)

# ── Piped background exit-code trap advisory (EI-8871/EI-14065) ────────────
# `cmd | tail -N` (or `| head` / `| grep`) run in the background reports the
# harness's completion notification with the PIPE's LAST STAGE exit code, not
# the real command's — tail/head/grep almost always exit 0 regardless of
# whether the upstream command failed, so a failing test/build/rsync/ssh
# silently reads as "completed (exit code 0)". Documented + recurring (first
# EI-8871 2026-07-09, hit again 2026-07-12 on rsync/ssh, filed a THIRD time as
# EI-14065 2026-07-17) — see agent-insights/background-test-pipe-exit-code-trap.
# SOFT by design (never denies): only Claude's `Bash` tool has
# `run_in_background` + a completion notification that summarizes an exit
# code this way, so only tool_name 'bash' is checked. Skipped when the caller
# already handles it (mentions pipefail/PIPESTATUS/an explicit EXIT capture
# anywhere in the command).
try:
    if tool_name.lower() == 'bash' and tool_input.get('run_in_background'):
        _pipe_cmd = _strip_quotes_and_comments(command)
        # Safety-escape check against the RAW command (not quote-stripped): a
        # real-world safe pattern is often itself inside quotes (e.g.
        # `echo "EXIT=${PIPESTATUS[0]}"`), which quote-stripping would erase.
        if not re.search(r'pipefail|PIPESTATUS|EXIT\s*=\s*\$\?', command):
            # A top-level `|` (not `||`) immediately followed by an
            # EXIT-CODE-MASKING stage (optionally via a path, with flags/args)
            # running to the end of its `;`/`&&`/`||`/newline-delimited segment.
            #
            # EI-18686555459167489: the original list was tail/head/grep only,
            # which let the most natural idiom for a LONG verification run walk
            # straight through — `tsc 2>&1 | tee build.log`, `… | wc -l`,
            # `… | sed -n '1,40p'`, `… | sort | uniq -c`. Every one of those
            # exits 0 no matter what the upstream did, so the notification still
            # reports a false green; the advisory just wasn't there to say so.
            # The underlying truth is that ANY downstream stage replaces the
            # upstream's status, so the stage list is only a heuristic for "the
            # caller probably cares about the upstream's exit code" — it should
            # cover the common text filters, not just the three first observed.
            # (`grep` is doubly hazardous: it exits 1 on NO MATCH, so it can also
            # INVERT a clean run into an apparent failure.)
            for _pseg in re.split(r'&&|\|\||;|\n', _pipe_cmd):
                if _PIPE_TAIL_RE.search(_pseg.strip()):
                    ADVISORY = (
                        'background-pipe exit-code advisory (EI-8871/EI-14065): this '
                        'backgrounded command pipes into tail/head/grep/tee/wc/sed/awk/sort '
                        "— the completion notification will report THAT stage's exit code, "
                        'not the real '
                        'command\'s (those stages exit 0 almost regardless of upstream '
                        'failure), so a failing test/build/rsync/ssh can read as "completed '
                        '(exit code 0)". Redirect to a log file instead (`cmd > '
                        '/tmp/x.log 2>&1`) and read the log/grep it separately, or add `set '
                        '-o pipefail` (and read `${PIPESTATUS[0]}`) if you need the pipe. '
                        'Never trust the notification\'s exit code alone here. Advisory '
                        'only; this command is proceeding as issued.'
                    )
                    break
except Exception:
    pass  # advisory must never wedge a command

# ── ripgrep `-r<flag>` clustered-flag advisory (EI-19962592202828420) ──────
# ripgrep's `-r` is `--replace <REPLACEMENT>` and TAKES AN ARGUMENT, so it
# consumes the REST of a clustered short-flag group as that replacement text:
# `rg -rn 'X'` parses as `-r n` (replacement "n"), not `-r` + `-n`. Every
# match is silently rewritten to the replacement with NO warning, exit code,
# or marker — the output is well-formed, plausible source (real paths, real
# surrounding syntax), so the natural reading is "this codebase has
# minified/mangled identifiers": a confident, specific, WRONG finding about
# someone else's code. ripgrep is recursive BY DEFAULT (needs no `-r` at all),
# so the grep muscle-memory that produces `-rn`/`-rl`/`-ri` is exactly the
# habit most likely to fire. SOFT by design: the suspect-letter set below is a
# heuristic (a genuine one-letter replacement string is vanishingly rare next
# to a mistyped flag), so this only ever advises, never denies.
try:
    _RG_INVOKE_RE = re.compile(r'(?:^|[;&|\n(])\s*(?:[\w./-]*/)?rg\b([^;&|\n)]*)')
    _RG_CLUSTER_RE = re.compile(r'(?:^|\s)(-[A-Za-z]*r[A-Za-z]{1,2})(?=\s|$)')
    _RG_SUSPECT_LETTERS = frozenset('nlivwcxos')
    if not ADVISORY:
        for _rgm in _RG_INVOKE_RE.finditer(_scannable()):
            _rg_hit = None
            for _fm in _RG_CLUSTER_RE.finditer(_rgm.group(1)):
                _rg_flag = _fm.group(1)
                _rg_suffix = re.search(r'r([A-Za-z]{1,2})$', _rg_flag).group(1)
                if all(c in _RG_SUSPECT_LETTERS for c in _rg_suffix):
                    _rg_hit = (_rg_flag, _rg_suffix)
                    break
            if _rg_hit:
                _rg_flag, _rg_suffix = _rg_hit
                ADVISORY = (
                    "rg `-r`-consumes-cluster advisory (EI-19962592202828420): `%s` "
                    "parses as `-r %s` — ripgrep's `-r`/`--replace` TAKES AN ARGUMENT "
                    "and swallows the rest of the flag cluster as that REPLACEMENT "
                    "text, silently rewriting every match to `%s` with no warning, "
                    "exit code, or marker (the output still reads like real, if "
                    "oddly mangled, source). ripgrep is recursive by default and "
                    "needs no `-r` at all — for grep-style flags, drop the `-r` "
                    "(e.g. plain `-n` for line numbers). If the replacement was "
                    "genuinely intended, this is a false alarm. Advisory only; "
                    "this command is proceeding as issued."
                    % (_rg_flag, _rg_suffix, _rg_suffix)
                )
except Exception:
    pass  # advisory must never wedge a command

# ── Background `;`-chain TRAILING-REPORTER exit-code advisory (WI-6944) ────
# The other half of the trap above. That guard matches only a PIPE (`cmd |
# tee`); this one matches the `;`-chain, where the masking stage is a separate
# trailing command rather than a pipeline stage:
#
#     cmd > /tmp/out.txt 2>&1; echo "===EXIT:$?==="
#
# A `;`-chain exits with its LAST command's status, so the trailing `echo`
# (which always succeeds) replaces cmd's status and the notification reports
# "completed (exit code 0)" for a run that FAILED.
#
# The irony that makes this worth its own detector: the trailing command is
# almost always an EXIT MARKER the caller added precisely so the log would
# carry a trustworthy verdict. The diagnostic you reach for when you care most
# about the answer is exactly what erases the failure from the notification.
# Proven end-to-end 2026-08-02 (job bnmntj9o4): `sleep 2; false; echo
# "===PROOF_EXIT:$?==="` -> artifact `===PROOF_EXIT:1===`, notification
# "completed (exit code 0)". Three real `lint:tsc` runs the same night all
# ended `===TSC_EXIT:1===` with "1 NEW file(s) have type errors" under a
# reported exit 0, and were nearly accepted as a green gate check.
#
# Deliberately NOT escaped by a bare `EXIT=$?` capture, unlike the pipe guard
# above: capturing the code into the LOG makes the artifact honest but does
# nothing for the NOTIFICATION, and here that very echo is the masking cause.
#
# Three things ARE excluded, each because the author has already shown they
# know about exit codes — advising them is noise, and the pipe guard's suite
# already encodes the first two as deliberate non-targets:
#   * `&&` — short-circuits, so a failure propagates; not a hazard at all.
#   * `||` — writing a failure branch (`npm test || echo failed`) IS awareness
#     of the failure path. It does mask, but it masks a case the author chose.
#   * `pipefail` / `PIPESTATUS` — an explicit exit-status-preservation idiom.
# The target is the UNAWARE case: a plain `;` chain ending in a reporter.
#
# EI-18861104217890085: the reporter list used to be echo/printf/ls/date/stat/
# true/pwd/wc/cat/tee only — missing tail/head/grep/sed/awk/… entirely, even
# though the PIPE guard above already treats every one of those as a masking
# stage. That gap let the EXACT idiom the pipe guard's own docstring
# recommends as the safe alternative ("redirect to a log file … and read that
# instead: `cmd > /tmp/x.log 2>&1; head -N /tmp/x.log`") walk straight through
# this guard unadvised: `npm run test:affected > /tmp/x.log 2>&1; echo
# "EXIT=$?"; tail -25 /tmp/x.log` ends in `tail`, not `echo`, so the old list
# never matched it — a real FAILED affected-sweep was reported "completed
# (exit code 0)" (hit live 2026-07-28 verifying WI-6522). Aligned to the same
# reporter set the pipe guard already uses, so a caller can't route around
# this guard just by adding one more `;`-segment before the trailing reader.
try:
    if (tool_name.lower() == 'bash'
            and tool_input.get('run_in_background')
            and not ADVISORY
            and not re.search(r'pipefail|PIPESTATUS', command)):
        _tr_cmd = _strip_quotes_and_comments(command)
        # Already correct? Check RAW too — the fix is usually quoted.
        _EXIT_RESTORE_RE = re.compile(
            r'\bexit\s+"?\$\{?(?:rc|RC|status|code|\?)\}?"?\s*$')
        if not (_EXIT_RESTORE_RE.search(_tr_cmd.strip())
                or _EXIT_RESTORE_RE.search(command.strip())):
            _tr_segs = [s.strip() for s in re.split(r';|\n', _tr_cmd)
                        if s.strip()]
            # Only a MULTI-command line can mask: a lone `echo` masks nothing.
            if len(_tr_segs) >= 2 and re.match(
                    r'^(?:\S*/)?(?:echo|printf|ls|date|stat|true|pwd|wc|cat|tee'
                    r'|tail|head|grep|egrep|fgrep|sed|awk|sort|uniq|cut|tr'
                    r'|jq|column|xargs|tac|nl|less|more)\b',
                    _tr_segs[-1]):
                ADVISORY = (
                    'background `;`-chain exit-code advisory (WI-6944): this '
                    'backgrounded command ENDS in `'
                    + _tr_segs[-1].split()[0]
                    + '`, and a `;`-chain exits with its LAST command\'s status '
                    '— so the completion notification will report THAT (almost '
                    'always 0), not your real command\'s, and a FAILED run reads '
                    'as "completed (exit code 0)". If the trailing command is an '
                    'exit marker, note the irony: it is the very thing erasing '
                    'the failure. Fix by restoring the code on the way out — '
                    '`cmd > /tmp/out 2>&1; rc=$?; echo "===EXIT:$rc===" >> '
                    '/tmp/out; exit "$rc"` — which makes BOTH the log and the '
                    'notification truthful. Otherwise read the VERDICT from the '
                    'artifact\'s content and never from the notification\'s exit '
                    'code. Advisory only; this command is proceeding as issued.'
                )
except Exception:
    pass  # advisory must never wedge a command

# ── DOUBLE-BACKGROUNDING false-completion advisory (EI-19408257709127659) ──
# The third member of the family above, and the most misleading of the three.
# The two guards above catch a notification carrying the WRONG EXIT CODE for a
# job that really did finish. This one catches a notification that fires while
# the job is STILL RUNNING — the completion itself is false, not just its code.
#
#     Bash { run_in_background: true, command: 'nohup npm run test:affected > log 2>&1 &' }
#
# `run_in_background: true` ALREADY backgrounds the whole command. A manual
# trailing `&` (or `nohup … &` / `setsid`) forks a SECOND, untracked layer:
# the wrapper shell the tool is tracking returns the instant it forks, so the
# harness reports `status:"completed"`, exit code 0 — while `ps` and the log
# show the real job just getting started. The leaf's true exit code is then
# never reported at all, and the natural next move is to act on a "finished"
# run that has not finished.
#
# Filed live 2026-08-03 (EI-19408257709127659): a backgrounded
# `nohup npm run test:affected > log 2>&1 &` reported completed/0 while the
# operator-core suite was still spinning up at load1=103. The trap was already
# documented for `capability:bash`; this confirms it applies identically to
# the native `Bash` tool's own `run_in_background`, and prose in a doc did not
# stop it — hence a detector at the call site.
#
# `wait` is an escape: a caller that reaps the child has kept the wrapper alive
# on purpose, so the tracked process really does outlive the job. Bare `nohup`
# with NO `&` is deliberately not a target — it does not fork, so nothing is
# double-backgrounded; `setsid` IS, because it detaches on its own.
try:
    if (tool_name.lower() == 'bash'
            and tool_input.get('run_in_background')
            and not ADVISORY):
        _bg_cmd = _strip_quotes_and_comments(command)
        # Erase the redirections that legitimately contain `&` (`2>&1`, `>&2`,
        # `&>log`, `&>>log`) before looking for a real backgrounding `&`.
        _bg_scrub = re.sub(r'\d*>>?&\d*|&>>?', ' ', _bg_cmd)
        _bg_amp = re.search(r'(?<![&>])&(?!&)', _bg_scrub)
        _bg_setsid = re.search(r'(?:^|[;&|(\n])\s*(?:\S*/)?setsid\b', _bg_cmd)
        if (_bg_amp or _bg_setsid) and not re.search(r'\bwait\b', _bg_cmd):
            if _bg_setsid and not _bg_amp:
                _bg_what = '`setsid`, which detaches on its own,'
            elif re.search(r'(?:^|[;&|(\n])\s*(?:\S*/)?nohup\b', _bg_cmd):
                _bg_what = 'a manual `nohup … &`'
            else:
                _bg_what = 'a manual trailing `&`'
            ADVISORY = (
                'double-background advisory (EI-19408257709127659): this '
                'command already runs with `run_in_background: true`, and it '
                'ALSO contains ' + _bg_what + ' — so it forks a second, '
                'UNTRACKED layer. The wrapper the tool tracks returns the '
                'instant it forks, so you will get a `status:"completed"` '
                'notification (exit code 0) while the real job is still '
                'running, and the leaf\'s true exit code is never reported at '
                'all. This is a FALSE COMPLETION, not just a wrong exit code. '
                'Drop the `&`/`nohup`/`setsid` and pass the plain '
                'foreground-shaped command (`npm run test:affected > '
                '/tmp/x.log 2>&1`) — the tool does the backgrounding, tracks '
                'the real process, and reports its actual exit. If you must '
                'keep the extra fork, verify liveness against the leaf pid '
                '(`kill -0 <pid>`, or `tail --pid=<pid> -f /dev/null`) and '
                'read the verdict from the log, never from the notification. '
                'Advisory only; this command is proceeding as issued.'
            )
except Exception:
    pass  # advisory must never wedge a command

# ── grep/rg → `| head` false-absence advisory (EI-20041520588565350) ───────
# A recursive grep followed by `head` is especially dangerous when the caller
# is checking whether a symbol has any importers. `head` limits the FIRST N
# matching lines, while grep walks files in filesystem order; a real importer
# can therefore sit after the slice and the output reads as a complete search.
# This is a different claim from the SIGPIPE hazard below: even when the
# upstream survives, a truncated match list cannot prove absence.
#
# Keep this narrow and advisory-only. A grep/rg invocation that explicitly asks
# for one result per file (`-l`), a count (`-c`), or a quiet boolean (`-q`) has
# declared a different intent and is outside this warning. Non-literal or
# wrapper-heavy shapes are left alone rather than guessed at.
try:
    if not ADVISORY:
        _grep_head_cmd = _strip_quotes_and_comments(command)
        _GREP_HEAD_NAMES = frozenset(('grep', 'egrep', 'fgrep', 'rg'))
        _GREP_HEAD_SAFE_LONG = frozenset((
            '--files-with-matches', '--count', '--quiet', '--silent',
        ))
        # These consume the next token when written separately. Do not read a
        # pattern such as `-q` after `grep -e` as the quiet flag itself.
        _GREP_HEAD_VALUE_SHORT = frozenset(('e', 'f', 'm', 'A', 'B', 'C', 'D'))
        _GREP_HEAD_VALUE_LONG = frozenset((
            '--regexp', '--file', '--max-count', '--after-context',
            '--before-context', '--context', '--include', '--exclude',
            '--exclude-dir', '--glob', '--type', '--type-not', '--max-depth',
        ))

        def _grep_head_has_safe_flag(args):
            _skip_next = False
            for _arg in args:
                if _skip_next:
                    _skip_next = False
                    continue
                if _arg == '--':
                    break
                if _arg.startswith('--'):
                    _long = _arg.split('=', 1)[0]
                    if _long in _GREP_HEAD_SAFE_LONG:
                        return True
                    if '=' not in _arg and _long in _GREP_HEAD_VALUE_LONG:
                        _skip_next = True
                    continue
                if not _arg.startswith('-') or _arg == '-':
                    continue
                _letters = _arg[1:]
                for _letter_index, _letter in enumerate(_letters):
                    if _letter in 'lcq':
                        return True
                    if _letter in _GREP_HEAD_VALUE_SHORT:
                        if _letter_index == len(_letters) - 1:
                            _skip_next = True
                        break
            return False

        for _grep_head_pipeline in _scan_pipelines(_grep_head_cmd):
            if len(_grep_head_pipeline) < 2:
                continue
            _head_cmds, _ = _scan_shell(_grep_head_pipeline[-1])
            if not _head_cmds:
                continue
            _head_words = _head_cmds[0]
            _head_start = _scan_command_start(_head_words)
            if _head_start >= len(_head_words):
                continue
            if _head_words[_head_start].rsplit('/', 1)[-1] != 'head':
                continue

            _has_unbounded_grep = False
            for _grep_head_stage in _grep_head_pipeline[:-1]:
                _grep_head_cmds, _ = _scan_shell(_grep_head_stage)
                if not _grep_head_cmds:
                    continue
                _grep_head_words = _grep_head_cmds[0]
                _grep_head_start = _scan_command_start(_grep_head_words)
                if _grep_head_start >= len(_grep_head_words):
                    continue
                _grep_head_name = _grep_head_words[_grep_head_start].rsplit('/', 1)[-1]
                if _grep_head_name not in _GREP_HEAD_NAMES:
                    continue
                if not _grep_head_has_safe_flag(_grep_head_words[_grep_head_start + 1:]):
                    _has_unbounded_grep = True
                    break

            if _has_unbounded_grep:
                ADVISORY = (
                    'grep-to-head false-absence advisory (EI-20041520588565350): '
                    'this pipeline ends in `head` after a grep/rg that does not '
                    'request files (`-l`), a count (`-c`), or a quiet boolean '
                    '(`-q`). `head` keeps only the first N matching lines, while '
                    'recursive search order is not a complete-file guarantee, so '
                    'a later importer can be hidden and the truncated output '
                    'cannot prove absence. For an existence check use `grep -rl` '
                    'or `rg -l`, count with `grep -c`/`wc -l`, or let the search '
                    'finish before drawing a negative conclusion. Advisory only; '
                    'this command is proceeding as issued.'
                )
                break
except Exception:
    pass  # advisory must never wedge a command

# ── Double-quoted grep/sed/awk $N pattern advisory (EI-22031870119269961) ──
# A double-quoted grep/egrep/fgrep/rg/sed/awk PATTERN argument containing an
# unescaped $N or ${N} is a LIVE shell expansion, not the literal digits the
# pattern almost certainly meant (`grep -n "...\$4::jsonb..."` losing its
# backslash between JSON authoring and bash execution is the reported case).
# Positional parameters are normally unset in this execution context, so the
# expansion silently collapses to "" and the search/substitution goes on to
# report a well-formed ZERO-MATCH that reads exactly like "the code was
# rewritten/absent" — a false negative from the INSTRUMENT, not from the
# search target (same family as the grep-to-head advisory above and the
# documented `pgrep -q` / `matched=0` false-absence traps).
#
# Advisory only, and deliberately narrow: fires only inside a genuine
# double-quoted span (single quotes are always literal and already safe) of
# a recognized search/substitute command, and only when the backslash-run
# immediately before the `$` is EVEN (0, 2, 4, …) — an ODD run means the
# LAST backslash escapes the `$`, which is the safe, already-correct form
# this advisory is teaching the caller to use.
try:
    if not ADVISORY:
        _dd_cmd_text = command
        _DD_NAMES = frozenset(('grep', 'egrep', 'fgrep', 'rg', 'sed', 'awk'))

        def _dd_raw_segments(text):
            # Same operator set as _scan_shell (;|&(){} + newline), but
            # returns the RAW substrings (quotes/backslashes intact) instead
            # of decoded words — _scan_shell's tokenizer decodes `\$` and a
            # bare `$` to the SAME output, which erases exactly the
            # escaped-vs-live distinction this advisory needs to keep.
            segs, i, n, start = [], 0, len(text), 0
            while i < n:
                c = text[i]
                if c == '\\' and i + 1 < n:
                    i += 2
                    continue
                if c == "'":
                    j = text.find("'", i + 1)
                    i = n if j == -1 else j + 1
                    continue
                if c == '"':
                    j = i + 1
                    while j < n:
                        if text[j] == '\\':
                            j += 2
                            continue
                        if text[j] == '"':
                            break
                        j += 1
                    i = j + 1
                    continue
                if c in ';|&(){}\n':
                    _seg = text[start:i]
                    if _seg.strip():
                        segs.append(_seg)
                    start = i + 1
                    i += 1
                    continue
                i += 1
            _tail = text[start:n]
            if _tail.strip():
                segs.append(_tail)
            return segs

        def _dd_quoted_spans(text):
            # Raw inner text of every top-level double-quoted span in `text`
            # (backslashes intact) — the body this advisory inspects for a
            # live $N. Single-quoted spans are skipped: they are always
            # literal in bash and can never be the hazard this covers.
            spans, i, n = [], 0, len(text)
            while i < n:
                c = text[i]
                if c == "'":
                    j = text.find("'", i + 1)
                    i = n if j == -1 else j + 1
                    continue
                if c == '"':
                    j = i + 1
                    start = j
                    while j < n:
                        if text[j] == '\\':
                            j += 2
                            continue
                        if text[j] == '"':
                            break
                        j += 1
                    spans.append(text[start:min(j, n)])
                    i = j + 1
                    continue
                i += 1
            return spans

        def _dd_has_live_dollar_digit(inner):
            i, n, bs = 0, len(inner), 0
            while i < n:
                c = inner[i]
                if c == '\\':
                    bs += 1
                    i += 1
                    continue
                if c == '$' and bs % 2 == 0:
                    j = i + 1
                    if j < n and inner[j] == '{':
                        k = j + 1
                        while k < n and inner[k].isdigit():
                            k += 1
                        if k > j + 1 and k < n and inner[k] == '}':
                            return True
                    elif j < n and inner[j].isdigit():
                        return True
                bs = 0
                i += 1
            return False

        _dd_hit = False
        for _dd_seg in _dd_raw_segments(_dd_cmd_text):
            _dd_cmds, _ = _scan_shell(_dd_seg)
            if not _dd_cmds:
                continue
            _dd_words = _dd_cmds[0]
            _dd_start = _scan_command_start(_dd_words)
            if _dd_start >= len(_dd_words):
                continue
            _dd_name = _dd_words[_dd_start].rsplit('/', 1)[-1]
            if _dd_name not in _DD_NAMES:
                continue
            if any(_dd_has_live_dollar_digit(_span) for _span in _dd_quoted_spans(_dd_seg)):
                _dd_hit = True
                break

        if _dd_hit:
            ADVISORY = (
                'double-quoted $N pattern advisory (EI-22031870119269961): '
                'a double-quoted grep/egrep/fgrep/rg/sed/awk argument in this '
                'command contains an unescaped $N or ${N} — a LIVE shell '
                'expansion, not the literal digits the pattern almost '
                'certainly meant. Positional parameters are usually unset '
                'here, so this silently collapses to an empty string and the '
                'search/substitution reports a well-formed ZERO-MATCH that '
                'reads exactly like "the code was rewritten/absent" (same '
                'false-negative family as the grep-to-head advisory and the '
                'documented `pgrep -q` / `matched=0` traps). Escape it as '
                '\\$N to keep the literal characters, or move the pattern '
                'into single quotes. Advisory only; this command is '
                'proceeding as issued.'
            )
except Exception:
    pass  # advisory must never wedge a command

# ── Foreground `| head` SIGPIPE-kill advisory (EI-18787618439028592) ───────
# `cmd | head -N` is a DIFFERENT hazard from the background-pipe exit-code
# trap above, and it applies in the FOREGROUND too (that advisory only fires
# when `run_in_background` is set): once `head` reads its N lines and exits,
# the upstream writer gets SIGPIPE and is KILLED mid-run — not a masked exit
# code, the command genuinely stops executing. The truncated output is
# byte-identical to a successful run's first N lines, so nothing in it
# signals the kill. `tail` is comparatively safe (it must consume all input
# to find the last N lines); `head` is the one that kills. Live incident: an
# agent piped a long-running live-DB schema-pull into `| head -3`, concluded
# the run had completed, and recorded a false "verified end-to-end" work-item
# completion for a run that had in fact written nothing — retracted a wake
# later only because a peer independently noticed the inconsistency.
#
# Backgrounded `| head` is already covered by the exit-code advisory above
# (which lists head alongside tail/grep/tee/…) and takes the one ADVISORY
# slot first, so this block only adds the FOREGROUND case — the gap the
# incident actually fell through. UNLIKE the exit-code advisory (Claude-only:
# `run_in_background` is a Claude Bash feature), SIGPIPE is a real OS signal
# that applies equally to Codex's exec_command/local_shell/shell — no
# tool_name restriction here (the tool_name in ('bash', 'exec_command',
# 'local_shell', 'shell') gate already ran at the top of the script). Skipped
# when the writer is already protected (`cat >/dev/null` anywhere after head
# keeps the pipe drained so the writer never sees SIGPIPE).
try:
    if not tool_input.get('run_in_background') and not ADVISORY:
        if 'cat >/dev/null' not in command and 'cat > /dev/null' not in command:
            _head_cmd = _strip_quotes_and_comments(command)
            _HEAD_PIPE_RE = re.compile(r'(?<!\|)\|(?!\|)\s*(?:\S*/)?head\b[^|;&\n]*$')
            for _pseg in re.split(r'&&|\|\||;|\n', _head_cmd):
                if _HEAD_PIPE_RE.search(_pseg.strip()):
                    ADVISORY = (
                        'foreground `| head` SIGPIPE-kill advisory (EI-18787618439028592): '
                        'once `head` reads its N lines and exits, the upstream command gets '
                        'SIGPIPE and is KILLED mid-run — this is a genuine kill, not just a '
                        'masked exit code (that trap is covered separately for backgrounded '
                        "pipes). The truncated output looks byte-identical to a successful "
                        "run's first N lines, so nothing in it signals the kill — easy to "
                        'wrongly conclude the run completed, especially for a side-effecting '
                        'command (writes/migrations/deploys) where that conclusion becomes a '
                        'false verification claim. `tail` is safe here (it consumes all '
                        'input); redirect to a log file and read that instead (`cmd > '
                        '/tmp/x.log 2>&1; head -N /tmp/x.log`), or protect the writer '
                        '(`cmd | { head -N; cat >/dev/null; }`) if you need the live pipe. '
                        'Advisory only; this command is proceeding as issued.'
                    )
                    break
except Exception:
    pass  # advisory must never wedge a command

# ── Foreground verification-pipe exit-code advisory (EI-21551186399462209) ─
# The background guard above originally treated the pipe trap as specific to
# completion notifications. It is not: a foreground shell still returns the
# LAST pipeline stage's status. Live repro: `cargo test ... 2>&1 | tail -25`
# returned 0 while cargo exited 101, and that false green was published before
# the upstream result was checked. Foreground is the higher-traffic path, so
# cover verification/build/test stages here as well.
#
# This block deliberately runs AFTER the two more specific foreground `head`
# guards. `grep/rg | head` should keep its false-absence explanation, and any
# other `cmd | head` should keep the SIGPIPE-kill explanation; both are sharper
# than the generic status-masking lesson. `not ADVISORY` preserves that order.
# Unlike the background path, this applies to every supported shell tool:
# pipeline exit semantics are real shell behaviour, not a Claude background
# notification feature.
try:
    if (not tool_input.get('run_in_background')
            and not ADVISORY
            and not re.search(r'pipefail|PIPESTATUS', command)):
        _fg_pipe_cmd = _scannable_quote_stripped()
        # Do not use `_scan_pipelines` here: its shell-operator scanner treats
        # the `&` in the ubiquitous stderr redirect `2>&1` as a command
        # separator. That drops the verification stage from
        # `cargo test 2>&1 | tail`, which is the exact live repro this guard
        # exists to catch. The established background matcher already splits
        # only on command-list separators; reuse that shape, then inspect the
        # text BEFORE the final filter pipe for verification intent.
        for _fg_segment in re.split(r'&&|\|\||;|\n', _fg_pipe_cmd):
            _fg_segment = _fg_segment.strip()
            _fg_filter = _PIPE_TAIL_RE.search(_fg_segment)
            if not _fg_filter:
                continue
            if not _PIPE_VERIFICATION_RE.search(
                    _fg_segment[:_fg_filter.start()]):
                continue
            ADVISORY = (
                'foreground verification-pipe exit-code advisory '
                '(EI-21551186399462209): this build/test/verification command '
                'pipes into an output filter, so the shell reports the FILTER\'s '
                'exit code rather than the upstream command\'s. A failed test or '
                'build can therefore return 0 and look green even though the '
                'output was read in the foreground. Add `set -o pipefail`, inspect '
                '`${PIPESTATUS[0]}`, or redirect the full output to a file and read '
                'it separately before treating the result as verified. Advisory '
                'only; this command is proceeding as issued.'
            )
            break
except Exception:
    pass  # advisory must never wedge a command

# ── Background-log-read-race advisory (EI-18764990059061608) ───────────────
# A backgrounded command's redirect-to-file output is, to a LATER `cat`/`head`/
# `wc`/etc. of that same file, indistinguishable between "the job finished and
# genuinely produced nothing" and "the job is still running and has not
# flushed/finished yet" — both read as an empty (or short, stale) file. Hit
# live 2026-07-27: an agent backgrounded a typecheck piped into a log file,
# read the file moments later while it was STILL BEING WRITTEN, saw "Bash
# completed with no output", and reported "typecheck clean" — five real type
# errors landed several tool calls later when the job actually finished. This
# is the READ-side sibling of the background-pipe exit-code advisory above
# (that one warns about a masked exit code on the WRITE side).
#
# Tracking is a tiny, best-effort, host-shared JSON file: every
# `run_in_background` command that redirects (`>`/`>>`/`| tee`) to a file
# records {path -> started_at, sid}; every subsequent command (this one
# included) that mentions a tracked path has that path checked against a live
# `/proc/*/fd` scan — if ANY process still holds it open, the job that writes
# it has not finished, so a read right now proves nothing. No writer left open
# ⇒ nothing to warn about (and the entry is dropped). Fail-open throughout:
# any parse/IO/proc error silently skips the advisory and never blocks the
# command — this is pure bookkeeping, not a safety gate.
_BG_TRACK_DIR = os.path.expanduser('~/.papercusp/tracking')
_BG_TRACK_FILE = os.path.join(_BG_TRACK_DIR, 'bg-output-tracking.json')
_BG_TRACK_LEGACY_FILE = os.path.expanduser('~/.papercusp/bg-output-tracking.json')
_BG_TRACK_MAX_AGE_SEC = 2 * 60 * 60  # prune anything older than 2h regardless of liveness
_BG_REDIRECT_RE = re.compile(r'(?<![<>&])\d*>{1,2}(?!&)\s*([^\s;&|)\n]+)')
_BG_TEE_RE = re.compile(r'\btee\b\s+(?:-a\s+)?([^\s;&|)\n]+)')
# Bash's combined stdout+stderr redirect `&> file` / `&>> file` is a WRITE too.
# _BG_REDIRECT_RE deliberately refuses a `>` preceded by `&` (so `2>&1` never
# yields a bogus target), which left `&>` unrecognised: a foreground
# `npm run lint:tsc &> /tmp/tsc.log` was then read as a READ of that tracked
# path and drew a false read-race advisory whenever ANY process on the host held
# it open (WI-2144525 — it red-pinned the green-checkpoint web leg).
_BG_AMP_REDIRECT_RE = re.compile(r'&>{1,2}\s*([^\s;&|)\n]+)')


def _bg_track_load():
    data = {}
    # EI-19363129598856926: merge the legacy root-level file once, then save into
    # the tracking namespace below. New-state wins when both exist. Command text
    # is deliberately discarded while loading too, so an old inline credential
    # can never be copied into the new ledger or echoed by the read-side advisory.
    for path in (_BG_TRACK_LEGACY_FILE, _BG_TRACK_FILE):
        try:
            with open(path) as fh:
                loaded = json.load(fh)
            if isinstance(loaded, dict):
                data.update(loaded)
        except Exception:
            pass
    for rec in data.values():
        if isinstance(rec, dict):
            rec.pop('cmd', None)
    return data


def _bg_track_save(data):
    try:
        os.makedirs(_BG_TRACK_DIR, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=_BG_TRACK_DIR)
        with os.fdopen(fd, 'w') as fh:
            json.dump(data, fh)
        os.replace(tmp, _BG_TRACK_FILE)
        # The root-level JSON both polluted config globs and may contain raw
        # command text from the pre-fix writer. Delete it only after the new
        # atomic replace succeeds; it is a bounded, reconstructible advisory
        # ledger, not user-authored state.
        try:
            os.unlink(_BG_TRACK_LEGACY_FILE)
        except FileNotFoundError:
            pass
    except Exception:
        pass  # tracking is advisory bookkeeping — never let it raise


def _bg_resolve(raw_path, cwd):
    p = raw_path.strip().strip('\'"')
    if not p or p.startswith('$') or '$(' in p or '`' in p or p.startswith('&'):
        return None  # can't safely resolve a substitution/fd-dup target
    if p in ('/dev/null', '/dev/stdout', '/dev/stderr'):
        return None
    if p.startswith('~/'):
        p = os.path.join(os.path.expanduser('~'), p[2:])
    if not os.path.isabs(p):
        p = os.path.join(cwd, p)
    return os.path.normpath(p)


def _bg_redirect_targets(cmd, cwd):
    out = set()
    for pattern in (_BG_REDIRECT_RE, _BG_AMP_REDIRECT_RE, _BG_TEE_RE):
        for m in pattern.finditer(cmd):
            r = _bg_resolve(m.group(1), cwd)
            if r:
                out.add(r)
    return out


def _bg_open_writer_pids(path):
    pids = []
    try:
        for pid_dir in os.listdir('/proc'):
            if not pid_dir.isdigit():
                continue
            fd_dir = '/proc/%s/fd' % pid_dir
            try:
                fd_names = os.listdir(fd_dir)
            except Exception:
                continue
            for fd_name in fd_names:
                try:
                    target = os.readlink(os.path.join(fd_dir, fd_name))
                except Exception:
                    continue
                if target == path:
                    pids.append(pid_dir)
                    break
    except Exception:
        pass
    return pids


try:
    _bg_cwd = os.path.realpath(payload.get('cwd') or os.getcwd())
    _bg_now = time.time()
    _bg_state = _bg_track_load()

    # Record side: this call backgrounds a command that redirects to a file.
    if tool_name.lower() == 'bash' and tool_input.get('run_in_background'):
        # WI-5936: stamp the OWNING SESSION on each record. The file is
        # host-shared and keyed by output path, so without this a reader can
        # tell that *a* background job is live but not WHOSE — and the
        # compaction seam's whole question is "are MY jobs about to die with
        # this process?". `_session_key()` resolves PAPERCUSP_SID first, which
        # is the same `identity.ownerId` the operator-side reader filters on.
        for _t in _bg_redirect_targets(command, _bg_cwd):
            _bg_state[_t] = {
                # DATA MINIMIZATION: liveness needs only output path + time +
                # owner. Persisting command text adds no evidence and can store
                # inline credentials verbatim (EI-19363129598856926).
                'started_at': _bg_now, 'sid': _session_key(),
            }

    # Bound growth regardless of whether anything below fires — age-based only;
    # liveness for a survivor is re-checked fresh on the next read-side pass.
    _bg_state = {
        k: v for k, v in _bg_state.items()
        if isinstance(v, dict) and (_bg_now - float(v.get('started_at', 0))) < _BG_TRACK_MAX_AGE_SEC
    }

    # Read side: does THIS command mention a tracked path? Deliberately a
    # substring match (not just cat/head/tail) so it also catches `wc -l`,
    # `grep`, `less`, `$(cat …)`, and so on — any way of looking at the file.
    if not ADVISORY:
        _bg_write_targets_this_call = _bg_redirect_targets(command, _bg_cwd)
        for _path, _rec in list(_bg_state.items()):
            if _path not in command:
                continue
            # Don't fire on the very call that is (re-)establishing the
            # redirect to this same path — that is a write, not a read.
            if _path in _bg_write_targets_this_call:
                continue
            _writers = _bg_open_writer_pids(_path)
            if _writers:
                _elapsed = int(_bg_now - float(_rec.get('started_at', _bg_now)))
                ADVISORY = (
                    'background-log-read-race advisory (EI-18764990059061608): `%s` is '
                    'still OPEN for writing by a running background job (pid %s, started '
                    '%ss ago) — an empty or short read right now is NOT evidence '
                    "the job finished cleanly (or at all); it may simply be mid-run and not "
                    "yet flushed. Wait for that job's own completion notification (or check "
                    '`ps -p %s`) before treating this read as a clean/green result. Advisory '
                    'only; this command is proceeding as issued.'
                    % (_path, _writers[0], _elapsed, _writers[0])
                )
                break
            # No writer left holding it open — the job that wrote it is done
            # (or was killed); nothing left to warn about, so stop tracking it.
            _bg_state.pop(_path, None)

    _bg_track_save(_bg_state)
except Exception:
    pass  # advisory (and its bookkeeping) must never wedge a command

# ── Native bg task dies on carry-respawn (WI-5936 / EI-16611) ──────────────
# Native `run_in_background` bookkeeping lives in the CLI CHILD PROCESS's own
# memory — nowhere papercusp persists. A carry-respawn
# (session:request-compaction), a cold-loop fire, or `claude --resume` starts a
# NEW process, so the job is SIGTERMed: the LOGICAL session continues while the
# job is silently dead, and a carry-note saying "read task <id>'s output" is a
# dead reference to the successor.
#
# This knowledge already existed — in the compaction strategy and an insights
# doc — and it recurred anyway (a leader backgrounded a 16-55min release-gate
# run, self-compacted ~30s later, and killed it). The reason is a READ/WRITE
# path mismatch: the doc sits on the read path, but the mistake is made on the
# WRITE path, at the instant `run_in_background: true` is typed, and nobody
# re-reads the compaction doc while launching a job. So the guard has to be
# HERE, at launch.
#
# Say-once per session (the ~2h seen-set TTL re-arms it), and last in the
# advisory chain: the command-shape-specific bg advisories above (masked pipe
# exit code, exit-code-masking reporter, log-read race) describe a WRONG RESULT
# from this specific command and outrank a general teaching block. The real
# backstop is the compaction seam itself, which reads the session-stamped
# ledger written above and names any still-live job at the moment of the cut.
#
# NARROWED to the jobs that can actually BE stranded, rather than every
# backgrounded command. Two conditions, both load-bearing:
#   (a) the command REDIRECTS to a file — that is exactly the set the ledger can
#       record and the compaction seam can later prove live via an open fd, so
#       launch-time advice and cut-time detection cover the same population
#       instead of drifting apart; and
#   (b) the command is a LONG-RUNNING shape (test/build/typecheck runner). The
#       documented failure is a 16-55min release-gate run, not `echo hello &`.
# Without (a)+(b) this fired on every session's first backgrounded command —
# measured: it broke 22 sibling gate tests that assert silence for short
# backgrounded commands, which is the suite correctly reporting that the
# advisory was too broad to be proportionate.
_NATIVE_BG_LONG_RE = re.compile(
    r'\b(?:(?:npx\s+|pnpm\s+|bunx\s+)?vitest'
    r'|(?:npx\s+)?tsc'
    r'|npm\s+(?:run\s+)?test(?::[\w-]+)?'
    r'|npm\s+run\s+(?:build|lint:tsc|lint)'
    r'|turbo\s+run\s+(?:test|build|typecheck)'
    r'|jest|playwright|cargo\s+(?:build|test)'
    r'|scripts/pc-heavy\.sh|affected-tests\.mjs)\b',
    re.I,
)
#
# Kill-switch mirrors the PC_HEAVY_ADMISSION=off convention already used in this
# file. Its purpose is TEST ISOLATION, not an escape hatch: a sibling suite whose
# subject is a DIFFERENT bg advisory asserts blanket silence, and without this it
# would have to weaken that assertion to "not THIS advisory" — trading away real
# strictness across ~12 tests to accommodate a newcomer. Switching this one off
# there keeps their assertions exactly as strict as they were.
try:
    if (tool_name.lower() == 'bash'
            and tool_input.get('run_in_background')
            and not ADVISORY
            and os.environ.get(
                'PAPERCUSP_NATIVE_BG_ADVISORY', 'on').strip().lower() not in ('off', '0', 'false', 'no')
            and _NATIVE_BG_LONG_RE.search(_strip_quotes_and_comments(command))
            and _bg_redirect_targets(_strip_quotes_and_comments(command), _bg_cwd)
            and _claim_advisory('native-bg-task-dies-on-respawn')):
        ADVISORY = (
            'native background task advisory (WI-5936 / EI-16611): this job runs in the '
            "CLI child process's own memory, which is NOT persisted by papercusp. A "
            'carry-respawn (session:request-compaction), a cold-loop fire, or `claude '
            '--resume` starts a NEW process and SIGTERMs it — the logical session '
            'continues while the job is silently dead, so a checkpoint/carry-note citing '
            'this task id becomes a dead reference for your successor. Fine for work that '
            'finishes inside THIS turn. If it must outlive the turn, use `capability:bash '
            '{ run_in_background: true }` (operator-owned and reattachable — checkpoint its '
            '`bash_id`, and re-verify it on the next wake: it is not restart-durable), or a '
            'systemd unit / `release:checkpoint-run` for anything that must survive an '
            'operator restart. Advisory only; this command is proceeding as issued.'
        )
        _record_delivery('native-bg-task-dies-on-respawn')
except Exception:
    pass  # a teaching advisory must never wedge a command

# EI-20235141119412683: `systemd-run` waits for the START JOB to finish unless
# `--no-block` is passed. Under the DEFAULT service type that job is complete as
# soon as the payload forks, so the client returns immediately — which is why
# nearly every systemd-run in this repo needs no flag at all. `Type=oneshot` is the
# exception: its start job is not complete until the payload EXITS, so the client
# stays attached for the unit's WHOLE runtime.
#
# Measured on this box before writing this guard: a 4s oneshot returned the client
# after 4s without `--no-block` and after 0s with it, while the same sleep under the
# default type returned after 0s EITHER WAY. So the cause is the TYPE, not
# systemd-run — a blanket "always pass --no-block" would be advice-shaped noise on
# the ~40 non-oneshot call sites here, which is why this is scoped to oneshot alone.
#
# Filed after a hand-rolled launch of a multi-hour gate (a `Type=oneshot` unit with
# TimeoutStartSec=14400) held its caller attached for the entire run. The unit is
# owned by the user manager and survives the client detaching, so the fix is one flag.
#
# ADVISORY, never a deny: blocking on a oneshot is a legitimate thing to WANT — it is
# how you run something confined and wait for its verdict. This can only say "if you
# meant to detach, here is the flag", so it suppresses on an explicit `--wait` too.
_SYSTEMD_ONESHOT_TYPE_RE = re.compile(
    r'(?:--property=|--property\s+|-p\s+)Type=oneshot\b', re.I)
_SYSTEMD_ONESHOT_DETACHED_RE = re.compile(r'--no-block\b|--wait\b', re.I)


def _systemd_run_own_options(cmd):
    """systemd-run's OWN option span, with quote CHARACTERS removed.

    The shared `_strip_quotes_and_comments` normalizer replaces a quoted span with
    a single space. That is correct for every flag-NAME scanner in this file, but it
    BLINDS a scanner that has to read a property VALUE: `--property="Type=oneshot"`
    arrives as `--property=` and can never match. So drop the quote characters and
    keep the content, then cut `#`-to-end-of-line — after unquoting, every `#` reads
    as a comment, so this can only over-strip, which is the safe direction for an
    advisory that must never fire spuriously.
    """
    c = re.sub(r'[\'"]', '', cmd)
    c = re.sub(r'(?m)(?:^|\s)#.*$', ' ', c)
    marker = re.search(r'\bsystemd-run\b', c)
    if not marker:
        return None
    # `--` terminates systemd-run's own options; a payload argument is not ours.
    return re.split(r'\s+--(?:\s|$)', c[marker.end():], maxsplit=1)[0]


def _is_blocking_oneshot_systemd_run(cmd):
    """True when a systemd-run creates a `Type=oneshot` transient that will hold the
    caller for the unit's entire runtime because `--no-block` is absent."""
    options = _systemd_run_own_options(cmd)
    if options is None or not _SYSTEMD_ONESHOT_TYPE_RE.search(options):
        return False
    return not _SYSTEMD_ONESHOT_DETACHED_RE.search(options)


try:
    # Deliberately NOT gated on `tool_name == 'bash'`. Execution only reaches here
    # after the `_is_shell_tool` early-allow above, so the tool is already a shell —
    # and narrowing to Claude's spelling would exempt codex's (exec_command /
    # local_shell / shell) and `mcp__…__capability_bash`, which is the SAME shell
    # reached over MCP. That is the spelling-shaped hole EI-21971958067151594 closed
    # for every deny in this file, and it would bite hardest here: CLAUDE.md routes
    # agents onto `capability:bash` for exactly the long-running launches this warns about.
    if (not ADVISORY
            and os.environ.get(
                'PAPERCUSP_SYSTEMD_ONESHOT_ADVISORY', 'on').strip().lower() not in ('off', '0', 'false', 'no')
            and _is_blocking_oneshot_systemd_run(command)
            and _claim_advisory('systemd-run-oneshot-blocks-without-no-block')):
        ADVISORY = (
            'systemd-run oneshot advisory (EI-20235141119412683): this creates a '
            '`Type=oneshot` transient unit WITHOUT `--no-block`, so systemd-run waits for '
            "the start job — and a oneshot's start job is not complete until your payload "
            'EXITS. The client therefore stays attached for the unit\'s whole runtime '
            '(measured: a 4s oneshot returned the client after 4s; with `--no-block`, 0s; '
            'the same sleep under the default service type returned after 0s either way). '
            'That is correct when you MEANT to wait. If you meant to launch and detach — a '
            'multi-hour gate, a long suite — add `--no-block`: systemd owns the unit, so it '
            'keeps running and you get your turn back immediately. Follow it with '
            '`systemctl --user status <unit>` / `journalctl --user -u <unit>` rather than by '
            'staying attached. Advisory only; this command is proceeding as issued.'
        )
        _record_delivery('systemd-run-oneshot-blocks-without-no-block')
except Exception:
    pass  # a teaching advisory must never wedge a command

# EI-21924747520941481: `systemd-run` is also the cgroup-isolation mechanism
# used by the execution guards. Only its timer-backed forms create a persistent
# OS schedule; transient services/scopes, `--pipe --wait`, and resource-control
# properties must remain available. The OMP hook mirrors this classification.
_SYSTEMD_SCHEDULE_FLAG_RE = (
    r'--on-(?:calendar|active|boot|startup|unit-active|unit-inactive)\b'
    r'|--timer-property\b'
)


def _is_systemd_schedule_invocation(cmd):
    """True only when a systemd-run command requests a persistent timer."""
    c = _strip_quotes_and_comments(cmd)
    marker = re.search(r'\bsystemd-run\b', c)
    if not marker:
        return False
    # `--` terminates systemd-run's own options; a payload argument named
    # `--on-calendar` is not a timer request.
    options = re.split(r'\s+--(?:\s|$)', c[marker.end():], maxsplit=1)[0]
    return bool(re.search(_SYSTEMD_SCHEDULE_FLAG_RE, options, re.I))


def _os_scheduler_deny_reason(cmd):
    return (
        'native-scheduler lockout: agent sessions must not create OS schedules '
        '(crontab / at / batch / systemd-run). Declare your wake via '
        'pot:declare-wake instead — the routines table is the only scheduler '
        "the hive's pause/status/liveness machinery can see. "
        '(Read-only listings are NOT blocked — `crontab -l`, `atq` / `at -l` and '
        '`systemctl list-timers` all pass. This refusal is specifically about '
        'CREATING or MODIFYING a schedule, so if you were only trying to VERIFY '
        'an existing entry, re-run the listing form on its own.)'
    )


# EI-18815668439722436 / WI-6147: this guard used to gate ONLY on
# PAPERCUSP_AGENT_SESSION=='1', with no backstop — unlike the two sibling
# guards in this same file (the destructive shared-tree git guard + the heavy-
# command admission control), which were hardened after EI-7872 established
# that the marker is silently ABSENT in some fleet-launched sessions (e.g. a
# `fleet:launch-on-plan` member whose spawn path never set it), leaving the
# ENTIRE guard inert — fail-OPEN — for exactly the sessions it must protect.
#
# The sibling guards' backstop (`_cmd_in_canonical_tree()`) does NOT fit here:
# it is cwd-scoped, but crontab/at/batch/systemd-run are not tied to a working
# directory at all — an agent session can run `crontab -e` from anywhere, so a
# cwd-keyed backstop would still miss it. This guard needs its own
# correctly-scoped secondary signal instead.
#
# PAPERCUSP_FLEET_SLUG is that signal: it is stamped into a fleet member's
# process env SERVER-SIDE (bootstrap-su.ts / operator-spawn.ts), independent
# of whichever client-side code path is responsible for (and can fail to set)
# PAPERCUSP_AGENT_SESSION — so a session that ends up fleet-slugged but
# marker-less is still caught. It never fires for the owner's own plain
# interactive terminal (D-003): that session is never launched with
# `--fleet=<slug>` and so never carries a fleet slug at all. (An owner who
# DOES deliberately launch into an existing fleet with `--fleet=<slug>`
# already inherits AUTO mode by default at launch — the platform already
# treats a fleet-slugged session as an automated/coordinated context, not a
# raw personal terminal, so gating on it here is consistent, not a new
# category of over-block.)
def _is_agent_or_fleet_session():
    if os.environ.get('PAPERCUSP_AGENT_SESSION') == '1':
        return True
    return bool((os.environ.get('PAPERCUSP_FLEET_SLUG') or '').strip())


# EI-19294800751120438: scan the QUOTE-STRIPPED scannable form — quoted spans stay
# deleted (EI-9937's `grep -E "at|batch"` exemption survives intact) while the
# EXECUTED payloads of `bash -c "crontab -e"` / `$(echo crontab) -e` are appended
# as their own lines and caught.
#
# ⚠ KNOWN, ACCEPTED LIMITATION (EI-19485881710808774, the 4th confirmed instance
# of the "keyed on the token, not the operation" pattern — see also
# EI-19483245448673321 for lint:no-unenrolled-spawn's cgroup-lifetime sibling
# case). This is a STATIC TEXT scan of the literal Bash command string. It has
# no way to see that a `node script.mjs` / `python3 script.py` this command
# launches will, at RUNTIME, call `spawn('systemd-run', …)` / `subprocess.run([
# 'systemd-run', …])` internally — the token never appears at a shell
# command-boundary position in the Bash string this hook actually scans, so it
# is invisible here by construction, not by a fixable regex gap. Widening the
# match to catch the token anywhere (e.g. inside a quoted arg string) was
# deliberately rejected: quote-stripping exists BECAUSE unstripped scanning
# false-positived on legitimate uses of these words as plain data (EI-10444's
# SQL column named `at`, EI-19409663266787780's Python variable named `batch`)
# — a scanner cannot distinguish "this text names a process to spawn" from
# "this text is a string literal" without parsing the embedded language's
# semantics, which is out of scope for a shell-level PreToolUse hook. Do NOT
# read a green run of this guard as "no systemd-run/crontab/at/batch call is
# possible from this session" — it only means none was spelled out literally
# in Bash syntax. A real boundary (if ever required) has to live at a lower
# layer (systemd/kernel privilege separation on the invoking uid/cgroup), not
# here. This guard remains valuable as a deterrent for the common, naive case
# and is kept for that reason — it is not, and was never meant to be, a hard
# security boundary against a determined bypass.
#
# THE HEREDOC SHAPE, in the same accepted-limitation family (EI-20437163620658780).
# `\n` is a command-position separator, so a heredoc BODY is scanned as if each of
# its lines were a command — and `cat <<EOF … crontab -e … EOF` DENIES even though
# writing text that mentions a crontab line creates no schedule. That false positive
# is REAL and is accepted, because the obvious fix is unsafe: blanking heredoc bodies
# the way quoted spans are blanked would open a working bypass, since a heredoc body
# is only data when the RECEIVING command treats it as data — `cat <<EOF` writes
# text, but `bash <<EOF` / `sh <<EOF` / `<<EOF | bash` EXECUTE every line of it, and
# the same stroke would weaken the destructive-git and systemctl-exit guards that
# share this scanner. Classifying it correctly means knowing the receiving command,
# i.e. the shell parsing this file deliberately declines to do (see above). The only
# safe direction, if ever revisited, is a fail-CLOSED whitelist: blank the body only
# for known non-executing consumers (`cat`, `tee`, a plain file redirect), deny
# otherwise. Practical workaround: write the file with the Write/Edit tool instead
# of a heredoc, which the shell-write guard steers you to anyway.
#
# EI-20419484186942049: the lockout's job is to stop an agent CREATING an OS
# schedule the hive's pause/status/liveness machinery cannot see. A pure
# LISTING creates nothing. `crontab -l` is the natural way to VERIFY an
# existing entry — exactly what an agent auditing a scheduled routine needs —
# and denying it bought no safety while teaching agents to route AROUND the
# rail: observed live, the reporter dropped the crontab read entirely and
# verified a reconciler indirectly via journal output, leaving the direct
# probe unused. A guard that blocks reads is the one a session learns to
# distrust. So classify the invocation and exempt the read-only forms.
#
# This is an ALLOWLIST, deliberately: an invocation is exempt only when its
# ENTIRE argument list is recognised as a listing, so any unrecognised shape —
# including a mutating flag some future crontab adds — still denies. The guard
# fails CLOSED. Still denied: `crontab -e`, `crontab -r`, `crontab <file>`,
# `crontab -` (stdin install), bare `crontab`, and `crontab -l -e`.
_CRONTAB_READONLY_ARGS_RE = re.compile(r'^crontab((?:\s+(?:-l|-u\s+\S+))*)\s*$')

# EI-21934170410740770: the allowlist above is $-ANCHORED, so ANY shell
# REDIRECTION token defeated it. `crontab -l 2>&1 | head` denied while bare
# `crontab -l` passed — and the refusal text promised, in the same breath,
# that listings pass. An agent that follows the advertised remedy ("re-run
# the listing form on its own") gets refused a SECOND time, which is the
# worst shape a rail can have: it teaches that the message cannot be
# trusted. Pipes were never the problem — `_os_scheduler_violation` already
# ends a segment at `|`, and `crontab -l | grep x` has always passed.
#
# A redirection is DECORATION on the invocation, not an argument to it, so
# strip it before classifying — but strip it fail-CLOSED, because two
# redirection shapes really can create a schedule:
#   - INPUT redirection is NEVER stripped. `crontab < file` (and `<<`/`<<<`)
#     IS the stdin install vector, so a segment carrying one is never
#     classified read-only, whatever flags sit beside it.
#   - An OUTPUT target that is itself a schedule spool or drop-in is never
#     stripped: `crontab -l > /var/spool/cron/crontabs/bob` installs a
#     crontab FOR bob with no mutating flag anywhere in the command.
_SCHEDULER_INPUT_REDIR_RE = re.compile(r'(?:^|\s)\d*<')
_SCHEDULE_WRITE_TARGET_RE = re.compile(
    r'/etc/cron|/var/spool/cron|/etc/at\b|/var/spool/at'
    r'|/etc/systemd|/systemd/(?:user|system)\b'
)
# fd-duplication FIRST, so `2>&1` is not consumed as `2>` plus the filename
# `&1`. The final alternative matches a DANGLING operator at end-of-segment:
# `_os_scheduler_violation` splits on `[;&|\n]`, and the `&` inside `2>&1`
# is one of those — so the segment that actually reaches this predicate for
# `crontab -l 2>&1 | head` is the truncated `crontab -l 2>`.
_SCHEDULER_OUTPUT_REDIR_RE = re.compile(
    r'\s*(?:\d*>&\s*[-\d]+|&>>?\s*\S+|\d*>>?\s*\S+|\d*>>?&?\s*$)'
)


def _strip_output_redirections(s):
    """`s` with output redirections removed, or None when it carries a
    redirection that must NOT be waved through (see the note above)."""
    if _SCHEDULER_INPUT_REDIR_RE.search(s):
        return None
    vetoed = []

    def _drop(m):
        if _SCHEDULE_WRITE_TARGET_RE.search(m.group(0)):
            vetoed.append(m.group(0))
        return ' '

    stripped = _SCHEDULER_OUTPUT_REDIR_RE.sub(_drop, s)
    return None if vetoed else stripped.strip()


def _is_readonly_scheduler_invocation(seg):
    """True when `seg` only READS schedules — it creates/changes nothing."""
    s = re.sub(r'^sudo\s+', '', seg.strip()).strip()
    s = _strip_output_redirections(s)
    if s is None:
        return False
    if re.match(r'^systemd-run\b', s):
        # Transient service/scope/resource-control units are not schedules.
        return not _is_systemd_schedule_invocation(s)
    m = _CRONTAB_READONLY_ARGS_RE.match(s)
    if m:
        # `-l` must be PRESENT, not merely permitted by the arg shape: bare
        # `crontab -u bob` installs bob's crontab FROM STDIN, and the shape
        # alone would wave it through.
        return bool(re.search(r'(?:^|\s)-l(?=\s|$)', m.group(1)))
    # `at -l` is `atq` spelled differently — a queue listing. (`atq` never
    # matched at all: the `at` alternative below requires a time argument.)
    # Kept so BOTH hooks classify identically per the mirror-invariant above;
    # this hook's `at` pattern already excludes reads by construction.
    return bool(re.match(r'^at\s+-l\s*$', s))


# Group 1 is the invocation HEAD (the binary), so a match can be widened to the
# command segment it starts and classified read-vs-write.
_OS_SCHEDULER_CMD_RE = re.compile(
    r'(?:^|[;&|\n]\s*|\bsudo\s+)'
    r'((?:crontab|batch|systemd-run)\b'
    r'|at\s+(?:now|midnight|noon|teatime|\+?\d))'
)


def _os_scheduler_violation(scannable):
    """The first scheduler invocation that is NOT a pure read, else None."""
    for m in _OS_SCHEDULER_CMD_RE.finditer(scannable):
        seg = re.split(r'[;&|\n]', scannable[m.start(1):], maxsplit=1)[0]
        if not _is_readonly_scheduler_invocation(seg):
            return seg.strip()
    return None


if _is_agent_or_fleet_session() and _os_scheduler_violation(
        _scannable_quote_stripped()) is not None:
    deny(_os_scheduler_deny_reason(command))

# ── systemd user-manager exit/kill guard (EI-13135, 2026-07-17) ─────────────
# `systemctl --user exit` (or `start exit.target`) cleanly shuts down the
# WHOLE user@<uid> manager in one shot — bg-host, :3070, :3170, the inference
# gateway, git-sync, mcp-proxy, every timer/watchdog, AND every other live
# agent session's scope, all at once. Confirmed root cause of the 2026-07-16
# 23:00:47Z fleet-wide outage (EI-13135): the manager logged "Activating
# special unit exit.target", exited 0/SUCCESS at 23:01:09Z, and every service
# stayed dead for ~15min until an owner-authorized `sudo systemctl start
# user@1000.service` recovered it. `loginctl terminate-user`/`kill-user` and
# `systemctl stop|kill user@<uid>.service` are the SAME class (they too tear
# down every unit under that user in one shot) — same deny.
#
# UNCONDITIONAL — NOT gated on PAPERCUSP_AGENT_SESSION or the canonical-tree
# check the git-guard uses. EI-7872 already established the marker is
# silently unset in exactly the fleet-launched headless sessions this must
# protect, and unlike the git-guard the resource here isn't scoped to a
# particular working tree — it's the WHOLE HOST's service plane, host-wide
# regardless of cwd. This hook only mediates Claude/Codex Bash-tool calls, so
# an unconditional deny here never blocks the owner's own terminal — only a
# Bash-tool-mediated call, which has no legitimate reason to tear down the
# shared host's entire service plane.
_EXIT_GUARD_DENY = (
    'systemd user-manager exit/kill guard (EI-13135): `{op}` would tear down '
    'the ENTIRE shared user@<uid> service plane in one shot — bg-host, :3070, '
    ':3170, the inference gateway, git-sync, mcp-proxy, every timer/watchdog, '
    'and every OTHER live agent session\'s scope, all at once. This caused a '
    '~15min fleet-wide outage on 2026-07-16 (EI-13135). There is no '
    'legitimate agent reason to do this — if you mean to restart one specific '
    'papercusp service, use the blessed wrapper (dev:restart) instead.'
)
# EI-19294800751120438: iterate the SCANNABLE form, so a `bash -c "systemctl
# --user exit"` payload arrives as its own newline-separated segment here.
for _seg in re.split(r'[;&|\n]', _scannable()):
    _es = _strip_quotes_and_comments(_seg.strip())
    # Peel the same benign leading wrappers the git-guard peels (sudo/env/nice/
    # ionice/xargs/rtk/time/command/nohup/exec/setsid/…), defined fresh here so
    # this block never depends on the git-guard's conditionally-defined
    # `_unwrap` (which may not exist at all when that `if` didn't execute) —
    # this guard must fire independent of whether that branch ran.
    for _ in range(8):
        _next = re.sub(
            r'^\s*(?:'
            r'sudo(?:\s+(?:-[ugpUrCht]\s+\S+|-[A-Za-z]+|--[\w-]+(?:=\S*)?))*'
            r'|env(?:\s+[A-Za-z_]\w*=\S*)*'
            r'|nice(?:\s+-n\s*-?\d+)?'
            r'|ionice(?:\s+-\w+(?:\s+\d+)?)*'
            r'|xargs(?:\s+-\w+)*'
            r'|rtk|time|command|nohup|exec|setsid|nocorrect|stdbuf|doas|nocache'
            r')\s+',
            '', _es, count=1)
        if _next == _es:
            break
        _es = _next
    if re.match(r'systemctl\b(?:\s+--user)?\s+(?:start\s+exit\.target|exit)\b(?:\s|$)', _es):
        deny(_EXIT_GUARD_DENY.format(op='systemctl --user exit'))
    if re.match(r'systemctl\b(?:\s+--user)?\s+(?:halt|poweroff)\b(?:\s|$)', _es):
        deny(_EXIT_GUARD_DENY.format(op='systemctl --user halt/poweroff'))
    if re.match(r'loginctl\b\s+(?:terminate-user|kill-user)\b(?:\s|$)', _es):
        deny(_EXIT_GUARD_DENY.format(op='loginctl terminate-user/kill-user'))
    if re.match(r'systemctl\b\s+(?:stop|kill)\s+user@\d+\.service\b(?:\s|$)', _es):
        deny(_EXIT_GUARD_DENY.format(op='systemctl stop/kill user@<uid>.service'))

# ── pkill/killall host-wide dev-process guard (EI-18690252462401774) ───────
# `pkill -f <substring>` (and `killall <name>`) match by process cmdline/name
# SUBSTRING across the ENTIRE host process table — not scoped to the caller's
# own PID tree. Confirmed live: an agent cleaning up its OWN redundant
# backgrounded `npm run test:affected` job ran `pkill -f "test:affected"`,
# which matched and killed 5-6 OTHER agents' in-flight `test:affected` runs
# on this shared host at the same instant (2026-07-26) — each victim saw an
# unexplained process death, not an obvious self-inflicted footgun, so it
# cost every one of them a confused re-diagnosis instead of a one-line "oh,
# that was a pkill".
#
# UNCONDITIONAL — same rationale as the systemd exit-guard just above: the
# hazard is host-wide process-table scope, not tied to a particular working
# tree or an agent-session marker, and this hook only ever mediates Claude/
# Codex's own Bash-tool calls (never the owner's raw terminal), so firing
# unconditionally cannot over-block real interactive work.
#
# Curated dev/build/test substring list (same "best-effort common patterns"
# philosophy as the heavy-admission gate above) — this only fires when the
# pkill/killall argument plausibly names a shared command another agent on
# the box might be running right now, so a genuinely unique/caller-specific
# identifier is not blocked by this heuristic.
_PKILL_DEV_TOKEN_RE = re.compile(
    r'test:affected|test:file|test:all|\bvitest\b|\bjest\b|\bplaywright\b'
    r'|\bcargo\b|\brustc\b|npm\s+run|npm\s+test|npm\s+start|\btsc\b|ts-node'
    r'|\bpytest\b|turbo\s+run|next\s+dev|next\s+start|\bwebpack\b|\btauri\b'
    r'|\bnode\b|\bpython3?\b|\bgradle\b|\bmvn\b|\bmaven\b',
    re.IGNORECASE,
)
_PKILL_DENY = (
    'pkill/killall host-wide dev-process guard (EI-18690252462401774): `{op}` '
    'matches by SUBSTRING across the ENTIRE host process table — not scoped to '
    'your own PID tree. On this shared box this has already killed OTHER '
    "agents' in-flight test/build runs that happened to share the same command "
    'substring (5-6 peer `test:affected` runs died at once on 2026-07-26, each '
    'looking like an unrelated crash to its owner). Kill YOUR OWN process by its '
    'SPECIFIC PID instead: `kill <pid>` — the pid is printed when you '
    '`run_in_background`, or from `ps aux` filtered to a marker you can verify '
    'is really your own process (e.g. its /proc/<pid>/environ or full command '
    'line), never a bare pattern match. If you truly need pattern matching, '
    'scope it to your own process tree first (e.g. list children of $$ / your '
    'own shell PID) rather than a host-wide substring.'
)
# EI-19294800751120438: iterate the SCANNABLE form — `bash -c "pkill -f node"`
# and `eval "killall node"` were both ALLOWED while matching raw text.
for _seg in re.split(r'[;&|\n]', _scannable()):
    _pk = _seg.strip()
    for _ in range(8):
        _pk_next = re.sub(
            r'^\s*(?:'
            r'sudo(?:\s+(?:-[ugpUrCht]\s+\S+|-[A-Za-z]+|--[\w-]+(?:=\S*)?))*'
            r'|env(?:\s+[A-Za-z_]\w*=\S*)*'
            r'|nice(?:\s+-n\s*-?\d+)?'
            r'|ionice(?:\s+-\w+(?:\s+\d+)?)*'
            r'|xargs(?:\s+-\w+)*'
            r'|rtk|time|command|nohup|exec|setsid|nocorrect|stdbuf|doas|nocache'
            r')\s+',
            '', _pk, count=1)
        if _pk_next == _pk:
            break
        _pk = _pk_next
    _pk_m = re.match(r'(pkill|killall)\b(.*)$', _pk, re.IGNORECASE | re.DOTALL)
    if _pk_m and _PKILL_DEV_TOKEN_RE.search(_pk_m.group(2)):
        deny(_PKILL_DENY.format(op=_pk.strip()[:160]))

# ── ancestor-chain kill guard (WI-36926) ────────────────────────────────────
# On 2026-08-08 11:52:49 EDT an agent tearing down a Tauri rig walked its app's
# ancestor chain and SIGTERM'd every ancestor:
#
#   CHAIN="$APP"; P=$(ps -o ppid= -p "$APP"|tr -d ' ')
#   while [ -n "$P" ] && [ "$P" != "1" ]; do CHAIN="$CHAIN $P"; P=$(ps -o ppid= -p "$P"|tr -d ' '); done
#   for p in $CHAIN …; do kill "$p"; done
#
# The loop stops AT pid 1 — but `systemd --user` has PPID 1, so the chain
# INCLUDES the user systemd manager. A user manager that receives SIGTERM
# activates exit.target, i.e. it LOGS THE OWNER OUT. That is exactly what
# happened: the owner's GNOME session died 2 seconds later, and they lost their
# desktop plus every agent session on the box.
#
# The script's own comment read "stopping before systemd — exact pids only", so
# this is not carelessness; the author believed pid 1 WAS the systemd to stop
# before. The off-by-one-layer is invisible unless you already know that a user
# manager is an ordinary child of init. Worse, it is easy to hit by accident: a
# backgrounded agent job REPARENTS to `systemd --user`, so an ancestor walk
# starting from one reaches the user manager in a SINGLE hop.
#
# Deny requires all three signals together — walking parents, stopping at pid 1,
# and signalling — so an ordinary `kill "$pid"` or a read-only ancestor walk is
# untouched. This is a TEXTUAL heuristic and cannot evaluate "$CHAIN": the
# airtight floor is scripts/lib/session-floor.sh, which this message points at.
_ANCESTOR_KILL_DENY = (
    'ancestor-chain kill guard (WI-36926): this walks a parent chain, stops at '
    'pid 1, and then signals what it collected. `systemd --user` — the user '
    "systemd MANAGER — is an ordinary child of init, so a walk that stops AT "
    'pid 1 still INCLUDES it, and a SIGTERM to a user manager activates '
    'exit.target, which LOGS THE OWNER OUT of their desktop. This exact command '
    'shape did that on 2026-08-08 11:52:49 EDT and cost the owner their session '
    'plus every agent on the box. Note a backgrounded agent job reparents to '
    '`systemd --user`, so the walk can reach it in ONE hop. Fixes, best first: '
    '(1) do not walk ancestors at all — kill the recorded child pids you '
    'launched, or use processes:kill {{ taskId }}, which kills the cgroup '
    'subtree and cannot reach the session; (2) filter every candidate through '
    'the session floor before signalling: '
    '`scripts/session-floor.sh filter $CHAIN` (or source '
    'scripts/lib/session-floor.sh and call session_floor_is_protected), which '
    'refuses pid 1, the user manager, gnome-session-binary, gnome-shell and '
    'Xwayland; (3) stop the walk at the session boundary rather than at pid 1.'
)

_ak_src = _scannable()
_ak_walks = re.search(
    r'ps\s+(?:-\w+\s+)*-o\s+ppid=|awk\s*[\'"]?/\^PPid:/|/proc/\$\{?\w+\}?/status', _ak_src)
_ak_stops_at_1 = re.search(r'(?:!=|-ne)\s*["\']?1["\']?', _ak_src)
_ak_signals = re.search(
    r'(?:^|[;&|\n]\s*|\bdo\s+|\bthen\s+|`|\$\()\s*(?:sudo\s+)?kill\s+(?!-0\b)', _ak_src)
if _ak_walks and _ak_stops_at_1 and _ak_signals:
    deny(_ANCESTOR_KILL_DENY)

# ── process-table wait-loop self-match guard (EI-19312699396945642) ──────────
# `until ! pgrep -f '<pat>' …; do sleep …; done` can NEVER exit when run from
# an agent shell: `pgrep -f` matches the FULL command line, and the loop's own
# `bash -c` argv contains the literal pattern text, so the poll matches ITSELF
# and the condition is permanently true. Observed live 2026-08-02: a peer
# session looped 27 minutes (silently — no error, no output) "waiting" on a
# lint-tsc run that had long finished. Same self-match class as the pkill
# guard above, in wait-loop form. `ps … | grep <pat>` loop conditions share
# the defect — and there `grep -v grep` does NOT save you, because the
# `bash -c` wrapper's own cmdline still contains the pattern and is not named
# grep. UNCONDITIONAL for the same reason as the pkill guard: the hazard is
# the process-table scope of the poll, not any particular tree. Scoped to the
# loop CONDITION (the unexitable form). A one-shot `pgrep -f` still terminates,
# so it remains allowed, but its result is contaminated by the caller's own
# `bash -c` argv; the advisory immediately below teaches the safe read paths.
_PGREP_LOOP_DENY = (
    'process-table wait-loop self-match guard (EI-19312699396945642): this '
    'loop can NEVER exit — `{op}` matches the FULL command line, and your own '
    "shell's argv contains the literal pattern, so the poll matches ITSELF "
    'and the condition stays true forever (a peer burned 27 silent minutes '
    'exactly here on 2026-08-02). `grep -v grep` does not help: the `bash -c` '
    'wrapper still matches. Fixes, best first: (1) do not poll — launch the '
    'job with capability:bash {{ run_in_background: true }} and read it with '
    'capability:bash_output {{ bash_id, filter }}; (2) wait on the PID, not a '
    'pattern: `tail --pid=<pid> -f /dev/null`, or `kill -0 <pid>` in the '
    'loop; (3) if you MUST pattern-poll, bracket the first character so the '
    "pattern cannot match its own argv: pgrep -f '[l]int-tsc' (same trick as "
    "ps aux | grep '[f]oo')."
)

for _lp in re.finditer(
        r'(?:^|[;&\n])\s*(?:until|while)\s+(?:!\s*)?([^;\n]{1,300})',
        _scannable()):
    _cond = _lp.group(1)
    _pg = re.search(r'\bpgrep\s+((?:-{1,2}[\w-]+\s+)*)([^\s|>;]+)', _cond)
    if _pg and '[' not in _pg.group(2) and (
            '--full' in _pg.group(1) or _pgrep_short_flags_have_f(_pg.group(1))):
        deny(_PGREP_LOOP_DENY.format(op=('pgrep -f … in: ' + _cond.strip())[:160]))
    _psg = re.search(
        r'\bps\s[^|;\n]*\|\s*grep\s+((?:-{1,2}[\w-]+\s+)*)([^\s|>;]+)', _cond)
    if _psg and '[' not in _psg.group(2):
        deny(_PGREP_LOOP_DENY.format(op=('ps | grep … in: ' + _cond.strip())[:160]))

# ── false-absence search-path guard (EI-20580705812821502) ──────────────────
# `grep -rn 'X' some/wrong/path/` prints NOTHING. That is visually IDENTICAL
# to a search that ran correctly and found no matches, so the natural reading
# is "X DOES NOT EXIST" — a confident negative that then gets written into a
# durable surface (a plan's `## Now`, a work-item body) where the next reader
# inherits it as established fact. The exit code that distinguishes the two
# (grep: 1 = ran and found nothing, 2 = could not read the path) is discarded
# by the usual idioms — a pipe, `2>/dev/null`, `|| true`, or simply not being
# looked at.
#
# Measured TWICE in this repo, both surfacing 2026-08-16: plan
# `p2p-federation-work-item-classification-2026-07-26` sat BLOCKED FOR THREE
# WEEKS on the premise "no post-creation topic write-path was discoverable"
# (it is `work_items:tag`, implemented with its own test) — and the agent
# verifying that premise hit the identical trap the same day, running
# `ls .../agent-tools/work-items/ | grep -i tag` against the real directory
# `work_items/` (UNDERSCORE). It read the empty output as "the tool does not
# exist", which would have CONFIRMED the false premise it was falsifying.
#
# Same family as the pgrep guard above: the whole message is carried by a
# signal's ABSENCE, and the wrong reading is self-confirming.
#
# DETERMINISTIC, not heuristic — the verdict is an os.path stat of a LITERAL
# path operand, which is why this denies rather than advises. Every construct
# that makes the operand non-literal FAILS OPEN and is never checked: a
# variable or command substitution, a glob, a subshell, a `cd` whose target
# cannot be resolved, an unparseable quoting. It also refuses to judge
# anything but the FIRST real command (only `cd` may precede it), so a path
# a preceding `mkdir`/`git clone` was about to create is never mistaken for a
# missing one. The guard can therefore only fire on a path it actually
# measured as absent at the moment the command was issued.
_FA_DENY = (
    'false-absence search-path guard (EI-20580705812821502): `{cmd}` names a '
    'path that DOES NOT EXIST — `{path}`{resolved}. It would print NOTHING, '
    'which is visually IDENTICAL to a search that ran correctly and found no '
    'matches; the natural reading is "it does not exist", and that confident '
    'negative then gets written somewhere durable where the next reader '
    'inherits it as fact. Measured: a plan sat BLOCKED THREE WEEKS on exactly '
    'this, and the agent verifying it hit the same trap the same day '
    '(`work-items/` typed for the real `work_items/`). Fixes, best first: '
    '(1) prove the haystack exists first — `ls -d {path}`; (2) search from '
    'the repo root with no path filter; (3) for "where is this symbol '
    'defined", use `gitnexus.context {{ name }}`, which has no path argument '
    'to get wrong, and for "does this TOOL exist", `tools:find`. AND THE '
    'GENERAL RULE: AN ABSENCE CLAIM NEEDS A POSITIVE CONTROL — before '
    'reporting "X does not exist", run the same search for something you KNOW '
    'is in that haystack. If the control also comes back empty, the '
    'instrument is broken, not the subject.'
)

# ── the SYMLINK-TRAVERSAL shape of the same class (EI-20825101204716643) ────
# Filed as "find with an ABSOLUTE path silently returns zero in the sandbox";
# the absolute-vs-relative framing is a RED HERRING and the suspected sandbox
# interception does not exist. MEASURED: `command find` (the real findutils
# binary, every wrapper bypassed) reproduces it identically, and there is no
# sandbox boundary at all — /tmp, /etc and $HOME all enumerate fine.
#
# The real mechanism is plain POSIX: `find` defaults to -P, NEVER following
# symlinks. So a BARE symlink-to-a-directory operand is treated as a FILE —
# nothing is descended, no `-name` can match, and the command prints NOTHING,
# exits 0, and writes NOTHING to stderr. `cd <symlink> && find .` works only
# because `cd` resolves the link, which is what made this look positional.
#
# This is STRICTLY WORSE than the missing-path shape above, which at least
# errors on stderr and exits non-zero: here every channel reports success, so
# the empty result is indistinguishable from a correct "found nothing". The
# filer only caught it by running a positive control that ALSO came back empty.
#
# DETERMINISTIC, like its sibling: the verdict is an lstat of a LITERAL operand
# plus the absence of -H/-L/-follow. In that state find CANNOT descend — that
# is guaranteed by the grammar, not predicted. `-maxdepth 0` is exempt because
# it says outright that no descent was wanted.
_FA_SYMLINK_DENY = (
    'false-absence symlink-traversal guard (EI-20825101204716643): `{cmd}` '
    'names `{path}`, which is a SYMLINK TO A DIRECTORY (-> `{target}`). '
    '`find` defaults to -P and never follows symlinks, so a bare symlink '
    'operand is treated as a FILE: nothing is descended, no `-name` can match, '
    'and the command prints NOTHING, exits 0, and says nothing on stderr. That '
    'is strictly worse than a path that does not exist, which at least errors — '
    'every channel here reports success, so an empty result is '
    'INDISTINGUISHABLE from a correct "found nothing" and the natural reading '
    'is "it does not exist". Measured on this box: `find <symlink> -maxdepth 1 '
    '-name package.json` returned 0 lines while `ls` showed the file plainly '
    'there; a trailing slash, `-H`, `-L` and the resolved realpath each '
    'returned it. Fixes, best first: (1) add a TRAILING SLASH — `find {path}/ '
    '...`, which makes find traverse it; (2) pass `-L` (or `-H`) to follow the '
    'operand; (3) name the real target path instead. AND THE GENERAL RULE: AN '
    'ABSENCE CLAIM NEEDS A POSITIVE CONTROL — before reporting "X does not '
    'exist", run the same search for something you KNOW is in that haystack. '
    'If the control also comes back empty, the instrument is broken, not the '
    'subject.'
)

# ── invalid relative find timestamp guard (EI-21185971718818430) ────────────
# `find` is bfs 4.1.1 on this box. bfs rejects human-relative values such as
# `12 minutes ago` and `-10 minutes` for `-newermt`, while a common shell idiom
# suppresses stderr and lets an empty result look like a genuine absence. The
# same failure occurs for `-newerXY` forms whose Y operand is `t` (the date
# operand form, e.g. `-newermt`).
#
# This is deterministic and deliberately narrow: only a literal timestamp is
# judged, and only when it is the operand of a find/bfs command at command
# position. Variables and command substitutions fail open because the hook
# cannot know their expanded value without executing user code.
_FA_TIMESTAMP_DENY = (
    'invalid find timestamp guard (EI-21185971718818430): `{cmd}` passes '
    'the literal timestamp `{stamp}` to `{op}`. This box uses bfs 4.1.1, '
    'which rejects human-relative or non-ISO timestamp text; with stderr '
    'redirected, the failure can look like a real empty search result. Use '
    '`TZ=UTC stat -c "%y %n" <paths>` or `git status --porcelain` for '
    '"changed since" checks. If find is unavoidable, pass an ISO-8601-like '
    'date/time with `Z` or a numeric offset and keep stderr visible.'
)
_FA_ISO_TIMESTAMP_RE = re.compile(
    r'^\d{4}-\d{2}-\d{2}'
    r'(?:[T ]\d{2}:\d{2}(?::\d{2}(?:\.\d+)?)?'
    r'(?:\s?(?:Z|[+-]\d{2}:?\d{2}))?)?$'
)


def _fa_invalid_find_timestamp(argv):
    """Return (operator, literal) for a non-ISO `-newer?t` date operand."""
    for _i, _arg in enumerate(argv):
        _head, _eq, _inline = _arg.partition('=')
        _m = re.fullmatch(r'-newer([A-Za-z])([A-Za-z])', _head)
        if not _m or _m.group(2).lower() != 't':
            continue
        if _eq:
            _stamp = _inline
        elif _i + 1 < len(argv):
            _stamp = argv[_i + 1]
        else:
            continue
        if (not _stamp or any(c in _stamp for c in _FA_UNRESOLVABLE)
                or _FA_ISO_TIMESTAMP_RE.fullmatch(_stamp)):
            continue
        return _arg, _stamp
    return None

_FA_SEARCH_CMDS = frozenset(('grep', 'egrep', 'fgrep', 'rg', 'ls'))
# `find` joins this guard for the symlink shape ONLY. It is deliberately NOT in
# _FA_SEARCH_CMDS: its operand grammar is unrelated to grep's (paths come
# FIRST, before the expression), so it is parsed separately below. `bfs` is
# find's real argv0 here — the shell wraps `find` as a function that execs the
# claude binary as `bfs` — so an agent typing either reaches the same trap.
_FA_TRAVERSAL_CMDS = frozenset(('find', 'bfs'))
# Flags that CONSUME the following token, so it is neither the pattern nor a
# path. Getting this wrong is the only way the guard can misread an operand.
_FA_ARGFLAGS_GREP = frozenset((
    '-e', '-f', '-m', '-A', '-B', '-C', '-D', '-d', '--regexp', '--file',
    '--max-count', '--after-context', '--before-context', '--context',
    '--label', '--include', '--exclude', '--exclude-dir', '--exclude-from',
    '--binary-files', '--devices', '--directories', '--color', '--colour',
    '--group-separator', '--gnu-color',
))
_FA_ARGFLAGS_RG = _FA_ARGFLAGS_GREP | frozenset((
    '-g', '-t', '-T', '-M', '-E', '-j', '-r', '--glob', '--iglob',
    '--type', '--type-not', '--type-add', '--replace', '--max-depth',
    '--max-filesize', '--max-columns', '--sort', '--sortr', '--colors',
    '--pre', '--engine', '--encoding', '--threads', '--ignore-file',
    '--field-context-separator', '--context-separator', '--path-separator',
    '--dfa-size-limit', '--regex-size-limit', '--hostname-bin',
))
# `ls` needs its OWN table, not grep's. The overlap is not benign: `-d`, `-f`,
# `-m`, `-A`, `-B`, `-C` and `-D` all take an argument in grep and take NONE in
# ls, so borrowing grep's table makes `ls -A missing | grep x` parse the path
# as `-A`'s argument and the guard silently sees no path at all. Found by
# mutation probe — the `ls -d` exemption below LOOKED load-bearing while it
# was really this bug swallowing the operand.
_FA_ARGFLAGS_LS = frozenset((
    '-w', '-T', '-I', '--width', '--tabsize', '--ignore', '--hide',
    '--block-size', '--format', '--time-style', '--time', '--sort',
    '--indicator-style', '--quoting-style',
))
# `-e`/`-f` (and their long forms) supply the PATTERN out-of-band, so every
# positional operand after them is a PATH rather than the first being the
# pattern.
_FA_PATTERN_FLAGS = frozenset(('-e', '-f', '--regexp', '--file'))
_FA_SEPARATORS = frozenset(('&&', '||', ';', '|', '&', '\n'))
_FA_UNRESOLVABLE = '$`*?[]{}~'


def _fa_shell_tokens(text):
    """Tokenize *text* while retaining unquoted newlines as separators.

    ``shlex`` treats a raw newline as whitespace, so a command on the next
    line can be mistaken for a path operand of the preceding grep/ls. Split
    only shell-newline boundaries before handing each line to ``shlex``;
    quoted and backslash-continued newlines stay inside their original token.
    Comments are discarded here so a synthetic line boundary cannot make the
    rest of a command comment text.
    """
    _fa_lines, _fa_current = [], []
    _fa_quote = None
    _fa_escaped = False
    _fa_i = 0
    while _fa_i < len(text):
        _fa_c = text[_fa_i]
        if _fa_quote == "'":
            _fa_current.append(_fa_c)
            if _fa_c == "'":
                _fa_quote = None
            _fa_i += 1
            continue
        if _fa_quote == '"':
            _fa_current.append(_fa_c)
            if _fa_escaped:
                _fa_escaped = False
            elif _fa_c == '\\':
                _fa_escaped = True
            elif _fa_c == '"':
                _fa_quote = None
            _fa_i += 1
            continue
        if _fa_escaped:
            _fa_current.append(_fa_c)
            _fa_escaped = False
            _fa_i += 1
            continue
        if _fa_c == '\\':
            _fa_current.append(_fa_c)
            _fa_escaped = True
            _fa_i += 1
            continue
        if _fa_c in ("'", '"'):
            _fa_quote = _fa_c
            _fa_current.append(_fa_c)
            _fa_i += 1
            continue
        if _fa_c == '#' and (not _fa_current or _fa_current[-1].isspace()):
            _fa_i = text.find('\n', _fa_i)
            if _fa_i == -1:
                break
            _fa_lines.append(''.join(_fa_current))
            _fa_current = []
            _fa_i += 1
            continue
        if _fa_c == '\n':
            _fa_lines.append(''.join(_fa_current))
            _fa_current = []
            _fa_i += 1
            continue
        _fa_current.append(_fa_c)
        _fa_i += 1
    _fa_lines.append(''.join(_fa_current))

    _fa_tokens = []
    for _fa_i, _fa_line in enumerate(_fa_lines):
        _fa_lex = shlex.shlex(_fa_line, posix=True, punctuation_chars=True)
        _fa_lex.whitespace_split = True
        _fa_tokens.extend(list(_fa_lex))
        if _fa_i + 1 < len(_fa_lines):
            _fa_tokens.append('\n')
    return _fa_tokens


def _fa_operands(argv, argflags):
    """Positional operands of a grep/rg/ls argv, and whether -e/-f consumed the
    pattern. Returns None when a construct makes the parse untrustworthy."""
    operands, pattern_consumed, j = [], False, 1
    while j < len(argv):
        a = argv[j]
        if a == '--':
            # The -- token ends option parsing, not shell redirection parsing.
            # Keep collecting operands until a shell redirect token; otherwise
            # grep -- PATTERN PATH 2>/dev/null leaves the fd digit 2 looking
            # like another path to stat.
            for tail_token in argv[j + 1:]:
                if tail_token and all(c in '<>&' for c in tail_token):
                    if operands and operands[-1].isdigit():
                        operands.pop()
                    break
                operands.append(tail_token)
            break
        # A redirect ends the operand list; a bare fd digit belongs to it
        # (`grep -rn foo . 2>/dev/null` tokenizes the `2` as a word).
        if a and all(c in '<>&' for c in a):
            if operands and operands[-1].isdigit():
                operands.pop()
            break
        if a.startswith('--'):
            flag = a.split('=', 1)[0]
            if flag in _FA_PATTERN_FLAGS:
                pattern_consumed = True
            j += 2 if ('=' not in a and flag in argflags) else 1
            continue
        if a.startswith('-') and len(a) > 1:
            consumed_next = False
            letters = a[1:]
            for k, ch in enumerate(letters):
                sf = '-' + ch
                if sf in _FA_PATTERN_FLAGS:
                    pattern_consumed = True
                if sf in argflags:
                    # `-m5` carries its argument in the cluster; `-m 5` takes
                    # the next token.
                    consumed_next = (k + 1 == len(letters))
                    break
            j += 2 if consumed_next else 1
            continue
        operands.append(a)
        j += 1
    return operands, pattern_consumed


def _fa_find_paths(argv):
    """PATH operands of a `find` argv, and whether symlinks are followed.

    find's grammar is `find [-H|-L|-P] [path...] [expression]`, so the paths
    are exactly the operands BETWEEN the leading options and the first
    expression token. That is why find needs no argument-consuming flag table
    the way grep does: `-maxdepth 2` and friends live in the EXPRESSION, which
    begins at the first `-`/`(`/`!`/`,` — everything the parser must skip has
    already ended by then.
    """
    follows, j = False, 1
    while j < len(argv):
        a = argv[j]
        if a in ('-H', '-L'):
            follows = True   # the operand IS followed; the trap cannot apply
            j += 1
            continue
        if a == '-P':
            j += 1
            continue
        if a in ('-D', '-O'):       # `-D tree`, `-O 3` take a separate word
            j += 2
            continue
        if a.startswith('-O'):      # `-O3` carries it in the cluster
            j += 1
            continue
        break
    paths = []
    while j < len(argv):
        a = argv[j]
        # A redirect ends the operand list; a bare fd digit belongs to it
        # (`find /x 2>/dev/null` tokenizes the `2` as its own word).
        if a and all(c in '<>&' for c in a):
            if paths and paths[-1].isdigit():
                paths.pop()
            break
        if not a or a.startswith('-') or a in ('(', '!', ','):
            break
        paths.append(a)
        j += 1
    if '-follow' in argv[j:]:       # the deprecated expression spelling of -L
        follows = True
    return paths, follows


# ── unbounded symlink-following walk guard (WI-10000836) ─────────────────────
# The DUAL of the bare-find trap below. A `find -L` / `-follow` rooted at a
# broad directory on this box reaches ~50 checkouts whose node_modules/
# @papercusp/* entries symlink back into workspace packages, and bfs expands
# that symlink DAG without bound — it never finishes and never errors.
# Measured 2026-09-08: one `find -L ~/.papercusp -name …` ran 32h, reached
# 70 GB RSS + 1.86 TB swap (of a 2 TB swapfile), pegged kswapd and put the
# whole host at memory PSI-full 65% — the owner's desktop became unusable.
# Nothing else polices an agent-spawned child's memory, so the gate must
# refuse the shape at the call site. Deterministic and narrow: `-L`/`-follow`
# AND a broad root AND neither `-maxdepth` nor a `node_modules … -prune`.
_FA_LWALK_DENY = (
    'unbounded symlink-following walk guard (WI-10000836): `{cmd}` follows '
    'symlinks (`-L`/`-follow`) from `{root}` with no `-maxdepth` and no '
    '`-name node_modules -prune`. On this box that root reaches ~50 checkouts '
    'whose node_modules/@papercusp/* entries symlink back into workspace '
    'packages, and bfs expands that DAG without bound — measured 2026-09-08, '
    'one such `find -L ~/.papercusp` ran 32h, reached 70 GB RSS + 1.86 TB swap '
    'and thrashed the whole host. Use `git ls-files` / `grep -rl` (both follow '
    'symlinks correctly here), or bound the walk: `find -L <root> -maxdepth 6 '
    '-name node_modules -prune -o -name <x> -print`.'
)
# Roots (relative to $HOME, plus the two absolute ones) that reach the
# multi-checkout symlink DAG. A single checkout is NOT in this set — `-L`
# inside one repo is bounded enough to finish.
_FA_LWALK_BROAD_ROOTS = ('', '.papercusp', '.papercusp/hives', 'papercupai-workspace')
_FA_LWALK_UNRESOLVABLE = '$`*?[]{}'   # `~` is NOT here: it is expanded below


def _fa_lwalk_broad_root(p, cwd):
    """Return the resolved root when *p* (or *cwd* for a bare `find -L`) is broad."""
    if p is None:
        full = cwd
    else:
        if any(c in p for c in _FA_LWALK_UNRESOLVABLE) or len(p) > 400:
            return None
        p = os.path.expanduser(p)
        if not os.path.isabs(p):
            if cwd is None:
                return None
            p = os.path.join(cwd, p)
        full = os.path.realpath(p)
    if not full:
        return None
    if full in ('/', '/home'):
        return full
    home = os.path.realpath(os.path.expanduser('~'))
    for rel in _FA_LWALK_BROAD_ROOTS:
        if full == os.path.realpath(os.path.join(home, rel)):
            return full
    return None


def _fa_unbounded_symlink_walk(argv, paths, cwd):
    """Deny a symlink-following find/bfs over a broad root with no bound."""
    if '-maxdepth' in argv:
        return
    if '-prune' in argv and any('node_modules' in a for a in argv):
        return
    for p in (paths or [None]):
        root = _fa_lwalk_broad_root(p, cwd)
        if root is not None:
            deny(_FA_LWALK_DENY.format(cmd=' '.join(argv)[:160], root=root[:200]))


def _fa_symlink_traversal(argv, cwd):
    """Deny a `find` that cannot descend the directory it appears to search."""
    paths, follows = _fa_find_paths(argv)
    if follows:
        # Following symlinks is the remedy for the bare-find trap below, but
        # an UNBOUNDED follow from a broad root is its own (worse) trap.
        _fa_unbounded_symlink_walk(argv, paths, cwd)
        return
    for _k, _t in enumerate(argv):
        # `-maxdepth 0` asks for the operand ITSELF and nothing below it, so
        # not descending is the stated intent rather than the trap.
        if _t == '-maxdepth' and _k + 1 < len(argv) and argv[_k + 1] == '0':
            return
    for p in paths:
        # A TRAILING SLASH is the fix, not the bug: `lstat("link/")` resolves
        # through the link, so find traverses it. Skipping it here keeps the
        # guard from denying the very remedy it recommends.
        if (not p or p in ('-', '.', '..') or p.endswith('/')
                or len(p) > 400
                or any(c in p for c in _FA_UNRESOLVABLE)
                or (not os.path.isabs(p) and cwd is None)):
            continue
        full = p if os.path.isabs(p) else os.path.join(cwd, p)
        # islink is an LSTAT (the link itself); isdir is a STAT (its target).
        # Both together are exactly "a symlink that find will refuse to
        # descend". A symlink to a FILE is not this trap — nothing was going
        # to be descended — and a dangling one is the sibling guard's shape.
        if not (os.path.islink(full) and os.path.isdir(full)):
            continue
        deny(_FA_SYMLINK_DENY.format(
            cmd=' '.join(argv)[:160],
            path=p,
            target=os.path.realpath(full)[:200],
        ))


try:
    if re.search(
            r'(?:^|[\s;&|(])(?:[\w./-]*/)?(?:grep|egrep|fgrep|rg|ls|find|bfs)\b',
            command):
        import shlex
        # Keep raw shell newlines as command separators. The normal shlex
        # whitespace set erases them, which makes the next line's command
        # name look like another path operand of the first search command.
        _fa_tokens = _fa_shell_tokens(command)
        # A subshell reorders what `cd` applies to; refuse to guess.
        if '(' in _fa_tokens or ')' in _fa_tokens:
            _fa_tokens = []
        _fa_segments, _fa_cur = [], []
        for _t in _fa_tokens:
            if _t in _FA_SEPARATORS:
                _fa_segments.append((_fa_cur, _t))
                _fa_cur = []
            else:
                _fa_cur.append(_t)
        _fa_segments.append((_fa_cur, ''))

        # NOT `or os.getcwd()` — the usual idiom elsewhere in this file is
        # wrong HERE. os.getcwd() is the HOOK process's directory, which is
        # not the shell's: resolving `apps/operator` against it produced
        # `apps/operator/apps/operator` and denied nine everyday commands in
        # the suite. A relative operand is only resolvable when the host
        # states the cwd, so without one this guard checks ABSOLUTE paths
        # only and lets every relative one through (a host that omits `cwd`
        # degrades to silence, never to a false deny).
        # A cwd that does not EXIST is no better than an absent one: every
        # relative path under it resolves to a fictional location, so every
        # operand would read as missing. Drop to absolute-only rather than
        # deny a command whose base directory we could not confirm.
        _fa_cwd = payload.get('cwd')
        _fa_cwd = os.path.realpath(_fa_cwd) if _fa_cwd else None
        if _fa_cwd is not None and not os.path.isdir(_fa_cwd):
            _fa_cwd = None
        for _fa_toks, _fa_sep in _fa_segments:
            _fa_i = 0
            while (_fa_i < len(_fa_toks)
                   and re.match(r'^[A-Za-z_][A-Za-z0-9_]*=', _fa_toks[_fa_i])):
                _fa_i += 1
            _fa_argv = _fa_toks[_fa_i:]
            if not _fa_argv:
                continue
            _fa_name = _fa_argv[0].rsplit('/', 1)[-1]
            if _fa_name == 'cd':
                # Track the cwd the search will actually run in. Anything we
                # cannot resolve — including a `cd` that would itself fail —
                # ends the scan rather than being guessed at.
                if len(_fa_argv) < 2:
                    break
                _fa_tgt = _fa_argv[1]
                if any(c in _fa_tgt for c in _FA_UNRESOLVABLE):
                    break
                _fa_tgt = os.path.expanduser(_fa_tgt)
                if not os.path.isabs(_fa_tgt) and _fa_cwd is None:
                    break  # nothing to resolve it against
                _fa_next = (_fa_tgt if os.path.isabs(_fa_tgt)
                            else os.path.join(_fa_cwd, _fa_tgt))
                _fa_next = os.path.realpath(_fa_next)
                if not os.path.isdir(_fa_next):
                    break
                _fa_cwd = _fa_next
                continue
            if _fa_name in _FA_TRAVERSAL_CMDS:
                # A DIFFERENT false-absence shape with a different grammar —
                # judged here, then the scan ends on the same rule as below.
                _fa_bad_timestamp = _fa_invalid_find_timestamp(_fa_argv)
                if _fa_bad_timestamp:
                    _fa_flag, _fa_stamp = _fa_bad_timestamp
                    deny(_FA_TIMESTAMP_DENY.format(
                        cmd=' '.join(_fa_argv)[:160],
                        stamp=_fa_stamp[:200],
                        op=_fa_flag,
                    ))
                _fa_symlink_traversal(_fa_argv, _fa_cwd)
                break
            if _fa_name not in _FA_SEARCH_CMDS:
                # Only `cd` may precede the search — otherwise an earlier
                # `mkdir`/`git clone` could be creating the very path we are
                # about to call missing.
                break
            _fa_ops, _fa_pat_consumed = _fa_operands(
                _fa_argv,
                _FA_ARGFLAGS_LS if _fa_name == 'ls'
                else _FA_ARGFLAGS_RG if _fa_name == 'rg'
                else _FA_ARGFLAGS_GREP)
            if _fa_name == 'ls':
                # A bare `ls missing` prints a loud stderr error and is often a
                # deliberate existence probe. It is the PIPED form whose empty
                # stdout reads as a real absence — that is the measured trap.
                # `ls -d` is exempt in either form: it IS the existence probe
                # this guard's own remedy tells you to run, and denying the
                # recommended fix would be perverse.
                if _fa_sep != '|' or any(
                        a == '--directory'
                        or (a.startswith('-') and not a.startswith('--')
                            and 'd' in a[1:])
                        for a in _fa_argv[1:]):
                    break
                _fa_paths = _fa_ops
            else:
                if not _fa_ops:
                    break
                _fa_paths = _fa_ops if _fa_pat_consumed else _fa_ops[1:]
            for _fa_p in _fa_paths:
                if (not _fa_p or _fa_p in ('-', '.', '..')
                        or len(_fa_p) > 400
                        or any(c in _fa_p for c in _FA_UNRESOLVABLE)
                        or (not os.path.isabs(_fa_p) and _fa_cwd is None)):
                    continue
                _fa_full = (_fa_p if os.path.isabs(_fa_p)
                            else os.path.join(_fa_cwd, _fa_p))
                if os.path.exists(_fa_full):
                    continue
                _fa_shown = os.path.normpath(_fa_full)
                deny(_FA_DENY.format(
                    cmd=' '.join(_fa_argv)[:160],
                    path=_fa_p,
                    resolved=('' if _fa_shown == _fa_p
                              else ' (resolved to `%s`)' % _fa_shown[:200]),
                ))
            break
except SystemExit:
    raise  # deny() exits through here — never swallow the verdict
except Exception:
    pass  # a parse fault must never wedge a Bash call (fail-open)

# ── FIFO-read hang guard (EI-24862273512503301) ──────────────────────────────
# Claude Code RE-OPENS a path after a Bash command reads it (its file-read
# tracking), AFTER the command has returned and OUTSIDE the Bash timeout.
# open(2) of a FIFO blocks until a writer attaches. Measured 2026-10-02 in the
# J5 outage drill (WI-10005395): a `cat` of a FIFO returned while its writer
# was attached, the writer then closed, and Claude Code's re-open sat in the
# kernel (wchan wait_for_partner) — the tool result never came back, and no
# timeout covers that wait, so the session hung until it was killed.
#
# Deterministic and narrow. Judged: a LITERAL operand of a known reader command
# at command position that `stat` (which never opens it) reports as a FIFO at
# the moment of the call. Not judged:
#   * redirect targets (`< fifo`): the SHELL opens those, not the reader, and
#     the client re-open was only measured for named operands;
#   * /dev, /proc, /sys: they resolve against THIS hook process — whose stdin
#     IS a pipe — not against the command's shell, so judging them here would
#     deny `cat /dev/stdin` for the hook's own reasons;
#   * anything the hook cannot resolve ($VAR, globs, `~user`, a relative path
#     with no stated cwd) — fail open, never guess;
#   * Codex shells: the re-open is a Claude Code behaviour.
_FF_DENY = (
    'FIFO-read hang guard (EI-24862273512503301): `{cmd}` reads `{path}`, which '
    'is a FIFO (named pipe). Claude Code RE-OPENS a path after a Bash command '
    'reads it (file-read tracking) — after the command has returned and outside '
    'the Bash timeout — and open(2) of a FIFO blocks until a writer attaches. '
    'Once the writer has closed, that re-open never returns (wchan '
    'wait_for_partner) and the tool result hangs until the session is killed. '
    'Measured 2026-10-02 in the J5 outage drill (WI-10005395). Use a REGULAR '
    'FILE as the channel instead: create it with `: > f`, have the writer '
    'APPEND to it, and read it with `cat f` (or follow it in the background with '
    '`tail -n +1 -f f | consumer`). To inspect the pipe itself, `ls -l`, `stat` '
    'and `[ -p f ]` do not open it and are not gated.'
)
_FF_READERS = frozenset((
    'cat', 'tac', 'head', 'tail', 'less', 'more', 'nl', 'wc', 'sed', 'awk',
    'gawk', 'mawk', 'grep', 'egrep', 'fgrep', 'rg', 'cut', 'sort', 'uniq', 'od',
    'xxd', 'hexdump', 'strings', 'base64', 'jq', 'diff', 'cmp', 'md5sum',
    'sha1sum', 'sha256sum', 'sha512sum',
))
# Prefix commands that run their argument as the real command.
_FF_WRAPPERS = frozenset(('sudo', 'command', 'nohup', 'time', 'exec', 'stdbuf'))
_FF_PREFILTER = re.compile(
    r'(?:^|[\s;&|(`])(?:[\w./-]*/)?(?:%s)(?=\s|$)'
    % '|'.join(sorted(_FF_READERS, key=len, reverse=True)))
_FF_UNRESOLVABLE = '$`*?[]{}'      # `~/` is expanded below; `~user` is refused
_FF_HOOK_RELATIVE = ('/dev', '/proc', '/sys')


def _ff_under_hook_relative(path):
    return any(path == r or path.startswith(r + '/') for r in _FF_HOOK_RELATIVE)


def _ff_fifo_operand(p, cwd):
    """Return the resolved path when the literal operand *p* is a FIFO, else None."""
    if (not p or p == '-' or p.startswith('-') or len(p) > 400
            or any(c in p for c in _FF_UNRESOLVABLE)):
        return None
    if p == '~' or p.startswith('~/'):
        p = os.path.expanduser(p)
    elif p.startswith('~'):
        return None
    if not os.path.isabs(p):
        if cwd is None:
            return None
        p = os.path.join(cwd, p)
    full = os.path.normpath(p)
    if _ff_under_hook_relative(full):
        return None
    try:
        st = os.stat(full)          # stat never opens the file, so cannot block
    except (OSError, ValueError):
        return None
    if not _ff_stat.S_ISFIFO(st.st_mode):
        return None
    if _ff_under_hook_relative(os.path.realpath(full)):
        return None
    return full


try:
    import stat as _ff_stat
    if (tool_name.lower() == 'bash' and isinstance(command, str)
            and len(command) <= 20000 and _FF_PREFILTER.search(command)):
        _ff_tokens = _fa_shell_tokens(command)
        # A subshell reorders what a `cd` applies to; after one, judge only
        # absolute paths rather than resolve a relative one against a guess.
        _ff_subshell = '(' in _ff_tokens or ')' in _ff_tokens
        _ff_cwd = payload.get('cwd')
        _ff_cwd = os.path.realpath(_ff_cwd) if _ff_cwd else None
        if _ff_cwd is not None and not os.path.isdir(_ff_cwd):
            _ff_cwd = None
        _ff_segments, _ff_cur = [], []
        for _t in _ff_tokens:
            if _t in _FA_SEPARATORS or _t in ('(', ')'):
                _ff_segments.append(_ff_cur)
                _ff_cur = []
            else:
                _ff_cur.append(_t)
        _ff_segments.append(_ff_cur)
        for _ff_toks in _ff_segments:
            _ff_i = 0
            while (_ff_i < len(_ff_toks)
                   and re.match(r'^[A-Za-z_][A-Za-z0-9_]*=', _ff_toks[_ff_i])):
                _ff_i += 1
            _ff_argv = _ff_toks[_ff_i:]
            # Peel `sudo -E cat f`, `stdbuf -oL cat f`, `command cat f`, and
            # `timeout [-k 5] 10 cat f` — a timeout bounds the COMMAND, not the
            # client's re-open after it, so it is no remedy here.
            while _ff_argv and _ff_argv[0].rsplit('/', 1)[-1] in _FF_WRAPPERS | {'timeout'}:
                _ff_is_timeout = _ff_argv[0].rsplit('/', 1)[-1] == 'timeout'
                _ff_argv = _ff_argv[1:]
                while _ff_argv and _ff_argv[0].startswith('-'):
                    _ff_takes_arg = _ff_is_timeout and _ff_argv[0] in (
                        '-k', '-s', '--kill-after', '--signal')
                    _ff_argv = _ff_argv[2:] if _ff_takes_arg else _ff_argv[1:]
                if _ff_is_timeout and _ff_argv:
                    _ff_argv = _ff_argv[1:]  # the DURATION operand
            if not _ff_argv:
                continue
            _ff_name = _ff_argv[0].rsplit('/', 1)[-1]
            if _ff_name == 'cd':
                _ff_tgt = _ff_argv[1] if len(_ff_argv) > 1 else None
                if (_ff_subshell or _ff_tgt is None
                        or any(c in _ff_tgt for c in _FF_UNRESOLVABLE + '~')):
                    _ff_cwd = None
                    continue
                _ff_next = (_ff_tgt if os.path.isabs(_ff_tgt)
                            else os.path.join(_ff_cwd, _ff_tgt) if _ff_cwd
                            else None)
                _ff_cwd = (os.path.realpath(_ff_next)
                           if _ff_next and os.path.isdir(_ff_next) else None)
                continue
            if _ff_name not in _FF_READERS:
                continue
            _ff_skip_next = False
            for _ff_a in _ff_argv[1:]:
                if _ff_skip_next:           # a redirect's target or delimiter
                    _ff_skip_next = False
                    continue
                if _ff_a and all(c in '<>&' for c in _ff_a):
                    _ff_skip_next = True
                    continue
                _ff_hit = _ff_fifo_operand(_ff_a, _ff_cwd)
                if _ff_hit:
                    deny(_FF_DENY.format(cmd=' '.join(_ff_argv)[:160],
                                         path=_ff_hit[:200]))
except SystemExit:
    raise  # deny() exits through here — never swallow the verdict
except Exception:
    pass  # a parse fault must never wedge a Bash call (fail-open)

# ── tauri-agent-tools target guard (EI-10939) ────────────────────────────────
# SAFETY. `tauri-agent-tools` picks its target by scanning /tmp for
# `tauri-dev-bridge-<pid>.token` files and taking THE FIRST LIVE ONE IT HAPPENS
# TO READ (dist/bridge/tokenDiscovery.js: `if (!found) found = …`, over an
# unordered readdir; dist/commands/shared.js `resolveBridge()` falls into that
# path whenever `--pid` and `--port`+`--token` are all absent). There is no
# preference, no tie-break, and — this is the bug — NO WARNING when several
# bridges are alive. So a bare `tauri-agent-tools click …` drives WHICHEVER app
# readdir yielded first, which is very often NOT the throwaway instance the
# agent just spawned but the OWNER'S LIVE DESKTOP WINDOW. This nearly happened
# (an agent one keystroke from typing into the owner's real app).
#
# The package is a third-party global npm install (github.com/cesarandreslopez/
# tauri-agent-tools) — outside our repo, so we cannot fix `resolveBridge`. We CAN
# refuse to let an unaimed command through, which is the same protection.
#
# TWO TIERS, because ambiguity is not the only hazard:
#   • MUTATING (eval/click/type/…): an explicit target is required ALWAYS, even
#     when exactly one bridge is live. Verified 2026-07-13: the ONLY live bridge
#     on this box was the owner's own `papercusp-desktop` — so an ambiguity-only
#     rule would have sailed straight through and driven his window. If you are
#     about to DRIVE a webview, you must say which one. No exceptions.
#   • READ-ONLY bridge commands (dom/screenshot/page-state/…): required only when
#     the choice is genuinely AMBIGUOUS (2+ live bridges). Reading the wrong app
#     is how "I verified my fix" becomes a false green.
#   • Discovery + bridge-free commands (probe/list-windows/info/forensics/…) are
#     NEVER gated — `probe` is the ANSWER to this deny, so blocking it would be
#     perverse.
#
# NOT gated on PAPERCUSP_AGENT_SESSION: EI-7872 established that the marker is
# silently unset in fleet-launched sessions — exactly the ones doing unattended
# UI verification. The resource being protected is the owner's live app, not a
# tree, and the deny is satisfiable with one flag, so it applies to every session
# this hook runs in. Mirrors tauriTargetDenyReason() in the OMP hook.
TAT_MUTATING = frozenset((
    'eval', 'click', 'type', 'scroll', 'focus', 'navigate', 'select', 'invoke',
))
TAT_BRIDGE_READ = frozenset((
    'screenshot', 'dom', 'wait', 'ipc-monitor', 'page-state', 'storage',
    'console-monitor', 'mutations', 'snapshot', 'rust-logs', 'store-inspect',
    'check', 'capture', 'process-tree', 'capabilities', 'webview', 'health',
    'diagnose',
))
_TAT_BIN_RE = re.compile(r'(?:^|[\s;&|(])(?:[\w./-]*/)?tauri-agent-tools(?=\s|$)')


def _tat_subcommand(cmd):
    # The subcommand is the first non-flag token after the binary. Returns None
    # for a bare/`--help`/`--version` invocation (nothing to aim).
    m = _TAT_BIN_RE.search(cmd)
    if not m:
        return None
    rest = cmd[m.end():].split()
    for tok in rest:
        if tok.startswith('-'):
            continue
        return tok
    return None


def _tat_has_explicit_target(cmd):
    # `--pid N` is the aim. `--port N --token X` bypasses discovery entirely and
    # is equally explicit. Either satisfies the guard. (Quote-stripped: a quoted
    # VALUE disappears but the flag token itself survives, so this stays sound.)
    if re.search(r'--pid[=\s]', cmd):
        return True
    return bool(re.search(r'--port[=\s]', cmd) and re.search(r'--token[=\s]', cmd))


def _tat_live_bridges():
    # Same discovery the tool itself does — /tmp/tauri-dev-bridge-<pid>.token,
    # keeping only the ones whose pid is still alive — plus the process cmdline,
    # so the refusal can NAME the candidates instead of just asserting ambiguity.
    import glob
    out = []
    for path in sorted(glob.glob(os.path.join(tempfile.gettempdir(), 'tauri-dev-bridge-*.token'))):
        try:
            with open(path) as fh:
                data = json.load(fh)
            pid = int(data['pid'])
            os.kill(pid, 0)  # raises unless alive
        except Exception:
            continue  # dead / malformed — the tool skips these too
        try:
            with open('/proc/%d/cmdline' % pid, 'rb') as fh:
                exe = fh.read().replace(b'\x00', b' ').decode('utf-8', 'replace').strip()
        except Exception:
            exe = '(unknown process)'
        out.append({'pid': pid, 'port': data.get('port'), 'exe': exe[:100]})
    return out


def _tat_candidate_lines(bridges):
    return '\n'.join(
        '  --pid %-8d port %-6s %s' % (b['pid'], b['port'], b['exe']) for b in bridges
    ) or '  (none discoverable right now)'


def _tauri_target_deny_reason(sub, bridges, mutating):
    head = (
        'tauri-agent-tools target guard: this command DRIVES a webview but does not say WHICH one.'
        if mutating else
        'tauri-agent-tools target guard: %d bridges are live, so `%s` cannot tell which app you mean.'
        % (len(bridges), sub)
    )
    why = (
        'With no --pid, tauri-agent-tools attaches to the FIRST bridge token it finds in /tmp — '
        'an arbitrary readdir order, with no warning. That is frequently the OWNER\'S LIVE DESKTOP '
        'APP rather than the instance you spawned.'
    )
    return (
        '%s\n%s\n\nLive bridges right now:\n%s\n\nRe-run naming your target:\n'
        '  tauri-agent-tools %s --pid <PID> …\n\n'
        'Not sure which is yours? `tauri-agent-tools probe` (never blocked) lists the targets, '
        'and the PID of an app YOU spawned is the one you launched — if you did not spawn one, '
        'you are about to act on someone else\'s window.' % (
            head, why, _tat_candidate_lines(bridges), sub,
        )
    )


# EI-19294800751120438: subcommand detection AND the --target check both read the
# SCANNABLE form. They must use the SAME text — reading the subcommand from a
# nested payload while checking --target on the raw string would manufacture a
# false deny for a wrapped command that DID aim explicitly.
_tat_sub = _tat_subcommand(_scannable_quote_stripped())
if _tat_sub in TAT_MUTATING or _tat_sub in TAT_BRIDGE_READ:
    _stripped_cmd = _scannable_quote_stripped()
    if not _tat_has_explicit_target(_stripped_cmd):
        _mutating = _tat_sub in TAT_MUTATING
        _bridges = _tat_live_bridges()
        # Mutating: always require an aim. Read-only: only when ambiguous.
        # Zero bridges → nothing to hit; let the tool print its own error.
        if _bridges and (_mutating or len(_bridges) > 1):
            deny(_tauri_target_deny_reason(_tat_sub, _bridges, _mutating))

# ── tauri-agent-tools raw-JSON --token advisory (EI-15605) ─────────────────
# SOFT/ADVISORY (never blocks — same third-party-package rationale as the
# target guard above: the CLI is a third-party global npm install, so we
# cannot make it validate/error better itself). The dev-bridge token file
# (/tmp/tauri-dev-bridge-<pid>.token) is a JSON object
# `{"port":N,"token":"...","pid":N}`, NOT a bare token string. Piping its raw
# content straight into `--token` (e.g. `--token "$(cat /tmp/tauri-dev-bridge-
# <pid>.token)"`) silently fails auth ("Bridge authentication failed — check
# your token") even though the token itself is correct inside that JSON —
# cost 3 failed eval attempts (raw cat, trimmed cat, `require()` on a
# .token extension Node refuses to parse) before spotting the wrapper.
# Catches both the inline substitution form and the assign-then-use form
# (`TOK=$(cat …/*.token); … --token "$TOK"`); skipped whenever the same
# substitution already shows evidence of JSON extraction (jq/python/node/
# JSON.parse/json.load) — that's presumably already doing it right.
try:
    if not ADVISORY:
        _tok_hint_re = re.compile(r'(?:\bcat\s+|<\s*)\S*\.token\b')
        _tok_extracted_re = re.compile(r'\bjq\b|\bpython3?\b|\bnode\b|JSON\.parse|json\.load')
        _tok_flagged = False
        # (a) inline: --token "$(cat …/*.token)"
        for _tok_body in re.findall(r'--token[=\s]+"?\$\(([^)]*)\)"?', command):
            if _tok_hint_re.search(_tok_body) and not _tok_extracted_re.search(_tok_body):
                _tok_flagged = True
                break
        # (b) assign-then-use: VAR=$(cat …/*.token) ... --token "$VAR"
        if not _tok_flagged:
            for _tok_var, _tok_body in re.findall(r'\b([A-Za-z_]\w*)=\$\(([^)]*)\)', command):
                if _tok_hint_re.search(_tok_body) and not _tok_extracted_re.search(_tok_body):
                    if re.search(r'--token[=\s]+"?\$\{?' + re.escape(_tok_var) + r'\b', command):
                        _tok_flagged = True
                        break
        if _tok_flagged:
            ADVISORY = (
                'tauri-agent-tools --token advisory (EI-15605): the dev-bridge token file '
                '(/tmp/tauri-dev-bridge-<pid>.token) is JSON — {"port":N,"token":"...","pid":N} '
                '— not a bare token string. Passing its raw content as --token silently fails '
                'auth ("Bridge authentication failed — check your token") even though the '
                'token itself is correct. Extract the field first, e.g. '
                '`--token "$(jq -r .token /tmp/tauri-dev-bridge-<pid>.token)"` (or a '
                '`node -e \'process.stdout.write(JSON.parse(require("fs").readFileSync('
                'process.argv[1],"utf8")).token)\' /tmp/tauri-dev-bridge-<pid>.token` '
                'one-liner if jq is unavailable). Usually simplest: skip --port/--token '
                'entirely and let `tauri-agent-tools probe`/auto-discovery find the bridge '
                '(pass --pid <pid> to disambiguate multiple bridges). Advisory only; this '
                'command is proceeding as issued.'
            )
except Exception:
    pass  # advisory must never wedge a command

# ── tauri-agent-tools screenshot window-resolution advisory (EI-21383660965482252) ──
# SOFT/ADVISORY (third-party CLI — same rationale as EI-15605 above: we cannot
# fix its resolution logic). `screenshot` resolves the OS window by DOCUMENT
# TITLE (`xdotool search --name "Papercusp Operator"`) and the native window's
# WM_NAME is NOT the document title — so the search finds nothing, nothing is
# captured, and no output file is produced EVEN WHEN the bridge/PID is healthy
# and even when --pid was passed explicitly (the pid aims the BRIDGE; the pixel
# grab still title-matches the window). Measured live against a healthy single
# bridge (pid 3593460). Alternatives that work: pixels → capability:computer
# screenshot (display-target, lease-managed); layout facts → tauri-verify
# bridge assertions over the authenticated bridge (EI-11084); in-page proof →
# `tauri-agent-tools eval --pid <PID>` driving canvas/html2canvas.
try:
    if not ADVISORY and _tat_sub == 'screenshot':
        ADVISORY = (
            'tauri-agent-tools screenshot advisory (EI-21383660965482252): this subcommand '
            'resolves the OS window by DOCUMENT TITLE (xdotool search --name "Papercusp '
            'Operator"), and the native window\'s WM_NAME is not the document title — so the '
            'search fails, nothing is captured, and no output file is produced even when the '
            'bridge/PID is healthy (--pid aims the bridge, not the pixel grab). Working '
            'alternatives: pixels -> capability:computer screenshot (display-target, '
            'lease-managed); layout facts -> tauri-verify bridge assertions over the '
            'authenticated bridge (EI-11084); in-page proof -> tauri-agent-tools eval --pid '
            '<PID> with canvas/html2canvas. Advisory only; this command is proceeding as issued.'
        )
except Exception:
    pass  # advisory must never wedge a command

# Destructive tree-wide git guard (hive-loop-supervision-2026-06-21): a
# pathspec-less `git reset --hard` / `git checkout|restore .` (or `:/`) /
# `git clean -f*` / `git stash` on the SHARED staging checkout discards EVERY
# concurrent agent's UNCOMMITTED work — edits sit unstaged until the next
# git-sync tick, so the loss is UNRECOVERABLE (git never made a blob; kopia
# backs up workspace-state, ~14KB, NOT the code). Confirmed wiping a tested
# in-flight fix on 2026-06-21 (an agent "cleaning the tree" between commits) —
# the root of the recurring "my edits got reverted/overwritten" reports.
#
# GATE ON THE TREE, NOT THE MARKER (EI-7872, 2026-07-06): this block was gated
# on `PAPERCUSP_AGENT_SESSION == '1'`, but that env marker is silently ABSENT
# in fleet-launched sessions (fleet:launch-on-plan → the drain fleet) — VERIFIED
# unset in the Claude PROCESS env (env A, what THIS hook inherits — read from
# /proc/<pid>/environ, not just the Bash sub-shell), so the sole rail against
# fleet-wide uncommitted-work loss was INERT (fail-OPEN) for exactly the sessions
# it must protect. The resource being protected is the canonical SHARED staging
# checkout, so gate on THAT directly: fire when the command runs IN that tree
# (payload `cwd`, read the same way the sibling lock hook does), independent of
# any env marker. The owner's OWN separate checkouts (papercup-release, other
# worktrees) have a different cwd and stay exempt — the real D-003 intent, keyed
# by TREE not marker (and nobody, owner included, should reset --hard the shared
# concurrent tree). The marker is still honored as an OR-trigger, so any launch
# path that DOES set it stays covered even outside the tree. Local decision, no
# HTTP. Per-segment + start-anchored (re.match after splitting on ;&|newline and
# stripping wrappers) so `cd x && git reset --hard` is caught but `echo "…"` is not.
def _cmd_in_canonical_tree():
    # True when the command's working dir is the canonical shared staging tree
    # (or under it). cwd from the hook payload, falling back to the hook
    # process cwd for shells that don't pass one (codex). realpath-compared so
    # a symlinked checkout still matches; the `+ os.sep` guard stops a sibling
    # like `papercusp-staging` from matching `papercusp`. Fail-open on our own
    # error (a hook must never wedge every bash command).
    try:
        _cwd = os.path.realpath(payload.get('cwd') or os.getcwd())
        _ws_root = os.path.realpath(
            os.environ.get('PAPERCUSP_WORKSPACE_ROOT')
            or os.path.expanduser('~/papercupai-workspace'))
        _canon = os.path.realpath(
            os.environ.get('PAPERCUSP_CANONICAL_TREE')
            or os.path.join(_ws_root, 'papercusp'))
        def _in(p):
            return p == _canon or p.startswith(_canon + os.sep)
        if _in(_cwd):
            return True
        # Also honor a leading `cd <path> && …`: a marker-less fleet session
        # (EI-7872) running e.g. `cd <canonical> && git reset --hard` (or a heavy
        # build) carries the OUTER cwd in the payload, so the cwd check alone
        # misses it. Resolve ONLY a simple, unambiguous leading cd target (no
        # spaces, quotes, or shell operators/expansion) against the outer cwd;
        # anything fancier falls back to the cwd-only result, and accurate
        # realpath resolution means `cd /other/repo && …` stays outside canonical
        # — so this only ever gates MORE (never a false positive on another tree).
        _cd = re.match(r"\s*cd\s+(['\"]?)([^&|;<>\s'\"]+)\1\s*(?:&&|;|\||$)", command)
        if _cd and _in(os.path.realpath(os.path.join(_cwd, _cd.group(2)))):
            return True
        return False
    except Exception:
        return False

if os.environ.get('PAPERCUSP_AGENT_SESSION') == '1' or _cmd_in_canonical_tree():
    _GIT = r'git\b(?:\s+-C\s+\S+|\s+-c\s+\S+|\s+--git-dir\S*|\s+--work-tree\S*)*\s+'
    _git_deny = (
        'shared-tree guard: `{op}` would discard EVERY concurrent agent\'s '
        'UNCOMMITTED work on the shared staging checkout — edits sit unstaged '
        'until the next git-sync tick, so the loss is UNRECOVERABLE (no git blob; '
        'kopia backs up workspace-state, not code). This wiped a tested in-flight '
        'fix on 2026-06-21. To discard only YOUR change to ONE file, re-edit it by '
        'hand or run `git checkout -- <that.one.file>` with an EXPLICIT path — '
        'never a pathspec-less reset/checkout/clean/stash. If you wanted a clean '
        "tree, you don't need one: stop editing and let git-sync commit."
    )
    # Peel leading command WRAPPERS so a wrapped destructive op can't bypass the
    # guard — PROVEN 2026-07-06: the guard denied `git reset --hard` but ALLOWED
    # `rtk git reset --hard` (rtk = the token-killer output filter, which rewrites
    # `git …`→`rtk git …`). `time`/`env`/`nice`/`command`/`nohup`/`sudo` were the
    # same latent class. Bounded loop peels nested wrappers (`time rtk git …`).
    #
    # EI-19294800751120438: this NAME-LIST is exactly what rotted — the 2026-07-06
    # fix added `rtk` and left `timeout` open, which measured as an ALLOW on
    # `timeout 60 git reset --hard`. The structural descent in _scannable() is now
    # the real defense (it parses the argv rather than matching wrapper names);
    # the list is kept as a cheap belt-and-braces for the base segment.
    _WRAP_STRIP = re.compile(
        r'^\s*(?:'
        r'sudo(?:\s+(?:-[ugpUrCht]\s+\S+|-[A-Za-z]+|--[\w-]+(?:=\S*)?))*'
        r'|env(?:\s+[A-Za-z_]\w*=\S*)*'
        r'|nice(?:\s+-n\s*-?\d+)?'
        r'|ionice(?:\s+-\w+(?:\s+\d+)?)*'
        r'|xargs(?:\s+-\w+)*'
        r'|rtk|time|command|nohup|exec|setsid|nocorrect|stdbuf|doas|nocache'
        r')\s+'
    )

    def _unwrap(_x):
        for _ in range(8):
            _y = _WRAP_STRIP.sub('', _x, count=1)
            if _y == _x:
                return _x
            _x = _y
        return _x

    for _seg in re.split(r'[;&|\n]', _scannable()):
        _s = _unwrap(_seg.strip())
        if re.match(_GIT + r'reset\b.*--hard\b', _s):
            deny(_git_deny.format(op='git reset --hard'))
        if re.match(_GIT + r'clean\b.*-\w*f', _s):
            deny(_git_deny.format(op='git clean -f'))
        if re.match(_GIT + r'(?:checkout|restore)\b.*\s(?:\.|:/)(?:\s|$)', _s):
            deny(_git_deny.format(op='git checkout/restore .'))
        # EI-18215743778965613 (self-caught 2026-07-20): `pop`/`apply` used to be
        # exempted alongside the genuinely-read-only subcommands below, and a
        # `push -- <paths>` was exempted as "scoped" — but the stash is a SINGLE
        # shared LIFO stack across the whole tree, not scoped by a push's
        # pathspec: a scoped push followed by `pop` popped an UNRELATED ancient
        # stash entry, producing a merge conflict in files never touched by the
        # caller. `pop`/`apply` apply WHATEVER is on top of that shared stack to
        # the working tree — exactly the same "clobbers a peer's uncommitted
        # state" hazard as reset --hard/checkout .— so they're no safer than a
        # bare `git stash` and must be denied unconditionally, same as a
        # scoped `push` (no more ` -- ' exemption). `list`/`show` stay exempt
        # (read-only, no working-tree mutation); `drop`/`branch`/`clear` are
        # unchanged from before (not implicated in this incident).
        if re.match(_GIT + r'stash\b(?!\s+(?:list|show|drop|branch|clear))', _s):
            deny(_git_deny.format(op='git stash'))

# ── Shell-write file-target guard (EI-18664655909328670) ───────────────────
# `cat >> file` / `echo > file` / `tee file` / `sed -i file` / `cp x file` write
# tree files through a side door the Edit/Write PreToolUse hooks never see: no
# file lock is claimed (a peer editing the same file races unserialized), and
# when the session cwd has silently drifted, the redirect/tee/cp does not
# error — it CREATES A STRAY FILE with zero signal, and a subsequent test run
# against the real path then reports green, actively confirming the wrong
# conclusion. Repro'd live 2026-07-25: an agent believed cwd was a package
# subdir, appended via `cat >> tools/conversations-list.test.ts <<EOF`, cwd had
# actually drifted to the repo root (which also has a `tools/`), and the
# redirect silently created `papercusp/tools/conversations-list.test.ts` — an
# un-gitignored stray one git-sync tick from being committed, caught only by a
# manual diff against `git show HEAD:`.
#
# Detect a write target that resolves INSIDE the canonical shared staging tree
# and BLOCK it, pointing at Edit/Write instead — those tools already claim the
# lock and validate the worktree, so this closes the side door rather than
# reimplementing locking here.
#
# UNCONDITIONAL (not gated on PAPERCUSP_AGENT_SESSION or cwd-in-tree): this
# hook only ever mediates Claude/Codex's own Bash tool, never the owner's raw
# terminal, and the gate keys on the resolved TARGET path — so it cannot
# over-block real terminal work, only a Bash-tool write that lands in the tree.
#
# LITERAL PATHS ONLY: a target containing shell expansion ($VAR, $(...),
# backticks, `~`, a glob) is left alone — unsafe to resolve without actually
# running the shell, so fail-open there rather than guess.
def _canonical_tree_root():
    try:
        _ws_root = os.path.realpath(
            os.environ.get('PAPERCUSP_WORKSPACE_ROOT')
            or os.path.expanduser('~/papercupai-workspace'))
        return os.path.realpath(
            os.environ.get('PAPERCUSP_CANONICAL_TREE')
            or os.path.join(_ws_root, 'papercusp'))
    except Exception:
        return None


# EI-19372138838008750 / EI-19304149823089876 — the ONE sanctioned scratch
# location INSIDE the tree.
#
# Two independent reports, same mechanism. The second enumerated all three dead
# ends it hit in a row: a relative import from /tmp (resolves against /tmp), an
# absolute one (its own `pg` import then fails), and copying the script into the
# tree so resolution works (denied here — correctly). That is the whole space of
# obvious moves, so an agent mid-verification had nowhere legal to land.
#
# This guard exists because a raw shell write into the tree skips the file-lock
# hook and can be swept into a commit by git-sync. NEITHER hazard can reach
# `<tree>/.papercusp/scratch/`: it is gitignored (`.gitignore` carries
# `**/.papercusp/scratch/`), so git-sync can never commit anything under it, and
# a throwaway probe no peer edits has no lock worth contending for.
#
# Exempting it is what makes this guard's OWN remediation followable. The old advice
# was "write it outside the tree (~/.papercusp/scratch or /tmp)" — but the single
# most common scratch case on this repo, a tsx/node probe that IMPORTS repo
# modules, cannot run from either: module resolution walks up from the FILE's
# directory, and neither location has a repo `node_modules` above it. Measured
# 2026-08-10: a probe under `~/.papercusp/scratch` dies with MODULE_NOT_FOUND.
# So the guard denied the only location that works and recommended two that
# don't, and the agent hit that wall mid-verification with no legal move.
# External scratch is also shared across concurrent agents, so any external path
# named in the remedy must be per-session/task-unique rather than a reusable bare
# `/tmp/<name>` filename. The remedy below keeps the working in-tree location and
# `code:run` route explicit while making that uniqueness requirement visible.
#
# ⚠ `/tmp` can LOOK viable: a stray `/tmp/node_modules` (a full dependency tree
# left there on 2026-08-09) silently satisfies those imports for as long as it
# survives. That is an artifact, not a guarantee — it masks the failure until
# someone cleans it up, and a probe verified against it breaks with no code
# change. Do not treat a passing /tmp probe as evidence that /tmp works.
def _sanctioned_scratch_roots(canon):
    if not canon:
        return ()
    base = os.path.join(canon, '.papercusp', 'scratch')
    roots = [base]
    try:
        _real = os.path.realpath(base)
        if _real != base:
            roots.append(_real)
    except Exception:
        pass
    return tuple(roots)


def _is_sanctioned_scratch(resolved, canon):
    """True only for a path STRICTLY UNDER <tree>/.papercusp/scratch/.

    Strictly-under is deliberate: the directory itself is not a write target,
    and requiring the separator stops a sibling like `.papercusp/scratchpad`
    from inheriting the exemption by prefix.
    """
    if not resolved:
        return False
    for _root in _sanctioned_scratch_roots(canon):
        if resolved.startswith(_root + os.sep):
            return True
    return False


# The scratch remedy BOTH write-guards hand back. Kept as ONE constant so the
# two call sites cannot drift apart — the same reason the cd-resolution note is
# shared rather than duplicated.
_SCRATCH_REMEDY = (
    'Genuinely a scratch/log file? Write it outside the tree '
    'under a per-session/task-unique directory (for example '
    '`~/.papercusp/scratch/<session-or-task>/` or `/tmp/<session-or-task>/`); '
    'never reuse a bare shared `/tmp` filename because concurrent agents can '
    'overwrite it. But if it must IMPORT repo modules (the '
    'usual tsx/node probe), neither of those can resolve them — there is no repo '
    '`node_modules` above either — so either run it through `code:run` (executes '
    'in-tree with the tool namespace available), or write it under '
    '`.papercusp/scratch/` INSIDE the tree: that path is gitignored, is exempt '
    'from this guard, and resolves workspace imports normally. '
)


# EI-18760311552821358: a `NAME:PATH` target is a REMOTE/CONTAINER destination
# (`docker cp local.sh container:/tmp/c.sh`, `scp`/`rsync` `host:/path` — the
# command-position `cp` scan below intentionally does not match the `cp` inside
# `docker cp`, but this leg still documents the non-host-path shape for any
# future widening), not a host path at all. Treating the bit after the
# colon as a path and joining it against cwd resolves it INSIDE the tree
# whenever cwd happens to be in the tree — a false positive, since the write
# actually lands inside the container's filesystem and can never touch the
# host tree at that argument position. Same "unsafe/not-a-local-path, fail
# open" precedent as the `$`/backtick/`~`/glob checks below: a real local
# filename containing a colon (rare, but legal on Linux) is a false negative
# this trades away deliberately, same tradeoff already made for those.
_CONTAINER_REF_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9_.-]*:')


def _resolve_write_target(raw_target, cwd):
    if not raw_target or any(ch in raw_target for ch in ('$', '`', '~', '*', '?', '[')):
        return None
    if raw_target.startswith('/dev/') or raw_target in ('&1', '&2'):
        return None
    if _CONTAINER_REF_RE.match(raw_target):
        return None
    try:
        return os.path.realpath(
            raw_target if os.path.isabs(raw_target) else os.path.join(cwd, raw_target))
    except Exception:
        return None


_HEREDOC_START_RE = re.compile(r"<<-?\s*(['\"]?)(\w+)\1")


def _strip_heredoc_bodies(s):
    # Remove heredoc BODY text — the lines between a `<<[-]DELIM` operator and
    # the line consisting of just DELIM (`<<-` allows leading whitespace on
    # that closing line) — before scanning for redirect operators. A
    # heredoc's payload is often an embedded script (python/node/SQL/…), and
    # an operator inside it (`v>100`, `x > y`, `=>`, `->`) is DATA, not real
    # shell syntax — scanning it as if it were is a false-positive generator
    # (EI-18683619680591304). Run BEFORE _strip_quotes_and_comments: quote-stripping
    # the raw heredoc body first risks mis-parsing an unbalanced quote inside
    # the payload and swallowing real command text that follows. This only
    # ever REMOVES characters — it can never manufacture a new match — so it
    # is safe even when a heredoc is malformed/unterminated.
    out = []
    i, n = 0, len(s)
    while i < n:
        m = _HEREDOC_START_RE.search(s, i)
        if not m:
            out.append(s[i:])
            break
        line_end = s.find('\n', m.end())
        if line_end == -1:
            out.append(s[i:])
            break
        out.append(s[i:line_end + 1])
        delim = m.group(2)
        close_re = re.compile(r'^[ \t]*' + re.escape(delim) + r'\s*$', re.MULTILINE)
        cm = close_re.search(s, line_end + 1)
        if not cm:
            i = n  # unterminated heredoc — drop the rest, nothing safe to scan
            break
        i = cm.end()
    return ''.join(out)


def _segment_has_unsplittable_expansion(seg):
    # EI-18691980588797795: `tee`/`sed -i`/`perl -i`/`ruby -i`/`cp` all identify
    # their target(s) by `.split()`-ing the raw command-tail segment on
    # whitespace. A `$(...)`/backtick command substitution containing an
    # INTERNAL space (e.g. `cp src.txt $(echo target dir)/dest.txt`) splits
    # across MULTIPLE resulting tokens — the substitution's tail then reads as
    # its own bare positional token (e.g. `dir)/dest.txt`), which usually
    # carries none of `_resolve_write_target`'s own expansion markers ($ ` ~ *
    # ? [) and so is NOT recognized as unsafe-to-resolve. That stray fragment
    # then gets resolved against cwd like any ordinary literal path — and when
    # cwd is INSIDE the canonical tree (the exact situation this guard exists
    # to protect), any such fragment resolves to a path that trivially starts
    # with the canonical root, producing a FALSE DENY on an otherwise-fine
    # command. Conservative fix: if `$(` or a backtick appears ANYWHERE in the
    # raw segment, the split is unsafe to trust at all — skip target detection
    # for this invocation entirely (fail-open), matching this guard's own
    # stated "unsafe to resolve without actually running the shell" policy for
    # expansions, just applied BEFORE the split loses the marker.
    return '$(' in seg or '`' in seg


def _looks_like_redirect_path(raw):
    # Defense-in-depth alongside the heredoc strip above: a bare comparison/
    # arrow operator can still appear unquoted OUTSIDE a heredoc (e.g. inside
    # `$(( … ))` arithmetic, which quote-stripping does not touch) and read as
    # a redirect whose "target" is just a number. Require the token to look
    # like an actual path — contains a separator, has a file extension, or is
    # not purely a decimal integer — before treating it as a write target.
    if '/' in raw:
        return True
    if re.search(r'\.[A-Za-z0-9]{1,10}$', raw):
        return True
    if re.fullmatch(r'-?\d+', raw):
        return False
    return True


def _mask_postgres_json_arrows_in_substitutions(text):
    """Hide PostgreSQL JSON operators from the shell redirect scanner.

    `_strip_quotes_and_comments(..., preserve_expansions=True)` deliberately
    keeps command substitutions visible so a real write inside `$(...)` is
    still protected.  That leaves a second language in the same text, though:
    an unquoted psql expression such as `payload->'observation'->>'state'`
    becomes `payload-> ->> ` after quote stripping.  The flat redirect regex
    then reads the `>` in each SQL arrow as shell syntax and can resolve the
    following `-` as a tree-relative filename.

    Do not skip every redirect in a substitution.  First isolate balanced
    `$()`/backtick bodies, then mask only an arrow chain in a command segment
    that invokes `psql`; shell redirects remain byte-for-byte in the returned
    text.  Replacements are spaces, so match offsets used by the caller stay
    stable.  Malformed substitutions are left unchanged (the guard's normal
    fail-open behavior handles them).
    """
    if '$(' not in text and '`' not in text:
        return text

    def _spans(value):
        spans = []
        i = 0
        while i < len(value):
            if value.startswith('$(', i):
                parsed = _scan_command_substitution(value, i)
                if parsed is None:
                    i += 2
                    continue
                _body, end = parsed
                spans.append((i, end, i + 2, end - 1))
                i = end
                continue
            if value[i] == '`':
                end = value.find('`', i + 1)
                if end == -1:
                    i += 1
                    continue
                spans.append((i, end + 1, i + 1, end))
                i = end + 1
                continue
            i += 1
        return spans

    def _mask_segment_arrows(value):
        spans = _spans(value)
        # Nested substitutions are handled recursively; blank them in this
        # view so an outer `psql` segment cannot reinterpret their shell text
        # as SQL and mask a genuine nested redirect.
        view = list(value)
        for _start, _end, _body_start, _body_end in spans:
            for _pos in range(_start, _end):
                view[_pos] = ' '
        scan = ''.join(view)
        out = list(value)

        def _mask_arrow(op_start, op_end):
            # Keep the '-' that makes this a JSON operator; only the `>`
            # characters matter to the shell redirect regex.
            for _pos in range(op_start + 1, op_end):
                out[_pos] = ' '

        for _part in re.finditer(r'[^;&|\n]+', scan):
            _segment = _part.group(0)
            if not re.search(r'(?<![\w-])psql(?=\s|$)', _segment, re.IGNORECASE):
                continue
            _segment_start = _part.start()
            # A SQL key may have disappeared during quote stripping, leaving
            # only whitespace between chained `->` operators.  Seed on an
            # identifier/closing JSON container, then consume adjacent arrow
            # tokens whose operands were removed by normalization.
            for _seed in re.finditer(
                r'(?:[A-Za-z_][A-Za-z0-9_$]*|[)\]])[ \t]*(->>|->)',
                _segment,
            ):
                _end = _segment_start + _seed.end(1)
                _mask_arrow(_segment_start + _seed.start(1), _end)
                while True:
                    _next = re.match(r'[ \t]*(->>|->)', scan[_end:])
                    if _next is None:
                        break
                    _start = _end + _next.start(1)
                    _end += _next.end(1)
                    _mask_arrow(_start, _end)

        return ''.join(out)

    def _rewrite(value):
        spans = _spans(value)
        if not spans:
            return _mask_segment_arrows(value)
        out = list(value)
        for _start, _end, _body_start, _body_end in spans:
            _body = value[_body_start:_body_end]
            _masked = _rewrite(_body)
            out[_body_start:_body_end] = list(_masked)
        return _mask_segment_arrows(''.join(out))

    return _rewrite(text)


# WI-6026 (EI-18664655909328670, 3rd instance): `tee`/`sed -i`/`perl -i`/
# `ruby -i`/`cp` all find their target(s) by `.split()`-ing the raw
# command-tail segment on whitespace, same as the substitution-fragment bug
# above — but here the stray token is a REDIRECT the caller wrote to silence
# output (`cmd ... 2>/dev/null`, `cmd ... > /tmp/out.log`), an extremely
# common idiom. Redirect syntax is not a positional argument: strip it BEFORE
# any of those legs treats "the last remaining token" as the destination, or
# a combined `2>/dev/null` reads as the `cp`/`tee`/`sed -i` target itself
# (repro: `cp a.txt /tmp/x/b.txt 2>/dev/null` denied with the guard naming
# `2>/dev/null` as the target — the give-away that its own parse was wrong).
# Handles both the combined form (`2>/dev/null`, `>>file`, `&>file`) and the
# split form where the operator and its target are separate tokens
# (`cp a b > out`), plus bare fd-duplication (`2>&1`, `>&2`) which carries no
# path target at all.
def _strip_redirect_tokens(toks):
    out = []
    skip_next = False
    for t in toks:
        if skip_next:
            skip_next = False
            continue
        if re.fullmatch(r'\d*[<>]&(?:\d+|-)?', t) or re.fullmatch(r'\d*>&\d*', t):
            continue
        _m = re.match(r'^\d*(?:>{1,2}|&>)(.*)$', t)
        if _m:
            if _m.group(1) == '':
                # bare operator token (`>`, `2>`, `>>`, `&>`) — its target, if
                # any, is the NEXT token; drop both.
                skip_next = True
            continue
        _m = re.match(r'^\d*(?:<<<|<<-?|<>|<)(.*)$', t)
        if _m:
            if _m.group(1) == '':
                # Input redirections (`<`, `<<`, `<<-`, `<<<`, `<>`) likewise
                # consume the NEXT token when their operand is split. In
                # particular, a `tee FILE <<EOF` heredoc must leave FILE as
                # the only positional target; otherwise the heredoc operator
                # itself is misreported as a path under the tree.
                skip_next = True
            continue
        out.append(t)
    return out


# EI-18809538554039853: short flags BUNDLE, so the in-place flag is frequently not
# the first character of its token — `perl -0pi -e ...` is `-0` `-p` `-i`, and is the
# idiomatic slurp-mode in-place rewrite, i.e. exactly the multi-line edit reached for
# INSTEAD of Edit. The earlier `(?:^|\s)-i\S*` test required the token to BEGIN with
# `-i` and so missed every bundled spelling, silently letting those writes past the
# file-lock hook on a tree the whole fleet shares.
#
# Scanning for a bare `i` anywhere in the token is NOT correct either: it would deny
# `-Mstrict`, `-Ilib/inc`, `-Fpattern` — common, and none of them in-place. Short
# flags that take a VALUE consume the remainder of their token, so the scan stops at
# the first of those; anything after it is a value, not a flag.
_VALUE_CONSUMING_FLAGS = {
    'perl': set('eEMmIFxCD'),
    'ruby': set('eEIrKCFSx'),
    'sed': set('efl'),
}


def _has_inplace_flag(seg, kind):
    """True when any token in `seg` carries an in-place flag, bundled or not."""
    _consuming = _VALUE_CONSUMING_FLAGS.get(kind, set())
    for _tok in seg.split():
        # Long form (`sed --in-place`, `--in-place=.bak`).
        if _tok == '--in-place' or _tok.startswith('--in-place='):
            return True
        # Only short-flag clusters bundle; `--foo` and a bare `-` never do.
        if _tok.startswith('--') or not _tok.startswith('-') or _tok == '-':
            continue
        for _ch in _tok[1:]:
            if _ch == 'i':
                return True
            if _ch in _consuming:
                break  # the rest of this token is that flag's value, not more flags
    return False


# EI-20090210551302164 — Prettier's `--write`/`-w` is another in-place rewrite
# that bypasses the Edit/Write lock hook.  Keep this deliberately narrower than
# a general npm-script detector: the shell hook can prove the executable and
# an explicit literal path here, but it cannot know what an arbitrary package
# script will eventually invoke.
_PRETTIER_COMMAND_RE = re.compile(
    r'(?:^|[;&|\n]\s*)'
    r'(?:(?:npx|pnpm\s+exec|yarn\s+(?:exec|dlx)|bunx)\s+)?'
    r'(?:\S*/)?prettier(?=\s|$)([^;&|\n]*)',
    re.IGNORECASE,
)
_PRETTIER_WRITE_FLAG_RE = re.compile(r'^(?:--write|-w)$', re.IGNORECASE)
_PRETTIER_CHECK_FLAG_RE = re.compile(r'^--check$', re.IGNORECASE)

# Prettier options whose next token is an option value rather than a file to
# format.  An option value may itself be an in-tree path (`--config foo.mjs`),
# so treating every non-flag token as a write target would create a false deny.
# `--name=value` forms are skipped generically below.
_PRETTIER_VALUE_OPTIONS = {
    '--arrow-parens', '--bracket-same-line', '--cursor-offset', '--end-of-line',
    '--html-whitespace-sensitivity', '--ignore-path', '--loglevel', '--parser',
    '--plugin', '--plugin-search-dir', '--print-width', '--prose-wrap',
    '--range-end', '--range-start', '--tab-width', '--trailing-comma',
    '--use-tabs', '--cache-location', '--config', '--stdin-filepath',
}


def _prettier_write_targets(seg):
    """Return explicit literal positional targets from a Prettier argv tail.

    This is intentionally an argv-shaped scan, not a Prettier parser.  It only
    returns tokens after a real `--write`/`-w`, skips known option values, and
    stops trusting expansion/glob-bearing tokens at `_resolve_write_target`.
    Unknown options are treated as flags (not as target values) so a future
    boolean option cannot make the guard consume the following file path as an
    option value; recognized value-taking options cover the current CLI's path-
    bearing forms.
    """
    try:
        _tokens = _strip_redirect_tokens(seg.split())
    except Exception:
        return []
    if not any(_PRETTIER_WRITE_FLAG_RE.match(_tok) for _tok in _tokens):
        return []
    _targets, _write_seen, _after_double_dash, _skip_value = [], False, False, False
    for _tok in _tokens:
        if _skip_value:
            _skip_value = False
            continue
        if not _after_double_dash and _tok == '--':
            _after_double_dash = True
            continue
        if not _after_double_dash and _PRETTIER_WRITE_FLAG_RE.match(_tok):
            _write_seen = True
            continue
        if not _after_double_dash and _tok.startswith('-'):
            if '=' not in _tok and _tok.lower() in _PRETTIER_VALUE_OPTIONS:
                _skip_value = True
            continue
        if _write_seen:
            _targets.append(_tok)
    return _targets


# EI-20511008504632401 — the release helpers contain an intentionally legacy
# formatting baseline.  An unconfigured `npx prettier --check` reports that
# baseline as dirty, and the obvious follow-up (`--write`) creates broad,
# unrelated churn during a focused repair.  Keep this guard narrow: it only
# applies to `--check`, only to the release helper tree, and an explicit
# `--config` opts into the caller's known formatter configuration.
def _prettier_check_targets(seg):
    """Return positional Prettier check targets when no config was supplied."""
    try:
        _tokens = _strip_redirect_tokens(seg.split())
    except Exception:
        return []
    if not any(_PRETTIER_CHECK_FLAG_RE.match(_tok) for _tok in _tokens):
        return []
    if any(_tok.lower() == '--config' or _tok.lower().startswith('--config=')
           for _tok in _tokens):
        return []
    _targets, _after_double_dash, _skip_value = [], False, False
    for _tok in _tokens:
        if _skip_value:
            _skip_value = False
            continue
        if not _after_double_dash and _tok == '--':
            _after_double_dash = True
            continue
        if not _after_double_dash and _tok.startswith('-'):
            if '=' not in _tok and _tok.lower() in _PRETTIER_VALUE_OPTIONS:
                _skip_value = True
            continue
        _targets.append(_tok)
    return _targets


# EI-18763270524857214: a `cd <dir>` earlier in the SAME compound command
# changes the cwd every later relative target actually resolves against — the
# guard was resolving every target against the session's STARTING cwd
# regardless, so `cd /tmp/probe && ... > relative.md` (the sanctioned
# out-of-tree scratch-work idiom) got told its target "resolves INSIDE the
# shared staging tree" as flat fact, when it plainly did not: the preceding
# `cd` moved cwd out of the tree first. Filed by an agent doing the CAREFUL
# thing (building a probe in /tmp specifically to avoid dirtying the tree) —
# a false reading stated as established fact sends the reader hunting a
# cwd-drift bug that never happened.
#
# Best-effort replay, not a real shell: walk every `cd <target>` occurring
# BEFORE a given position and fold it into a running cwd, same literal-path
# safety net as `_resolve_write_target` (an unresolvable target — expansion,
# unreadable — makes everything from there on UNKNOWN, at which point this
# bails to the ORIGINAL session cwd rather than guess, so it can only ever
# make the guard MORE accurate, never quietly disable it).
#
# Deliberately inert whenever the command contains ANY paren: a `cd` inside a
# `(subshell)` does not leak its cwd change past the closing `)`, and this
# replay has no paren-depth tracking to know that — folding a subshell-scoped
# `cd` into the outer cwd could turn a genuine in-tree write into a false
# ALLOW, which is a strictly worse failure than the stale-cwd false DENY this
# is fixing. `$(...)` command substitution shares the same `(`/`)` characters,
# so this also — harmlessly — sits out whenever one of those appears anywhere
# in the command; the guard just falls back to its original (correct, if
# occasionally over-cautious) behavior in that case.
#
# `cd` only counts as a REAL invocation when it starts a statement — preceded
# by nothing, a `;`, a newline, `&&`, or `||`. Without this a bare mention of
# the word (`echo cd /tmp`, `echo "please cd to /tmp first"`) would read as an
# actual directory change and could fold a FAKE cwd move into the replay —
# the same "worse than the false deny" shape as the subshell case above, just
# via ordinary text instead of a paren.
_CD_RE = re.compile(r'(?:\A|[;\n]|&&|\|\|)\s*cd\s+(\S+)')


def _cd_arg_unresolvable(target):
    # A QUOTED cd argument containing a space (`cd "/tmp/some dir"`) was
    # already collapsed to a single space by quote-stripping upstream, so the
    # `\S+` in _CD_RE can land on leftover operator debris instead (`&&`, `;`)
    # rather than the real target — treat that as unresolvable rather than
    # fold operator text into a replayed cwd as if it were a directory. Same
    # for any expansion: this guard resolves LITERAL paths only, everywhere.
    #
    # ONE predicate, deliberately shared by the replay below and by
    # `_unfollowed_cd_before` (EI-20106159536811878). The replay decides
    # POLICY (where the write is judged to land); the note decides the
    # MESSAGE (why the guard could not follow you). Were those two to drift
    # apart, the agent would be told a story that does not match the
    # decision — which is the precise failure that produced six separate
    # reports of this one defect.
    return (not target) or bool(re.fullmatch(r'[&|;<>]+', target)) or any(
        ch in target for ch in ('$', '`', '~', '*', '?', '[')
    )


def _effective_cwd_before(pos, base_cwd, clean, has_paren):
    if has_paren:
        return base_cwd
    _cwd = base_cwd
    for _m in _CD_RE.finditer(clean[:pos]):
        _target = _m.group(1)
        if _cd_arg_unresolvable(_target):
            return base_cwd  # can't tell where cwd ended up — don't guess
        try:
            _cwd = _target if os.path.isabs(_target) else os.path.realpath(os.path.join(_cwd, _target))
        except Exception:
            return base_cwd
    return _cwd


def _unfollowed_cd_before(pos, clean, has_paren):
    # WHY the replay above gave up, for the MESSAGE only — never for the
    # decision. 'subshell' when a paren suppressed the whole replay,
    # 'expansion' when a cd argument was not a literal path. None when there
    # was no `cd` before `pos` at all, or every one of them was followed —
    # in which case the resolved path is trustworthy and needs no excuse.
    for _m in _CD_RE.finditer(clean[:pos]):
        if has_paren:
            return 'subshell'
        if _cd_arg_unresolvable(_m.group(1)):
            return 'expansion'
    return None


def _relative_target_cd_note(raw_target, pos, clean, has_paren):
    # EI-20106159536811878 (+ WI-7219 and four more reports of this one
    # defect): the guard resolves a RELATIVE target against the SESSION cwd
    # whenever it cannot follow a `cd`, then reports it as "resolves INSIDE
    # the shared staging tree" — true of the string it computed, false about
    # where the write would actually land. Every reporter read that message
    # and concluded the guard was broken rather than that their path needed
    # to be absolute, because nothing in the text mentions cwd, `cd`, or
    # relativity. It fires hardest on the workflow CLAUDE.md prescribes
    # ("never mutate the shared tree to prove a guard falsifiable"), whose
    # probes must mirror the real layout — so repo-shaped relative paths
    # under a /tmp cwd are the NORMAL shape of the careful thing, not an odd
    # one.
    #
    # The remedy is deliberately in the MESSAGE, not the policy. When the cd
    # argument is an expansion (`cd "$T"`) NO static scan can know where it
    # went, so refusing is correct and permanent; what was missing is saying
    # WHY, and that an absolute target passes.
    #
    # The cd argument is NOT quoted back: `cd "$T"` reaches us as the
    # operator debris `||` (quote-stripping blanked the whole span), so
    # naming it would print a confidently wrong token — this file's oldest
    # and most expensive failure mode.
    if os.path.isabs(raw_target):
        return ''
    _why = _unfollowed_cd_before(pos, clean, has_paren)
    if not _why:
        return ''
    return (
        'THIS IS MOST LIKELY THE WHOLE PROBLEM: `%s` is a RELATIVE path and this command '
        'contains a `cd` the guard could not follow (%s), so it was resolved against your '
        'SESSION cwd — which is in the tree — and NOT against the directory you actually '
        'changed to. If this write is genuinely out-of-tree scratch, re-issue it with an '
        'ABSOLUTE target (`"$T/%s"`, where `$T` is the directory you cd-ed to, rather than '
        'the bare `%s`) and it passes unchanged. '
        % (
            raw_target,
            # Both branches are worded to claim only what the guard actually
            # established. It did NOT determine that your `cd` sits inside a
            # subshell — only that SOME paren appears somewhere in the
            # command, which switches the replay off wholesale; saying more
            # would be the same overclaiming this note exists to correct.
            'its argument is not a literal path it can resolve — an expansion like `$T`, '
            'or a quoted span the normalizer has already blanked'
            if _why == 'expansion'
            else 'this command contains `(`/`)` somewhere, and a subshell directory change '
                 'does not outlive its closing paren, so the replay is switched off wholesale',
            raw_target,
            raw_target,
        )
    )


def _shell_write_guard():
    global ADVISORY, _PENDING_SHELL_WRITE_ADVISORY
    _canon = _canonical_tree_root()
    if not _canon:
        return
    try:
        _cwd = os.path.realpath(payload.get('cwd') or os.getcwd())
    except Exception:
        return
    _clean = _strip_quotes_and_comments(
        _strip_heredoc_bodies(command), preserve_expansions=True
    )
    # The raw redirect scan must see shell writes inside `$()` but not confuse
    # PostgreSQL JSON `->`/`->>` operators in a nested `psql` expression with
    # redirects.  This pass preserves all other text and all match offsets.
    _clean = _mask_postgres_json_arrows_in_substitutions(_clean)
    _has_paren = '(' in _clean or ')' in _clean
    _targets = []  # (raw_target, human-readable construct name, position in _clean)
    # EI-19966359020779598 — set when an in-place-write construct's target
    # COULD NOT be checked because it is a bare variable reference (see the
    # loop below, after `_resolve_write_target` bails). Advisory-only; see the
    # comment above the ADVISORY assignment at the end of this function for
    # why this is scoped to a bare `$VAR` and not the `$(...)`/backtick shapes
    # `_segment_has_unsplittable_expansion` already (deliberately) fails open
    # on with no signal at all.
    _saw_unresolvable_inplace_target = False

    # `>`/`>>` redirects. The lookahead excludes fd-duplication/comparison
    # forms (`2>&1`, `>=`, `2>&2`) and the lookbehind excludes a JavaScript
    # fat-arrow (`=>`), so those never get misread as file targets. A real
    # redirect may be adjacent to a command token (`cat>file`), so this only
    # rejects the known comparison/arrow prefix rather than requiring whitespace.
    #
    # EI-18899608047558048: the gap between the operator and its target is
    # `[^\S\n]*` (same-LINE whitespace only), NOT `\s*`. `_strip_quotes_and_comments`
    # replaces an ENTIRE quoted span — `"$OUT"`, `'literal.txt'` — with a
    # single blank space, with no marker left behind that anything was ever
    # there. So a redirect whose target was fully quoted (`: > "$OUT"`, `printf
    # ... >> "$OUT"`) leaves nothing but trailing whitespace after the
    # operator on that line — and a bare `\s*` happily crosses the following
    # newline to grab the FIRST TOKEN OF THE NEXT STATEMENT as if it were the
    # redirect's target (`URL=` from an unrelated following assignment, or
    # `done` closing a loop body). That is worse than a false negative: it
    # names a plausible-looking but WRONG path with the same confident wording
    # used for a real catch, sending the reader hunting a cwd-drift bug that
    # never happened. Restricting the gap to same-line whitespace makes the
    # match fail to find a target at all in that case — the correct fail-open,
    # matching this guard's existing "unsafe to resolve without actually
    # running the shell" policy for any other unresolvable target.
    for _m in re.finditer(r'(?<![=])\d*(>{1,2})(?![&=])[^\S\n]*([^\s;&|()<>]+)', _clean):
        if not _looks_like_redirect_path(_m.group(2)):
            continue
        _targets.append((_m.group(2), 'shell redirect (`%s`)' % _m.group(1), _m.start(2)))

    # `tee [-a] FILE...`
    for _m in re.finditer(r'\btee\b([^;&|\n]*)', _clean):
        if _segment_has_unsplittable_expansion(_m.group(1)):
            continue
        for _tok in _strip_redirect_tokens(_m.group(1).split()):
            if not _tok.startswith('-'):
                _targets.append((_tok, '`tee`', _m.start()))

    # `sed -i[.bak] ... FILE...` / `sed --in-place ... FILE...` — quote-
    # stripping already erased a quoted script, so treat every remaining
    # non-flag token as a target candidate (harmless if one is actually the
    # unquoted script text: a real target among them still triggers the deny).
    for _m in re.finditer(r'\bsed\b([^;&|\n]*)', _clean):
        _seg = _m.group(1)
        if not _has_inplace_flag(_seg, 'sed'):
            continue
        if _segment_has_unsplittable_expansion(_seg):
            continue
        for _tok in _strip_redirect_tokens(_seg.split()):
            if not _tok.startswith('-'):
                _targets.append((_tok, '`sed -i`', _m.start()))

    # `perl -i[.bak] FILE...` / `ruby -i[.bak] FILE...` — the same in-place
    # side door as `sed -i` above, just a different interpreter
    # (EI-18691482279179647: "the shell-write guard misses interpreter
    # writes" — this leg is the in-place-flag half of that fix; the other
    # half, an interpreter's OWN open()/writeFileSync() call inside inline
    # code, is a different shape and handled by _interpreter_write_guard
    # below since there is no shell-level flag to key on there).
    # `awk -i inplace ... FILE...` (EI-18809538554039853). gawk's in-place edit is
    # NOT a bundled flag like the others — `-i` is the generic "include a library"
    # option and the rewrite only happens for the `inplace` library specifically, so
    # this keys on that library NAME rather than on the flag. Keying on a bare `-i`
    # here would deny every unrelated `awk -i <lib>`. Also accepts the long spelling
    # (`--include inplace`) and the attached forms (`-iinplace`, `--include=inplace`).
    for _m in re.finditer(r'\b(?:g?awk)\b([^;&|\n]*)', _clean):
        _seg = _m.group(1)
        if not re.search(r'(?:^|\s)(?:-i\s*|--include(?:=|\s+))inplace\b', _seg):
            continue
        if _segment_has_unsplittable_expansion(_seg):
            continue
        for _tok in _strip_redirect_tokens(_seg.split()):
            # `inplace` is the library operand, not a target.
            if not _tok.startswith('-') and _tok != 'inplace':
                _targets.append((_tok, '`awk -i inplace`', _m.start()))

    for _m in re.finditer(r'\b(perl|ruby)\b([^;&|\n]*)', _clean):
        _seg = _m.group(2)
        if not _has_inplace_flag(_seg, _m.group(1)):
            continue
        if _segment_has_unsplittable_expansion(_seg):
            continue
        for _tok in _strip_redirect_tokens(_seg.split()):
            if not _tok.startswith('-'):
                _targets.append((_tok, '`perl -i`/`ruby -i`', _m.start()))

    # `cp SRC... DEST` — the last positional (non-flag) token is the
    # destination. Match `cp` only at a shell command position (the start of
    # the command or immediately after one or more unquoted shell separators),
    # not as a free-floating substring in an argument such as
    # `/tmp/wi40939-cp-addendum.json`. The old unanchored `\bcp\b` scan treated
    # that filename as the command and then misread a later numeric option
    # value (for example `--port 3170`) as an in-tree destination (EI-21568513340286684).
    # Skipped for a recursive/archive copy (`-r`/`-R`/`-a`/`--recursive`/
    # `--archive`): a directory copy has no single-file Edit/Write substitute,
    # so there is nothing safe to redirect this to.
    for _m in re.finditer(r'(?:^|[;&|\n]+[ \t]*)cp\b([^;&|\n]*)', _clean):
        if _segment_has_unsplittable_expansion(_m.group(1)):
            continue
        _toks = _m.group(1).split()
        if any(re.match(r'-[a-zA-Z]*[rRa][a-zA-Z]*$|--recursive$|--archive$', t)
               for t in _toks if t.startswith('-')):
            continue
        _pos = [t for t in _strip_redirect_tokens(_toks) if not t.startswith('-')]
        if len(_pos) >= 2:
            _targets.append((_pos[-1], '`cp`', _m.start()))

    # An unconfigured whole-file `prettier --check` against the legacy release
    # helpers is not useful focused-repair verification: it reports pre-existing
    # drift and nudges the caller toward broad `--write` churn.  Refuse only the
    # release helper subtree and only when no explicit formatter config is given;
    # `--write` remains covered by the in-place shell-write guard below.
    _prettier_release_root = os.path.realpath(os.path.join(
        _canon, 'apps', 'operator', 'lib', 'release'
    ))
    for _m in _PRETTIER_COMMAND_RE.finditer(_clean):
        for _tok in _prettier_check_targets(_m.group(1)):
            _effective_cwd = _effective_cwd_before(_m.start(), _cwd, _clean, _has_paren)
            _resolved = _resolve_write_target(_tok, _effective_cwd)
            if (_resolved and (_resolved == _prettier_release_root
                               or _resolved.startswith(_prettier_release_root + os.sep))):
                _DENY_VIEW['clean'], _DENY_VIEW['at'] = _clean, _m.start()
                _DENY_VIEW['inReason'] = True  # shell text — safe to quote back
                deny(
                    'Prettier check guard (EI-20511008504632401): this unconfigured '
                    '`prettier --check` targets `%s` under `apps/operator/lib/release`. '
                    'That legacy formatting baseline can report pre-existing drift and '
                    'turn a focused repair into broad unrelated `--write` churn. Use '
                    '`git diff --check` or a hunk-scoped formatter check instead. If a '
                    'whole-file Prettier check is genuinely required, re-issue it with '
                    'an explicit `--config <path>`. NOTHING in this Bash call ran — the '
                    'whole command was rejected before execution.' % _tok
                )

    # `prettier --write FILE` / `prettier -w FILE` — unlike `--check`, these
    # mutate each positional file in place.  This catches the common `npx`
    # / package-manager execution forms covered by `_PRETTIER_COMMAND_RE`,
    # while leaving arbitrary `npm run format` scripts to their own tooling.
    for _m in _PRETTIER_COMMAND_RE.finditer(_clean):
        for _tok in _prettier_write_targets(_m.group(1)):
            _targets.append((_tok, '`prettier --write`/`-w`', _m.start()))

    for _raw, _construct, _at in _targets:
        _effective_cwd = _effective_cwd_before(_at, _cwd, _clean, _has_paren)
        _resolved = _resolve_write_target(_raw, _effective_cwd)
        if (_resolved and (_resolved == _canon or _resolved.startswith(_canon + os.sep))
                and not _is_sanctioned_scratch(_resolved, _canon)):
            # Hand the normalized text + match offset to deny() so the reason
            # shows WHAT was matched, not just where it resolved to
            # (EI-19421518638516187).
            _DENY_VIEW['clean'], _DENY_VIEW['at'] = _clean, _at
            _DENY_VIEW['inReason'] = True  # shell text — safe to quote back
            deny(
                'shell-write guard (EI-18664655909328670): this %s targets `%s`, which '
                'resolves INSIDE the shared staging tree. Raw shell writes to tree files '
                'skip the file-lock hook entirely, and if your session cwd has silently '
                'drifted they create a stray file with no error (a follow-up test run '
                'then reports green against the wrong path — exactly how a near-miss '
                'stray got one tick from being committed on 2026-07-25). Use the Edit or '
                'Write tool instead — they claim the lock and validate the worktree for '
                'you (for a copy: Read the source, then Write the destination). '
                '%s'
                '%s'
                'NOTHING in this Bash call ran — the whole '
                'command was rejected before execution (EI-18760311552821358), including '
                'any earlier statement in a `&&`/`;`-chained compound command (e.g. a '
                'leading heredoc write) — re-issue the whole command after fixing the '
                'target, do not assume an earlier part of it already ran.'
                % (_construct, _raw, _relative_target_cd_note(_raw, _at, _clean, _has_paren),
                   _SCRATCH_REMEDY)
            )
        # EI-19966359020779598 — `_resolve_write_target` bailed on `_raw`
        # because it carries an expansion marker ($/`/~/*/?/[), the same
        # LITERAL-PATHS-ONLY policy this whole guard has always used. That
        # policy is right for a REDIRECT target (`> "$LOG"` overwhelmingly
        # writes a scratch/log path outside the tree, and denying it on a
        # guess would reopen this file's own well-documented false-positive
        # history) — so this is scoped to the IN-PLACE-REWRITE family
        # (`sed -i`/`perl -i`/`ruby -i`/`awk -i inplace`/`tee`/`cp`), never a
        # plain shell redirect. Filed repro: `FILES=$(ls *.ts); sed -i
        # 's/a/b/' $FILES` — `$FILES` is a BARE variable (no parens/backtick),
        # so `_segment_has_unsplittable_expansion` above does not skip it and
        # it reaches this loop as an ordinary candidate token; it silently
        # fails resolution here with ZERO signal today. A `$(...)`/backtick
        # target is a DIFFERENT, already-hardened case
        # (EI-18691980588797795): its own segment is skipped BEFORE reaching
        # `_targets` at all, because a substitution's raw text can contain
        # spaces that defeat the `.split()` these constructs use to find
        # their target(s) — false-DENYING on a garbled fragment cost real
        # incidents, and this fix must not reopen that (hence: advisory only,
        # and only for the bare-`$VAR` shape actually reaching this loop —
        # never touching the `_segment_has_unsplittable_expansion` skip
        # branches above).
        elif (not _resolved and not _construct.startswith('shell redirect')
              and any(ch in _raw for ch in ('$', '`', '~', '*', '?', '['))):
            _saw_unresolvable_inplace_target = True

    if _saw_unresolvable_inplace_target and not ADVISORY:
        _PENDING_SHELL_WRITE_ADVISORY = (
            'shell-write guard notice (EI-19966359020779598, extends '
            'EI-18664655909328670): this command runs an in-place-rewrite/`tee`/`cp` '
            'construct whose target is a shell variable, `~`, or a glob — not a '
            'literal path. This guard only recognizes a literal path token; a '
            'variable-driven target list (e.g. `FILES=$(ls *.ts); sed -i \'s/a/b/\' '
            '$FILES`) is invisible to it, the same "honest limit" already documented '
            'for interpreter writes (EI-18828866497684686). Raw shell writes skip the '
            'file-lock hook entirely — if this write actually lands inside the shared '
            'staging tree, no lock is being claimed and no denial will fire for it. If '
            'you have not already verified the expanded file list yourself, prefer '
            'Edit/Write per file (they claim the lock for you), or claim the resolved '
            'paths yourself first: locks:acquire { paths, intent }. Advisory only; '
            'this command is proceeding as issued.'
        )


try:
    _shell_write_guard()
except Exception:
    pass  # guard must never wedge a command

# ── Tracked structural-mutation classifier (EI-21567270631276419) ──────────
# Native Edit/Write calls claim a file lock, whose server path enforces GOAL
# mode's never-implement contract. Bash-side renames/deletes never reach that
# hook: a `git mv` can succeed and leave a half-renamed tree before the next
# native Edit is correctly refused. Classify the missing shell operations here,
# then send ONE boolean on the existing locks:check_command round-trip; the
# server reuses the same registered-mode + flag decision as native edits.
#
# LITERAL + TRACKED ONLY. Unknown cwd, shell expansions, option ambiguity, or a
# failed `git ls-files` probe all fail open. `cp` is intentionally absent: the
# shell-write guard above already denies every literal in-tree copy destination,
# independent of mode. This classifier covers `git mv`, `git rm`, and plain
# `mv` when a source or destination is a tracked path in the canonical tree.
_TRACKED_MUTATION = False


def _tracked_repo_path(raw, cwd, canon):
    """Return a canonical repo-relative literal path, else None."""
    resolved = _resolve_write_target(raw, cwd)
    if not resolved or not canon:
        return None
    if resolved == canon:
        return ''
    if not resolved.startswith(canon + os.sep):
        return None
    return os.path.relpath(resolved, canon).replace(os.sep, '/')


def _is_tracked_path(canon, rel):
    if not canon or not rel:
        return False
    try:
        import subprocess
        if subprocess.run(
            ['git', '-C', canon, 'ls-files', '--error-unmatch', '--', rel],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        ).returncode == 0:
            return True
        # WI-10005009: git-sync rewrites .git/index every sweep, and a half-written
        # index answers "not tracked" for a tracked path, byte-for-byte like an
        # untracked one. Here that is the UNSAFE direction (a tracked mutation slips
        # past the gate), so ask HEAD's tree, which cannot be torn, before believing it.
        head = subprocess.run(
            ['git', '-C', canon, '--literal-pathspecs', 'ls-tree', '-z',
             '--name-only', 'HEAD', '--', rel],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )
        return head.returncode == 0 and len(head.stdout) > 0
    except Exception:
        return False


def _git_command_tail(words, cwd):
    """(words after git globals, effective -C cwd), or ([], None) if ambiguous."""
    if not words or words[0].split('/')[-1] != 'git':
        return [], None
    i = 1
    effective_cwd = cwd
    while i < len(words):
        word = words[i]
        if word == '--':
            return words[i + 1:], effective_cwd
        if not word.startswith('-') or word == '-':
            return words[i:], effective_cwd
        key = word.split('=', 1)[0]
        if key == '-C':
            if '=' in word:
                target = word.split('=', 1)[1]
                i += 1
            elif i + 1 < len(words):
                target = words[i + 1]
                i += 2
            else:
                return [], None
            resolved = _resolve_write_target(target, effective_cwd)
            if not resolved:
                return [], None
            effective_cwd = resolved
        elif key == '-c' and '=' not in word:
            i += 2
        elif key == '-c':
            i += 1
        elif key in ('--git-dir', '--work-tree', '--namespace', '--config-env'):
            # These can redirect path interpretation away from cwd. Static
            # classification cannot prove the target tree, so fail open.
            return [], None
        else:
            i += 1
    return [], None


def _literal_positionals(words):
    """Conservative positional extraction for mv/rm-like argv tails."""
    out, after_dash = [], False
    value_opts = {'-t', '--target-directory', '-S', '--suffix'}
    i = 0
    while i < len(words):
        word = words[i]
        if word == '--':
            after_dash = True
            i += 1
            continue
        if not after_dash and word.startswith('-') and word != '-':
            key = word.split('=', 1)[0]
            if key in value_opts and '=' not in word:
                i += 2
            else:
                i += 1
            continue
        out.append(word)
        i += 1
    return out


def _classify_tracked_mutation():
    canon = _canonical_tree_root()
    if not canon:
        return False
    try:
        base_cwd = os.path.realpath(payload.get('cwd') or os.getcwd())
    except Exception:
        return False

    # `_scannable()` already appends recursively-unwrapped shell payloads as
    # newline-separated commands, so bash -c / timeout / env wrapper forms are
    # covered without another wrapper-name list here.
    commands, _nested = _scan_shell(_scannable())
    for words in commands:
        start = _scan_command_start(words)
        if start >= len(words):
            continue
        argv = words[start:]
        exe = argv[0].split('/')[-1]
        op, operands = None, []
        if exe == 'git':
            tail, command_cwd = _git_command_tail(argv, base_cwd)
            if not tail or tail[0] not in ('mv', 'rm'):
                continue
            op = 'git ' + tail[0]
            operands = _literal_positionals(tail[1:])
        elif exe == 'mv':
            op = 'mv'
            command_cwd = base_cwd
            operands = _literal_positionals(argv[1:])
        else:
            continue
        if not operands:
            continue
        rels = [_tracked_repo_path(raw, command_cwd, canon) for raw in operands]
        if any(rel and _is_tracked_path(canon, rel) for rel in rels):
            return True
        # A rename to a new path is still a tracked mutation when its SOURCE is
        # tracked; the all-operands scan above covers that source naturally.
        if op == 'mv' and len(rels) >= 2 and any(
                rel and _is_tracked_path(canon, rel) for rel in rels[:-1]):
            return True
    return False


try:
    _TRACKED_MUTATION = _classify_tracked_mutation()
except Exception:
    _TRACKED_MUTATION = False  # classifier failure must never wedge Bash

# ── cd + EXIT-trap/restore path-drift advisory (EI-19409854431997137) ──────
# The standard "mutate a file to confirm a guard/test actually goes red, then
# restore it" idiom captures its restore path ONCE, before any `cd`:
#
#     cp "$F" /tmp/restore.ts
#     trap 'cp /tmp/restore.ts '"$F"'' EXIT
#     <mutate $F>
#     cd apps/operator && npx vitest run ...      # changes cwd mid-command
#     cp /tmp/restore.ts "$F"
#
# When $F is relative (or a variable holding a relative path), the `cd` in the
# middle silently breaks BOTH the explicit restore line and the EXIT trap:
# each resolves $F against the NEW cwd, not the one it was relative to when
# set. Caught live 2026-08-03: the restore failed with `cp: cannot create
# regular file …: No such file or directory`, and the mutated (deliberately
# failing) test file was left in the shared tree — one git-sync tick from
# being committed and red-pinning the fleet gate. The failure is silent in
# the direction that matters: `cp`'s error is buried under a long,
# intentionally-failing test run's own noisy output, at exactly the moment
# the reader is expecting a failure (that IS the experiment), so a red exit
# reads as "the mutation worked", not "the restore didn't". An EXIT trap
# gives false confidence here — it was armed correctly and still failed, for
# a reason trap syntax cannot express: it captured the PATH TEXT, not the cwd
# it should resolve against.
#
# SOFT/ADVISORY (never blocks) — unlike the shell-write guard above, this
# never tries to resolve where a target actually lands: the hazard fires even
# when the target is a bare `$VAR`, which the shell-write guard's
# LITERAL-PATHS-ONLY policy always fails open on, so it would never catch the
# incident above (`$F` is a variable, not a literal path).
#
# Deliberately inert whenever the command contains ANY paren, same convention
# as `_effective_cwd_before` above: a subshell can scope a `cd` so it never
# leaks past the closing `)`, and this advisory does no paren-depth tracking
# to tell a scoped `cd` from a real one — exactly the "Correct forms" fix the
# advisory text below recommends (`( cd apps/operator && npx vitest … )`).
#
# Also inert when the whole command already anchors a restore variable
# absolutely (`F=$(git rev-parse --show-toplevel)/…`, `F=$PWD/…`, …) — the
# OTHER "Correct forms" fix. This is a coarse, whole-command check (it does
# not trace which variable the anchor feeds), but a command that already
# demonstrates this idiom anywhere has shown awareness of the exact hazard
# this advisory exists to name, so nagging it further is pure noise.
_ABS_ANCHOR_ASSIGN_RE = re.compile(
    r'=\s*"?\$\(\s*(?:git\s+rev-parse\s+--show-toplevel|pwd)\s*\)'
    r'|=\s*"?\$\{?(?:PWD|OLDPWD)\}?"?(?:$|[\s/])'
)


def _quote_preserve_tokens(s):
    """Like `_strip_quotes_and_comments`, but a quoted span becomes a single
    placeholder TOKEN (`\x00Q\x00`) instead of a blank. `_strip_quotes_and_comments`
    is right for operator-boundary scanning (a quoted `;`/`&`/`|` must not
    read as a real separator) but WRONG for a POSITIONAL-ARGUMENT COUNT (`cp
    SRC DEST`): collapsing a quoted arg (`"$F"`) to a blank makes it vanish
    from `.split()` entirely, silently undercounting `cp`/`mv`'s destination
    — exactly the common shape of the restore idiom this advisory targets.
    A placeholder token keeps the count right while staying just as inert
    against operator/keyword injection from inside the quotes.

    COMMENTS (EI-19423080880635119). Third and last member of the parity family
    fixed by EI-19420133701663526, and the only one that is not a deny guard:
    this feeds an ADVISORY's positional-argument count, so a parity break here
    can never cause a missed DENY — it can only mis-count arguments. It failed
    the same way its siblings did, though: an odd quote inside a `#` comment
    paired with the opening quote of a real later argument, so the span
    `"` + newline + `cp /tmp/restore.ts "` collapsed to ONE placeholder and the
    restore `cp` vanished entirely — the advisory went silent on exactly the
    shape it exists to catch. Single-pass, comment-first, same rule as the
    siblings; the newline is left intact because callers split on it.

    The `out[-1].isspace()` test is lifted VERBATIM and that is deliberate,
    despite this function appending a multi-character chunk (` \x00Q\x00 `)
    where the siblings append a single space. Do not "fix" it to inspect the
    chunk's last character: a whole-chunk test reports False right after a
    quoted span, which is what makes `cp "$F"# dest.ts` keep its `#` as word
    text — matching bash, where `#` introduces a comment only at the start of a
    word. Testing the chunk's final character would call that a comment and
    swallow the destination, dropping the count to 1 and silencing the advisory.
    An ordinary `cp "$F" # note` is unaffected either way: the space after the
    closing quote is its own single-character chunk."""
    out, i, n = [], 0, len(s)
    while i < n:
        c = s[i]
        if c == '#' and (not out or out[-1].isspace()):
            j = s.find('\n', i)
            if j == -1:
                break  # comment runs to end of input — nothing after it
            i = j      # leave the newline itself as a real separator
            continue
        if c == "'":
            j = s.find("'", i + 1)
            if j == -1:
                break
            out.append(' \x00Q\x00 ')
            i = j + 1
        elif c == '"':
            j = i + 1
            while j < n:
                if s[j] == '\\':
                    j += 2
                    continue
                if s[j] == '"':
                    break
                j += 1
            if j >= n:
                break
            out.append(' \x00Q\x00 ')
            i = j + 1
        else:
            out.append(c)
            i += 1
    return ''.join(out)


try:
    if (not ADVISORY and '(' not in command and ')' not in command
            and not _ABS_ANCHOR_ASSIGN_RE.search(command)):
        _cdtrap_clean = _quote_preserve_tokens(_strip_heredoc_bodies(command))
        _cd_m = _CD_RE.search(_cdtrap_clean)
        if _cd_m:
            _has_exit_trap = bool(
                re.search(r'\btrap\b[^\n]*\b(?:EXIT|0)\b', _cdtrap_clean))
            _cprestore_after_cd = None
            for _m in re.finditer(r'\b(cp|mv)\b([^;&|\n]*)', _cdtrap_clean):
                if _m.start() <= _cd_m.end():
                    continue  # precedes (or is) the cd — e.g. the initial backup, not at risk
                if _segment_has_unsplittable_expansion(_m.group(2)):
                    continue
                _toks = [t for t in _strip_redirect_tokens(_m.group(2).split())
                         if not t.startswith('-')]
                if len(_toks) < 2:
                    continue
                # Already cwd-independent (absolute, `~`, or a `$(...)`/$PWD/
                # $OLDPWD-anchored computation) written INLINE at the call
                # site — the whole-command anchor check above already caught
                # the assign-then-reference form; this catches the same fix
                # spelled directly in the cp/mv argument.
                if re.match(r'^(?:/|~|\$\(|\$\{?(?:PWD|OLDPWD)\}?)', _toks[-1]):
                    continue
                _cprestore_after_cd = _m.group(1)
                break
            if _has_exit_trap or _cprestore_after_cd:
                _why = ('an EXIT trap' if _has_exit_trap
                        else ('a `%s` after the cd' % _cprestore_after_cd))
                ADVISORY = (
                    'cd + restore-path drift advisory (EI-19409854431997137): this command '
                    'contains a `cd` AND ' + _why + ' — a restore/trap path captured before '
                    'the cd (a relative path, or a variable holding one) resolves against the '
                    'WRONG cwd once the cd runs, so the restore can fail SILENTLY (buried '
                    'under a long run\'s own output) while a mutated file stays in the shared '
                    'tree, one git-sync tick from being committed. Fixes: use an ABSOLUTE '
                    'restore path (`F=$(git rev-parse --show-toplevel)/path/to/file`), or keep '
                    'the `cd` scoped to a subshell that never touches the restore '
                    '(`( cd apps/operator && npx vitest … )`), or restore via `git checkout -- '
                    '<that one file>` instead of a /tmp copy. Advisory only; this command is '
                    'proceeding as issued.'
                )
except Exception:
    pass  # advisory must never wedge a command

# The shell-write scanner deliberately runs first because a literal target can
# deny immediately. Its computed-target notice is softer, though, and a
# command can also match the more specific cd + restore-path advisory. Let the
# latter win; for its two documented safe forms (a subshell or an absolute
# restore anchor), keep both advisories silent. Only suppress when a restore
# operation follows a cd, so an unrelated command substitution/paren elsewhere
# cannot hide a useful shell-write notice.
try:
    if _PENDING_SHELL_WRITE_ADVISORY and not ADVISORY:
        _pending_cd_clean = _quote_preserve_tokens(_strip_heredoc_bodies(command))
        _pending_cd_m = re.search(
            r'(?:\A|[;(\n]|&&|\|\|)\s*cd\s+', _pending_cd_clean
        )
        _pending_restore_after_cd = bool(
            _pending_cd_m
            and re.search(r'\b(?:cp|mv)\b', _pending_cd_clean[_pending_cd_m.end():])
        )
        _pending_restore_is_safe = bool(
            _pending_restore_after_cd
            and (('(' in command or ')' in command)
                 or _ABS_ANCHOR_ASSIGN_RE.search(command))
        )
        if not _pending_restore_is_safe:
            ADVISORY = _PENDING_SHELL_WRITE_ADVISORY
except Exception:
    pass  # advisory must never wedge a command

# ── Interpreter inline-code write guard (EI-18691482279179647) ─────────────
# The shell-write guard above only knows SHELL write constructs (>, >>, tee,
# sed/perl/ruby -i, cp). An interpreter invoked with inline code — `python3
# -c "..."`, `node -e "..."`, or a `python3 - <<EOF ... EOF` stdin/heredoc
# script — does its own file I/O (open(...,'w'), fs.writeFileSync(...), …),
# which is not a shell redirect at all and is invisible to that guard.
#
# Self-caught 2026-07-26: rewriting a tree file via `python3 - <<EOF` (the
# target path spelled out literally inside the heredoc body) sailed straight
# through — no lock claimed, no worktree validation, exactly the state the
# shell-write guard exists to prevent. The interpreter rewrite ALSO mangled
# the file (a regex that dropped closing braces across 4 call sites) — Edit
# would have been both locked AND structurally safer, so this hole costs
# correctness, not just locking.
#
# LITERAL PATHS ONLY, same discipline as the shell-write guard: this never
# parses the interpreted language — it only checks whether a literal tree
# path substring appears as an ARGUMENT TO a recognized write-shaped/file-
# construct call (a `-c`/`-e` quoted argument, or a heredoc body that follows
# an interpreter invocation) — see EI-18814109122347052 below for why it is
# scoped to call arguments rather than the whole payload — AND that same
# payload contains a recognizable WRITE-shaped call. HONEST LIMIT (permanent,
# not a bug to fix later): an interpreter can always construct a path at
# runtime (string concatenation, an env var, a computed join), and a write
# call this heuristic doesn't recognize slips through too — no static scan of
# the command text can see either. The guard's value is catching the
# ordinary, literal, accidental case — precisely the case that produced both
# this near-miss and EI-18664655909328670's stray-file incident — not
# achieving completeness.
#
# SELF-CAUGHT DURING THIS OWN FIX (2026-07-26): the first version of this
# guard flagged ANY literal tree path in an inline-code payload, full stop —
# and immediately denied its OWN verification command, a read-only
# `python3 -c "... open(<this file>).read() ..."` syntax check with no write
# call anywhere. A read needs no lock; blocking it is pure false-positive
# friction with no safety upside, and a guard that fires on ordinary reads
# trains agents to route around it. The WRITE-indicator requirement below is
# the fix — same shape as the mistake this whole item exists to catch (an
# agent walking through a hole without noticing), just caught inside the fix
# instead of downstream of it.
# EI-18692070370140239 — THE SAME MISTAKE ONE LEVEL DOWN. The note above
# records the first false-positive round (the guard denied its own read-only
# `open(...).read()` syntax check) and the WRITE-indicator requirement that
# fixed it. The indicator ITSELF then over-matched: `\bwrite\w*\s*\(` matches
# ANY `.write(`, including sinks that never touch the filesystem — so a
# read-only `python3 -c 'import sys; sys.stdout.write("<a tree path>")'`,
# which merely PRINTS a string that happens to look like a tree path, was
# denied as an "interpreter write". Caught the same way as its predecessor:
# it denied an ordinary agent command that wrote nothing to the tree.
#
# The split below is the fix. A write to stdout/stderr is not a file write,
# and a bare `.write(` is genuinely AMBIGUOUS (a file handle, an io.StringIO
# buffer, a socket, a response object — indistinguishable without dataflow
# this guard deliberately does not do). So a bare `.write(` counts only when
# the SAME inline body also shows a file object being opened. That is sound
# specifically because this guard only ever scans INLINE code (-c/-e/heredoc):
# a one-liner that writes a file has to open it in that same body. Named
# forms that are unambiguous on sight stay STANDALONE indicators below, so
# `Path("x").write_text(y)` and `fs.writeFileSync(...)` still deny.

# Sinks that are definitionally NOT the filesystem — removed from the body
# before any write-scan, so they can neither trip nor mask an indicator.
_NONFILE_WRITE_RE = re.compile(
    r'\b(?:sys|process)\s*\.\s*(?:stdout|stderr)\s*\.\s*write\w*\s*\('
)
# Unambiguous on sight — any one of these alone means a file write.
_WRITE_INDICATOR_RE = re.compile(
    r'\bopen\s*\([^)]*,\s*[\'"][waxWAX][b+t]?[\'"]'        # open(path, 'w'/'a'/'x'[b/t/+])
    r'|writeFileSync|appendFileSync|createWriteStream'      # node fs, common named forms
    r'|\bwrite_(?:text|bytes)\s*\('                         # pathlib Path.write_text/_bytes
    r'|\.save\s*\('                                        # common ORM/model .save(
    r'|(?:pickle|json|yaml)\.dump\s*\('                     # serialize-to-file idioms
    r'|shutil\.(?:copy|move)|os\.(?:rename|remove|replace)|unlink\s*\('
)
# Ambiguous alone — only a write indicator alongside a file-object construct.
_BARE_WRITE_CALL_RE = re.compile(r'\bwrite\w*\s*\(')
_FILE_OBJECT_RE = re.compile(
    r'\bopen\s*\(|\bPath\s*\(|\bfdopen\s*\(|\bNamedTemporaryFile\s*\('
)


def _body_indicates_file_write(body):
    # Non-file sinks are stripped FIRST: `sys.stdout.write(` must not satisfy
    # the bare-write test, and stripping it cannot hide a real write because
    # a real write is a separate call elsewhere in the body.
    scan = _NONFILE_WRITE_RE.sub('', body)
    if _WRITE_INDICATOR_RE.search(scan):
        return True
    return bool(_BARE_WRITE_CALL_RE.search(scan) and _FILE_OBJECT_RE.search(scan))
_INTERPRETER_RE = re.compile(r'(?:^|[\s;&|(])(?:[\w./-]*/)?(python3?|node|perl|ruby|deno|bun)(?=\s|$)')
_INLINE_CODE_FLAG_RE = re.compile(r'(?:^|\s)-[ce]\b')


def _extract_quoted_flag_bodies(cmd):
    # The quoted argument to a `-c`/`-e` flag (either quote style, DOTALL so
    # a multi-line script matches) — extracted from the RAW command, since
    # quote-stripping (used elsewhere to find command-position tokens) would
    # erase exactly the text this needs to scan.
    return [m.group(2) for m in re.finditer(r'-[ce]\s+([\'"])(.*?)\1', cmd, re.DOTALL)]


def _extract_heredoc_bodies(cmd):
    # The CAPTURED dual of _strip_heredoc_bodies above (which discards this
    # same text) — every heredoc BODY (between a `<<[-]DELIM` operator and
    # its closing DELIM line), for scanning instead of stripping.
    bodies = []
    i, n = 0, len(cmd)
    while i < n:
        m = _HEREDOC_START_RE.search(cmd, i)
        if not m:
            break
        line_end = cmd.find('\n', m.end())
        if line_end == -1:
            break
        delim = m.group(2)
        close_re = re.compile(r'^[ \t]*' + re.escape(delim) + r'\s*$', re.MULTILINE)
        cm = close_re.search(cmd, line_end + 1)
        if not cm:
            break  # unterminated — nothing safe to scan past here
        bodies.append(cmd[line_end + 1:cm.start()])
        i = cm.end()
    return bodies


# EI-18700825865251498: the quoted-literal scan below used to pair ANY quote
# CHARACTER with the next one of EITHER type (`['"]([^'"\n]+)['"]`), so it
# didn't recognize that a single `'` and a double `"` don't close each
# other's string. An apostrophe/contraction inside one string literal (or a
# nested differently-quoted literal, e.g. an f-string embedding `d['key']`)
# then paired with an unrelated quote character further along the SAME line,
# and the plain code text sitting between them — never a string literal at
# all — became the "matched path". Repro: a for-loop line whose real string
# literals were fine on their own produced the garbage capture
# " in ln: ln = ln.replace(" (a code fragment, not a path) purely because a
# quote of the other type appeared somewhere else on that line; that fragment
# contains a `.` (from `ln.replace`), which is all `_resolve_write_target`
# needs to resolve it — against a cwd inside the tree — into a false in-tree
# hit. Matching quotes of the SAME type only (two alternatives, not one
# type-agnostic class) fixes this: a stray apostrophe with no matching `'`
# later on the line simply fails to open a match at all, instead of being
# closed by an unrelated `"`.
_QUOTED_LITERAL_RE = re.compile(r'"([^"\n]*)"|\'([^\'\n]*)\'')

# EI-18828567391761902 — FIFTH in the not-a-path-resolved-as-one family, and
# the narrowing the family's own through-line calls for: "every widening of
# what counts as a 'path' must be paid for by a matching narrowing of what
# counts as a candidate." The predecessor narrowed candidates to whitespace-
# separated TOKENS, which left the token test itself as bare `[./]` — so any
# prose word carrying a period still qualified.
#
# It did. A mutation-control script searching for a docstring sentence held the
# literal 'newly refuse an independent sibling."""'; the token `sibling."""`
# contains a `.`, does not start with `/`, and so was joined onto an in-tree cwd
# as `<canon>/sibling."""` — "inside the tree". The command's only write sink was
# `open(dst,'w')` with dst=/tmp/..., so the write-indicator test was satisfied
# LEGITIMATELY and could not save it: the whole error was in path detection.
# The cost is not just the refusal. It blocks the out-of-tree mutation-testing
# workflow this repo's guidance prescribes for exactly this kind of guard, and
# the fallback (a `sed` one-liner) silently produced a NO-OP mutant, so a fix
# was nearly reported as inert. A false positive here degrades verification.
#
# Two token narrowings, each verified against the only tree this gates:
#  (a) NO QUOTE CHARACTER. `git ls-files | grep -c '["'\'']'` -> 0. This also
#      covers the `/` branch, where prose can otherwise smuggle a hit: the
#      literal 'see "apps/operator" for details' yields the token
#      `"apps/operator"`, which contains a `/` and resolves in-tree.
#  (b) PATH SHAPE: contains `/`, OR its FINAL `.` is followed by a non-empty run
#      of filename-safe characters and nothing else. `sibling."""` fails (`"""`),
#      as do `sibling.`, `e.g.`, `etc.` — a trailing/prose period is not an
#      extension. Filename-safe is deliberately `[A-Za-z0-9_-]` rather than
#      alnum: an alnum-only rule would have dropped 5 real tracked paths
#      (.bash_profile, .gitnexusignore, .mcp.json.su-parked, and two dated
#      .mcp.json backups) — the only tracked dotted paths with no `/` to fall
#      back on. Measured, not assumed: of 3615 tracked paths whose final segment
#      is not an alnum extension, exactly those 5 lack a slash.
#
# RESIDUAL, accepted: a missing space after a period (`sentence.The`) and a
# quoted decimal ('1.5') are still path-shaped by this test. Both are rarer than
# what (b) removes, and the guard is coarse by design — see its honest-limit note.
_PATH_CANDIDATE_RE = re.compile(r'/|\.[A-Za-z0-9_-]+$')


def _looks_like_path_candidate(cand):
    if '"' in cand or "'" in cand:
        return False
    return bool(_PATH_CANDIDATE_RE.search(cand))


# EI-18814109122347052 — SIXTH in the not-a-path-resolved-as-one family, and
# the first to be fixed by narrowing WHERE the scan looks rather than what a
# candidate token is allowed to look like. Every predecessor (paired quotes,
# whitespace tokenizing, quote-char + path-shape exclusion) still scanned
# every quoted literal in the WHOLE inline-code body, regardless of what call
# (if any) it was an argument to. A print() label is a literal like any
# other: `print("postings/comments pulled:", len(texts), ...)` contains a
# `/`, carries no quote character inside it, and so cleared every prior
# filter — even though the body's only write target was a wholly unrelated
# `open('/tmp/hiring-blob.txt', 'w')` a line away.
#
# The fix: only scan literals that are ARGUMENTS TO a write-shaped/file-
# construct call (open(...), Path(...), write_text(...)/write_bytes(...),
# writeFileSync(...), etc. — the same call forms _WRITE_INDICATOR_RE /
# _FILE_OBJECT_RE already recognize as file-I/O shaped). A literal sitting
# anywhere else in the body — a print() label, a docstring, an error
# message, a bare variable assignment — is no longer a candidate at all, so
# it needs no path-shape/quote-char test to be excluded. This is still LITERAL
# PATHS ONLY (balanced-paren matching from a call site's `(`, not a real
# parse of the interpreted language) — same discipline as the rest of this
# guard, just scoped to the argument list instead of the whole payload.
_WRITE_CALL_SITE_RE = re.compile(
    r'\bopen\s*\('
    r'|\bwrite_(?:text|bytes)\s*\('
    r'|\.save\s*\('
    r'|(?:pickle|json|yaml)\.dump\s*\('
    r'|shutil\.(?:copy|move)\s*\('
    r'|os\.(?:rename|remove|replace)\s*\('
    r'|unlink\s*\('
    r'|Path\s*\('
    r'|fdopen\s*\('
    r'|NamedTemporaryFile\s*\('
    r'|writeFileSync\s*\('
    r'|appendFileSync\s*\('
    r'|createWriteStream\s*\('
)


def _write_call_arg_spans(body):
    # The parenthesized argument list of each recognized write/file-construct
    # call, found by balanced-paren matching from the call site's `(` —
    # rather than a regex capture, since arguments can themselves contain
    # nested parens (`open(os.path.join(a, b), 'w')`). Skips a call whose
    # parens never balance (truncated body, unterminated construct) — there
    # is nothing safe to scan past a call site like that.
    spans = []
    for _m in _WRITE_CALL_SITE_RE.finditer(body):
        _start = _m.end() - 1  # index of the call's opening '('
        _depth = 0
        _i = _start
        _n = len(body)
        while _i < _n:
            _ch = body[_i]
            if _ch == '(':
                _depth += 1
            elif _ch == ')':
                _depth -= 1
                if _depth == 0:
                    spans.append(body[_start:_i + 1])
                    break
            _i += 1
    return spans


# EI-18828866497684686 — is the write call's PATH argument (its first,
# top-level comma-separated argument) a plain literal at all, or a bare
# expression (a variable, `os.path.join(...)`, string concatenation, an
# f-string with no literal segment, …)? Deliberately NOT "does a literal
# resolve in-tree" (`_payload_literal_tree_path` already answers that, and a
# literal that resolves OUTSIDE the tree — e.g. `open('/tmp/x.log','w')` — is
# common and safe, so it must not trip this). This only asks "is there
# anything here for a literal-only scan to even look at" — no quote character
# before the first TOP-LEVEL comma (respecting nested parens/brackets/braces,
# so `open(os.path.join(a, b), 'w')`'s inner comma does not end the first
# argument early) means the path was constructed at runtime and is invisible
# to every literal-matching check in this guard, by the file's own documented
# "honest limit".
def _first_call_arg_text(span):
    """Return the first top-level argument from a balanced call span."""
    if not span or span[0] != '(':
        return None
    depth = 0
    in_quote = None
    first_arg_end = None
    i, n = 0, len(span)
    while i < n:
        ch = span[i]
        if in_quote:
            if ch == '\\' and i + 1 < n:
                i += 2
                continue
            if ch == in_quote:
                in_quote = None
            i += 1
            continue
        if ch in '\'"':
            in_quote = ch
        elif ch in '([{':
            depth += 1
        elif ch in ')]}':
            depth -= 1
            if depth == 0:
                first_arg_end = i
                break
        elif ch == ',' and depth == 1:
            first_arg_end = i
            break
        i += 1
    if first_arg_end is None:
        return None  # unbalanced — nothing safe to conclude
    return span[1:first_arg_end]


def _first_call_arg_has_no_literal(span):
    first_arg = _first_call_arg_text(span)
    if first_arg is None:
        return False
    return not any(c in first_arg for c in ('\'', '"'))


def _has_computed_write_path(body):
    return any(_first_call_arg_has_no_literal(_span) for _span in _write_call_arg_spans(body))


# EI-19327302389409134 — the guard already denies `open('literal/tree/path', 'w')`
# and already ADVISES (non-blocking) on `open(p, 'w')` where `p` is any bare
# variable, because the value could be a runtime-computed path this guard's own
# "honest limit" says no static scan can ever see. But the reported repro is
# narrower and IS staticaly visible: `p = 'literal/tree/path'` assigned two lines
# above, then `open(p, 'w')` — a plain literal, one hop of variable indirection
# away, in the SAME body this guard already scans. Being refused for `sed -i` and
# then silently ALLOWED (only advised) for this reads as "assign it to a variable
# first" being the sanctioned workaround, which is the opposite of the lesson the
# refusal is supposed to teach.
#
# Deliberately narrow, matching the discipline every predecessor fix in this file
# already established (see the EI-* family above _QUOTED_LITERAL_RE): only a
# SIMPLE `IDENT = 'literal'` / `IDENT = "literal"` assignment, anchored at a
# statement boundary (start-of-line or `;`, never mid-expression) so it cannot
# match `foo == 'bar'`, a dict key `d['x'] = 'y'`, or a kwarg `f(x='y')` — paired
# with the write call's first argument being that EXACT bare identifier and
# nothing else (`open(p, 'w')` matches; `open(p.name, 'w')`, `open(a + b, 'w')`,
# `open(os.path.join(p, x), 'w')` do not — those stay in the existing computed-
# path ADVISORY, unchanged). This is still a plain text scan, not dataflow: a
# variable reassigned or shadowed between the assignment and the call is not
# tracked (last assignment anywhere in the body wins, the same top-to-bottom
# approximation `_payload_literal_tree_path`'s direct-literal scan already
# relies on) — an accepted, documented approximation, not a claim of soundness.
# EI-24345357866084290: retain only statement-boundary assignments whose path
# expression can be reduced to quoted strings, already-known variables,
# process.env.HOME, and path.join. The whole write argument is resolved too, so
# a known out-of-tree prefix is never split into a repo-relative basename.
_SIMPLE_ASSIGN_RE = re.compile(
    r'(?:^|[\n;])[ \t]*(?:(?:const|let|var)[ \t]+)?'
    r'([A-Za-z_][A-Za-z0-9_]*)[ \t]*=[ \t]*([^;\n]*)'
)
_BARE_IDENT_RE = re.compile(r'^[A-Za-z_][A-Za-z0-9_]*$')
_STATIC_PATH_JOIN_RE = re.compile(r'(?:(?:path|os\.path)\.)join\s*\((.*)\)$')


def _split_static_expression(expr, delimiter):
    """Split on a delimiter outside strings and nested brackets."""
    parts = []
    start = 0
    depth = 0
    quote = None
    i = 0
    while i < len(expr):
        ch = expr[i]
        if quote:
            if ch == '\\' and i + 1 < len(expr):
                i += 2
                continue
            if ch == quote:
                quote = None
        elif ch in ('"', "'"):
            quote = ch
        elif ch in '([{':
            depth += 1
        elif ch in ')]}':
            depth -= 1
        elif ch == delimiter and depth == 0:
            parts.append(expr[start:i].strip())
            start = i + 1
        i += 1
    parts.append(expr[start:].strip())
    return parts


def _static_path_expression(expr, variables, depth=0):
    """Evaluate literal path pieces, known variables, HOME, and path.join."""
    if expr is None or depth > 8 or len(expr) > 2000:
        return None
    expr = expr.strip()
    if not expr:
        return None

    _literal = _QUOTED_LITERAL_RE.fullmatch(expr)
    if _literal:
        value = _literal.group(1) if _literal.group(1) is not None else _literal.group(2)
        # Escapes need language-specific decoding; leave them to the
        # existing literal scanner instead of guessing at their value.
        return None if '\\' in value else value

    if expr == 'process.env.HOME':
        return os.environ.get('HOME') or os.path.expanduser('~')
    if _BARE_IDENT_RE.fullmatch(expr):
        return variables.get(expr)

    _parts = _split_static_expression(expr, '+')
    if len(_parts) > 1:
        _values = [_static_path_expression(part, variables, depth + 1) for part in _parts]
        if all(value is not None for value in _values):
            return ''.join(_values)
        return None

    _join = _STATIC_PATH_JOIN_RE.fullmatch(expr)
    if _join:
        _args = _split_static_expression(_join.group(1), ',')
        _values = [_static_path_expression(arg, variables, depth + 1) for arg in _args]
        if _values and all(value is not None for value in _values):
            return os.path.join(*_values)
    return None


def _literal_var_assignments(body):
    """{ varName: literalValue } for simple assignments in the body.

    Last assignment wins (top-to-bottom scan order). Static path expressions
    are reduced to one value; unsupported expressions are omitted, not guessed.
    """
    out = {}
    for _m in _SIMPLE_ASSIGN_RE.finditer(body):
        _name = _m.group(1)
        _value = _static_path_expression(_m.group(2), out)
        if _value is None:
            out.pop(_name, None)
        else:
            out[_name] = _value
    return out


def _first_call_arg_bare_ident(span):
    """The first top-level argument of a write-call span, IF it is nothing but a
    single bare identifier (`open(p, 'w')` -> `'p'`); None for anything else
    (an attribute/index/call/binop, multiple tokens, or an unbalanced span).
    Same balanced-paren first-arg extraction as `_first_call_arg_has_no_literal`."""
    first_arg = _first_call_arg_text(span)
    if first_arg is None:
        return None
    cand = first_arg.strip()
    return cand if _BARE_IDENT_RE.match(cand) else None


def _payload_literal_tree_path(body, canon, cwd):
    # Every quoted token inside the FIRST, top-level path argument of a
    # write-call span (see _write_call_arg_spans above — EI-18814109122347052)
    # that looks path-like (contains `/` or a dotted extension) and carries no
    # shell/interpreter expansion syntax ($, `, {, }) — resolved the same
    # literal-only way as _resolve_write_target. Later arguments are payloads,
    # not path operands; scanning them caused rationale prose such as
    # `wave-b-gate.test.ts` to manufacture a false in-tree hit (EI-21274601485463217).
    _var_literals = None  # lazily built only if a bare-identifier arg needs it
    for _span in _write_call_arg_spans(body):
        _first_arg = _first_call_arg_text(_span)
        if _first_arg is None:
            continue  # unbalanced — nothing safe to scan
        # EI-19327302389409134: the call's path argument may be a BARE VARIABLE
        # whose value was a plain literal assigned earlier in the same body
        # (`p = 'tree/path'; ...; open(p, 'w')`) — see the helpers + comment
        # above _SIMPLE_ASSIGN_RE for the narrow, intentionally non-dataflow
        # matching discipline. Checked once per span, before the direct-literal
        # scan below (their hits are equivalent; order doesn't matter here).
        _bare = _first_call_arg_bare_ident(_span)
        if _bare:
            if _var_literals is None:
                _var_literals = _literal_var_assignments(body)
            _val = _var_literals.get(_bare)
            if _val is not None and not any(ch in _val for ch in ('$', '`', '{', '}')):
                for cand in _val.split():
                    if not _looks_like_path_candidate(cand):
                        continue
                    resolved = _resolve_write_target(cand, cwd)
                    if (resolved and (resolved == canon or resolved.startswith(canon + os.sep))
                            and not _is_sanctioned_scratch(resolved, canon)):
                        return cand
        _static_target = _static_path_expression(_first_arg, _var_literals or {})
        if _static_target is None and _var_literals is None:
            _var_literals = _literal_var_assignments(body)
            _static_target = _static_path_expression(_first_arg, _var_literals)
        if _static_target is not None:
            if _looks_like_path_candidate(_static_target):
                resolved = _resolve_write_target(_static_target, cwd)
                if (resolved and (resolved == canon or resolved.startswith(canon + os.sep))
                        and not _is_sanctioned_scratch(resolved, canon)):
                    return _static_target
            continue  # resolve the whole known expression, never its pieces
        for _m in _QUOTED_LITERAL_RE.finditer(_first_arg):
            raw = _m.group(1) if _m.group(1) is not None else _m.group(2)
            if any(ch in raw for ch in ('$', '`', '{', '}')):
                continue
            # EI-18800669297694465: test each WHITESPACE-SEPARATED TOKEN of
            # the literal, never the literal as a whole.
            #
            # A path candidate cannot contain whitespace — not as a general
            # truth about filesystems, but as a true one about the only
            # targets this guard gates: no tracked path in this repo has a
            # space (`git ls-files | grep -c ' '` -> 0), and `canon` is that
            # repo. So tokenizing cannot lose an in-tree hit, while testing
            # the whole literal actively manufactures false ones.
            #
            # It did. `open("wrote /tmp/x.mts", 'w')` is ONE literal
            # containing a `/` and a `.`, so it passed both filters; it does
            # not START with `/`, so it was treated as RELATIVE and joined
            # onto the cwd, yielding `<canon>/wrote /tmp/x.mts` — "inside the
            # tree". Returning the token fixes the message half too: the
            # agent is shown a path, not prose.
            #
            # Fourth in this family (EI-18683619680591304, -18692070370140239,
            # -18700825865251498): each was something that is not a path
            # being resolved as one. The through-line is that this scan is
            # deliberately coarse, so every widening of what counts as a
            # "path" must be paid for by a matching narrowing of what counts
            # as a candidate.
            for cand in raw.split():
                if not _looks_like_path_candidate(cand):
                    continue
                resolved = _resolve_write_target(cand, cwd)
                if (resolved and (resolved == canon or resolved.startswith(canon + os.sep))
                        and not _is_sanctioned_scratch(resolved, canon)):
                    return cand
    return None


def _interpreter_write_guard():
    global ADVISORY
    _canon = _canonical_tree_root()
    if not _canon:
        return
    try:
        _cwd = os.path.realpath(payload.get('cwd') or os.getcwd())
    except Exception:
        return
    _clean = _strip_quotes_and_comments(_strip_heredoc_bodies(command))
    if not _INTERPRETER_RE.search(_clean):
        return  # no interpreter invocation at all — nothing to check
    _interp_m = _INTERPRETER_RE.search(_clean)
    _interp = _interp_m.group(1)
    # WI-7219: this guard resolved every relative path against the SESSION
    # cwd and ignored an in-command `cd` outright — so `cd /tmp/x && python -c
    # "open('out.txt','w')"` was denied over a write that lands in /tmp. The
    # sibling redirect guard has replayed `cd` since its own version of this
    # bug; reuse that replay rather than grow a second one, because it is the
    # same question and its conservatism is already argued at length above
    # (bails on a subshell, on any non-literal argument, and counts only a
    # statement-initial `cd`). A `cd` it CAN follow moves the write out of the
    # tree in fact and not merely in the string, so allowing it is correct —
    # and a `cd` it cannot follow still falls back to the session cwd, where
    # `_relative_target_cd_note` now explains the refusal instead of leaving
    # the agent to conclude the guard is broken.
    _has_paren = '(' in _clean or ')' in _clean
    _eff_cwd = _effective_cwd_before(_interp_m.start(), _cwd, _clean, _has_paren)
    _has_heredoc = bool(_HEREDOC_START_RE.search(command))
    _has_inline_flag = bool(_INLINE_CODE_FLAG_RE.search(_clean))
    if not (_has_heredoc or _has_inline_flag):
        return  # e.g. a plain `node script.js` — the code lives in a real
        # file, which Edit already locks; nothing new for this guard to see.
    _bodies = _extract_quoted_flag_bodies(command) + _extract_heredoc_bodies(command)
    # EI-18828866497684686: a write whose PATH ARGUMENT is COMPUTED (joined
    # from a parsed log, a loop variable, an env var, string concatenation —
    # anything that is not a plain quoted literal) is structurally invisible
    # to `_payload_literal_tree_path`, same "honest limit" this guard's own
    # header comment already documents as permanent (no static scan of the
    # command text can see a runtime-constructed path). Silently allowing it
    # is the correct call — deny-by-default here would ALSO flag the
    # overwhelmingly common, SAFE case of a script writing an out-of-tree
    # scratch/log file via a LITERAL path (e.g. `open('/tmp/x.log','w')`),
    # reopening exactly the false-positive class this file has already paid
    # for six times over (see the family of EI-* comments above) — so the
    # advisory below fires ONLY when the path argument has NO literal at all
    # (`_has_computed_write_path`), never merely "no in-tree literal found".
    # A silent pass on a genuinely computed path still reads as an
    # endorsement an agent cannot tell apart from "checked, nothing wrong" —
    # so say so, once per session, non-blocking: the guard only sees literal
    # paths; a computed one inside the tree still bypasses locking and this
    # guard cannot catch it.
    _saw_computed_write = False
    for _body in _bodies:
        if not _body_indicates_file_write(_body):
            continue  # a read, a stdout/stderr print, or no recognized file
            # I/O at all — nothing to gate (EI-18692070370140239)
        _hit = _payload_literal_tree_path(_body, _canon, _eff_cwd)
        if _hit:
            # The scanned text here is the interpreter PAYLOAD, not the shell
            # command — showing it is what tells a confused reader which of the
            # two the guard was reading (EI-19421518638516187).
            _DENY_VIEW['clean'], _DENY_VIEW['at'] = _body, _body.find(_hit)
            # LOG-ONLY, explicitly: this text is arbitrary user code, so quoting a
            # slice of it into the reason would breach the never-quote-prose
            # invariant. Stated rather than left to fall through, so a future
            # reorder cannot silently turn it on.
            _DENY_VIEW['inReason'] = False
            deny(
                'shell-write guard (EI-18691482279179647): this `%s` invocation runs inline '
                'code that references `%s`, which resolves INSIDE the shared staging tree. '
                'An interpreter write (open()/fs.writeFileSync()/etc.) is invisible to '
                'shell-redirect detection — it skips the file-lock hook entirely, the same '
                'side door as a raw `cat >>`/`tee`/`sed -i` (EI-18664655909328670). Use the '
                'Edit or Write tool instead — they claim the lock and validate the worktree '
                'for you (for a copy: Read the source, then Write the destination). '
                '%s'
                '%s'
                % (
                    _interp,
                    _hit,
                    _relative_target_cd_note(_hit, _interp_m.start(), _clean, _has_paren),
                    _SCRATCH_REMEDY,
                )
            )
        elif _has_computed_write_path(_body):
            _saw_computed_write = True
    if _saw_computed_write and not ADVISORY:
        ADVISORY = (
            'shell-write guard notice (EI-18828866497684686): this `%s` invocation writes a '
            'file (open()/write_text()/writeFileSync()/etc.) but no LITERAL in-tree path was '
            'found among its write-call arguments. This guard only recognizes a plain quoted '
            'path string — it cannot see a COMPUTED path (joined from a parsed log, a loop '
            'variable, an env var, string concatenation, …). If the write actually lands '
            'inside the shared staging tree, no lock is being claimed and this guard cannot '
            'catch that. If you are rewriting tracked file(s) by a computed path, prefer '
            'Edit/Write per file (they claim the lock for you), or claim it yourself first: '
            'locks:acquire { paths, intent }. Advisory only; this command is proceeding as '
            'issued.' % _interp
        )


try:
    _interpreter_write_guard()
except Exception:
    pass  # guard must never wedge a command

# ── Heavy-command admission control (WI-3821) ──────────────────────────────
# Fleet size now organically oversubscribes the 128-core box: each agent's
# vitest/tsc/test:affected is ALREADY per-suite worker-capped (affected-tests.mjs
# caps at 32) and runs its workspaces sequentially, so ONE run is fine — but N
# agents run their own simultaneously with zero cross-process coordination, and
# ~6 concurrent capped runs = ~185 workers = the load-245→3077 meltdowns seen
# twice this week. This hook is the only place that transparently sees EVERY raw
# agent heavy command, but it can only allow/deny (it exits before the command
# runs, so it cannot hold a slot) — so it DENIES a *new* heavy run when host
# load is already past the pathological threshold, pointing the caller at
# scripts/pc-heavy.sh (a flock counting-semaphore that WAITS for a free slot
# instead of failing) or a retry once load drops. Raw tsc is denied at EVERY
# load level: its measured 11.2 GiB RSS needs the wrapper's memory budget,
# and reclaim can lower load1 while memory pressure rises (WI-10003344).
# The green-checkpoint gate and
# capability:inspect run server-side / as MCP tools and never reach this bash
# hook, so they are exempt by construction; only raw, uncoordinated agent shell
# runs get staggered.
#
# Safe-by-default & FAIL-OPEN: this hook lands fleet-wide via git-sync with no
# review, so a fail-closed bug would wedge every agent's bash. The threshold is
# 1.0x cores (was 1.5x; EI-19296434833105508 — the herd forms BELOW 1.5x and
# operator liveness degrades from ~1.3x, and a denied caller's remedy queues
# politely rather than failing, so a lower bar costs nothing but a nice queue);
# kill-switch PC_HEAVY_ADMISSION=off; skipped when PC_HEAVY_BYPASS=1 (pc-heavy
# sets it) or the caller is not an agent/shared-tree session (owner exempt);
# every error path allows. PC_HEAVY_LOAD1_OVERRIDE lets tests inject a load.
# ══ BENIGN LEADING WRAPPERS — ONE definition, two consumers ══
#
# A "benign wrapper" is a token sequence that runs NO command of its own: it
# adjusts the environment / priority / time limit and then execs whatever
# follows. TWO places below need exactly this set, and they must agree:
#
#   1. the PEEL loop in _heavy_admission — strips them off the FRONT so the
#      start-anchored bypass checks (pc-heavy.sh, the root npm entrypoints) can
#      see the real command word hiding behind them;
#   2. the heavy-detection ANCHOR — recognizes command POSITION mid-string, so
#      `echo hi && timeout 60 npx vitest` is still read as a heavy at position.
#
# EI-19317242751258158: this concept was written TWICE and the copies had
# DIVERGED. The peel knew `timeout`; the anchor did not. NEITHER knew a bare
# `VAR=val` assignment prefix — only the `env VAR=val` spelling. Both halves of
# that divergence were measured live on 2026-08-02, and they fail in OPPOSITE
# and equally bad directions:
#
#   • BYPASS (the anchor's gap) — `FOO=1 npx tsc`, `PC_HEAVY_COALESCE=0 npx
#     vitest` and `echo hi && timeout 60 npx vitest` escaped heavy admission
#     ENTIRELY, i.e. the exact herd this gate exists to stop, with a two-token
#     prefix in front of it.
#   • FRICTION (the peel's gap) — `PC_HEAVY_COALESCE=0 scripts/pc-heavy.sh --
#     node_modules/.bin/vitest` was DENIED, with a message instructing the
#     caller to run it under scripts/pc-heavy.sh, which is what it WAS doing.
#     That is the EI-9634 / EI-10001 / WI-4547 "the guard blocks its own
#     prescribed remedy" trap for the fourth time — each previous fix added the
#     one missing wrapper to ONE of the two lists, which is precisely how they
#     drifted apart.
#
# So: keep this ONE definition. Adding a wrapper to only one consumer is how
# this bug is reintroduced, and the divergence is invisible until someone
# probes the exact right command shape.
# NAMED wrappers: each begins with a literal command word, so recognizing one
# mid-string costs essentially no false positives (prose rarely contains
# "sudo <heavy>").
_NAMED_WRAPPER_ALTS = (
    r'sudo(?:\s+(?:-[ugpUrCht]\s+\S+|-[A-Za-z]+|--[\w-]+(?:=\S*)?))*\s+',
    r'env(?:\s+[A-Za-z_]\w*=\S*)*\s+',
    r'nice(?:\s+-n\s*-?\d+)?\s+',
    r'ionice(?:\s+-\w+(?:\s+\d+)?)*\s+',
    r'rtk\s+',
    r'time\s+',
    r'timeout(?:\s+(?:-[a-zA-Z]\S*|--[\w-]+(?:=\S*)?))*\s+-?\d+\S*\s+',
)
# A bare `VAR=val ` prefix — the `env VAR=val` spelling minus the `env`. The
# shell parses a leading WORD=VALUE as an assignment, never as a command word,
# so peeling it can no more hide a command than peeling `env` can.
#
# It is kept SEPARATE from the named set because it is far more general: `\w+=`
# matches ordinary prose, so at an arbitrary mid-string offset it false-denies
# `echo "PC_HEAVY=1 vitest is the way"` (measured — this exact string denied
# during development of this fix). It is therefore honoured only at a REAL
# command position (start / just after a separator), never as a free-floating
# mid-string anchor the way the named words are.
_ASSIGN_PREFIX = r'[A-Za-z_]\w*=\S*\s+'
_BENIGN_WRAPPERS = '(?:' + '|'.join(_NAMED_WRAPPER_ALTS + (_ASSIGN_PREFIX,)) + ')'

# Shell RESERVED WORDS that open a command position (`if …; then CMD`,
# `for …; do CMD`, `… else CMD`). EI-18139694363457325 measured the gap they
# left: a heavy command placed after one of them sat at NO anchor, so
# `for f in a; do vitest; done` — N unthrottled heavy runs — was admitted while
# the identical bare `vitest` was denied.
#
# This set is deliberately shaped UNLIKE the wrapper set above. Wrappers are an
# OPEN set (any executable can wrap a command), which is why enumerating them
# has recurred four times (EI-9634/EI-10001/EI-10439/WI-4551) and why the peel
# must never be "fixed" by adding one more. Reserved words are a CLOSED set
# fixed by the shell grammar, so enumerating them completely is a one-time
# closure rather than another step on that treadmill.
#
# Kept OPTIONAL and only at a real command position (start / after a separator)
# so it widens the anchor by exactly the grammar's command positions: a bare
# `; do vitest` matches, while the word alone in prose does not become an
# anchor of its own.
_CMD_INTRODUCER = r'(?:(?:then|do|else|elif)\s+)?'

# The ROOT npm entrypoints that package.json ALREADY wraps in scripts/pc-heavy.sh.
# They run their own flock counting-semaphore admission, so they are safe at ANY
# command position, not merely as the first word.
#
# Defined ONCE for the same reason _BENIGN_WRAPPERS is: this set is consumed by
# the start-anchored (a2) skip-check AND by the heavy-detection anchor, and a
# second hand-maintained copy is exactly what drifts (EI-19317242751258158 was
# that bug for the wrapper set — the peel knew `timeout`, the anchor did not).
#
# EI-19419178369405401: the (a2) check is `re.match` (start-anchored) while
# heavy-detection is anchored at EVERY command position, so `npm run test:file`
# was exempt as the first word and DENIED after any separator — `echo hi; npm
# run test:file` and `export FOO=1; npm run test:file` both denied while the
# identical bare command passed. That asymmetry denied the blessed, already
# self-throttling entrypoint under exactly the load it exists to queue for, and
# the deny text then named that same entrypoint as the remedy — the "guard
# blocks its own remedy" trap this file has now hit four times.
#
# Bare `npm test` / `npm run test` are deliberately NOT here: a WORKSPACE cwd
# resolves those to its own raw vitest rather than the root wrapper.
_ROOT_NPM_ENTRYPOINT_ALT = (
    r'test:affected(?::integration)?|test:all(?::integration)?'
    r'|test:file|lint:tsc(?::operator-vite)?|typecheck'
)
_NAMED_WRAPPERS = '(?:' + '|'.join(_NAMED_WRAPPER_ALTS) + ')'


def _heavy_admission():
    if os.environ.get('PC_HEAVY_ADMISSION', 'on').strip().lower() in ('off', '0', 'false', 'no'):
        return
    if os.environ.get('PC_HEAVY_BYPASS') == '1':
        return
    # In-band bypasses (EI-9634): this hook decides BEFORE the wrapped command
    # runs, so neither the blessed wrapper's PC_HEAVY_BYPASS export nor a child
    # shell's inline `PC_HEAVY_BYPASS=1 …` assignment is in THIS process's env
    # yet — so both remedies the deny message itself recommends were themselves
    # denied under the exact high load they exist for. Read them from the
    # command TEXT instead (both are command-position, re.match-anchored):
    #   (a) a leading `scripts/pc-heavy.sh …` invocation — it runs its OWN flock
    #       counting-semaphore admission and exports PC_HEAVY_BYPASS=1 to its
    #       child, so gating it double-denies the wrapper for the check it
    #       already satisfies.
    #
    # EI-10001: this used to `re.match` the RAW `_lead` only — so the deny
    # message's own suggested remedy ("run it under `scripts/pc-heavy.sh --
    # <your command>`") silently didn't work the moment pc-heavy.sh wasn't the
    # literal first token: the everyday `cd <dir> && scripts/pc-heavy.sh --
    # <cmd>` (very common right after a prior command left you elsewhere) or a
    # `(… ) &` subshell wrapper around the invocation both got denied AGAIN
    # with the exact same message — reads as "the remedy doesn't work." Peel a
    # BOUNDED set of genuinely benign leading wrappers first (each one runs no
    # command of its own, so this can never let a REAL heavy command hiding
    # earlier in the string slip past ungated — `npm run build && scripts/
    # pc-heavy.sh -- true` still stops peeling at `npm`, which isn't one of
    # these, so it still hits the heavy_re check below as before).
    # The admission matcher operates on shell command positions. Do not let a
    # newline inside quoted data or a non-shell heredoc body manufacture one:
    # `echo "line one\nnpx vitest"` and `cat <<EOF\nnpx vitest\nEOF` are both
    # light commands. Shell-fed heredocs stay intact because their body is
    # executable shell input and must remain subject to admission.
    _lead = _scan_dequote(_scan_strip_nonexecuted_heredocs(command)).lstrip()
    _pc_lead = _lead
    for _ in range(8):
        _next = re.sub(
            r'^(?:'
            # cd <dir> && / ; / NEWLINE. The newline arm matters as much as the
            # other two (EI-19300297240416558): a `cd` on its own line is one of
            # the most common shapes an agent writes, and without it the peel
            # stops at `cd`, the (a)/(a2) skip-checks below never match (both are
            # start-anchored), and the command falls through to heavy-detection —
            # which IS newline-anchored. That asymmetry denied the blessed
            # `npm run test:file` under exactly the load it exists to queue for.
            # Written `[ \t]*(?:&&|;|\n)` rather than `\s*(?:&&|;|\n)` so the
            # separator match cannot depend on backtracking a greedy `\s*` that
            # already swallowed the newline.
            r'cd\s+([\'"]?)[^&|;<>\s\'"]+\1[ \t]*(?:&&|;|\n)\s*'
            # `set -o pipefail && …` / `set -euo pipefail; …`. A `set` builtin only
            # flips shell options — it runs NO command — so peeling it can't hide a
            # heavy command, and NOT peeling it made this gate deny the very remedy its
            # own error message prescribes: `cd d && set -o pipefail && scripts/
            # pc-heavy.sh -- vitest` stopped peeling at `set`, missed the pc-heavy lead,
            # and got denied as a raw `vitest`. Same "the remedy doesn't work" trap
            # EI-9634 fixed for `cd`/subshell — and it punished exactly the right habit,
            # since pipefail is what stops `… | tail` from masking a real exit code.
            r'|set\s+(?:-o\s+[\w-]+|\+o\s+[\w-]+|[-+][A-Za-z]+)(?:\s+(?:-o\s+[\w-]+|\+o\s+[\w-]+|[-+][A-Za-z]+))*[ \t]*(?:&&|;|\n)\s*'
            r'|\(\s*'  # one subshell open: ( scripts/pc-heavy.sh … ) &
            # The shared benign-wrapper set (sudo/env/nice/ionice/rtk/time/
            # timeout/bare-assignment). Defined ONCE above so the peel and the
            # heavy-detection anchor below can never drift apart again.
            r'|' + _BENIGN_WRAPPERS +
            r')',
            '', _pc_lead, count=1)
        if _next == _pc_lead:
            break
        _pc_lead = _next
    if re.match(r'(?:bash\s+|sh\s+)?(?:\S*/)?pc-heavy\.sh(?:\s|$)', _pc_lead):
        return
    #   (a2) ROOT npm entrypoints that are ALREADY wrapped in scripts/pc-heavy.sh
    #       inside package.json (EI-19296434833105508): denying them would re-open
    #       the EI-10001 "the remedy doesn't work" trap — the agent runs the
    #       blessed self-throttling command and is denied before npm can spawn
    #       the wrapper, under exactly the load the wrapper exists to queue for.
    #       Exact script names only (these exist ONLY at the repo root); bare
    #       `npm test` / `npm run test` stay gated because a WORKSPACE cwd
    #       resolves those to its own raw vitest, not the wrapper.
    #       This is NO LONGER an early `return`. It used to be, and that had its
    #       own hole: an early return is unconditional, so a sanctioned
    #       entrypoint at the FRONT waved through everything after it —
    #       `npm run test:file && npx vitest` was ALLOWED at any load (measured
    #       2026-08-03 while fixing EI-19419178369405401). The exemption is now
    #       expressed where it belongs, as a negative lookahead inside
    #       heavy-detection below, so a sanctioned entrypoint stops being heavy
    #       WITHOUT granting amnesty to the rest of the command line.
    #       `lint:tsc` / `typecheck` need no arm there at all: heavy-detection
    #       never matched them in the first place.
    #   (b) a leading `PC_HEAVY_BYPASS=1` env-assignment prefix (bare, behind
    #       other assignments, or behind `env`) — mirrors the message's own
    #       `PC_HEAVY_BYPASS=1 <cmd>` remedy and the `env`-prefixed heavy form
    #       the anchor already recognizes. Same `cd <dir> &&` allowance as (a).
    _bypass_lead = re.sub(
        r'^cd\s+([\'"]?)[^&|;<>\s\'"]+\1[ \t]*(?:&&|;|\n)\s*', '', _lead, count=1)
    if re.match(r'(?:env\s+)?(?:[A-Za-z_]\w*=\S*\s+)*PC_HEAVY_BYPASS=1(?:\s|$)', _bypass_lead):
        return
    #   (c) a leading `PC_HEAVY_ADMISSION=off` env-assignment prefix (EI-10913):
    #       the deny message advertises `PC_HEAVY_ADMISSION=off` as the
    #       kill-switch, but the env read at the TOP of this function only sees
    #       it when it is ALREADY in this process's env — which an agent cannot
    #       set from a Bash call (the assignment applies to the CHILD, not to
    #       this hook). So the guard's own documented escape hatch was itself
    #       denied under the exact high load it exists for — the "guard blocks
    #       its own remedy" bug. Read it in-band from the command text too,
    #       accepting the same off-values the env read does (off/0/false/no,
    #       value case-insensitive; the env-var NAME stays literal since a shell
    #       assignment is case-sensitive). Same `cd <dir> &&` and leading-
    #       assignment/`env` allowance as the PC_HEAVY_BYPASS check above.
    if re.match(r'(?:env\s+)?(?:[A-Za-z_]\w*=\S*\s+)*PC_HEAVY_ADMISSION=(?i:off|0|false|no)(?:\s|$)',
                _bypass_lead):
        return
    # Only throttle agent / shared-tree sessions — never the owner's own box
    # work. Mirror the git-guard's marker-OR-tree gate so marker-less fleet
    # sessions (EI-7872) are still covered.
    if not (os.environ.get('PAPERCUSP_AGENT_SESSION') == '1' or _cmd_in_canonical_tree()):
        return
    # Heavy = the batch test/build commands that spawn worker pools. Anchored at
    # command position (start / after ;&|newline / a known wrapper / a path/) so
    # a prose arg, a config filename, or a docs path never false-positives; the
    # executable must be followed by whitespace or end so `vitest.config`,
    # `vitest-guide`, `testing` etc. don't match. Bare `tsx` is intentionally
    # NOT heavy (it runs light one-shot scripts far more often than builds).
    # The wrapper arms are built from the SHARED sets defined above rather than
    # from a second hand-maintained copy — that copy is exactly what had drifted
    # (EI-19317242751258158: the peel knew `timeout`, this anchor did not).
    # `{0,4}`/`{1,4}` mirror the peel's bounded loop so STACKED wrappers
    # (`… && nice -n 10 timeout 60 npx vitest`) are recognized at command
    # position too; `\b` keeps `nice` from matching inside `ionice`.
    anchor = (
        r'(?:'
        # A real command position — start of string, just after a separator, or
        # just inside a brace group — optionally behind a command-introducing
        # reserved word (`; then`/`; do`), then optionally behind stacked benign
        # wrappers. This is the arm that admits the bare-assignment prefix
        # (`FOO=1 npx tsc`, `… && FOO=1 npx vitest`).
        r'(?:^|[;&|\n]\s*|\{\s*)' + _CMD_INTRODUCER + r'(?:' + _BENIGN_WRAPPERS + r'){0,4}'
        # A NAMED wrapper anywhere, as before this fix. Kept as its own arm so
        # no coverage is lost relative to the previous anchor; the assignment
        # prefix is deliberately absent here (see _ASSIGN_PREFIX above).
        r'|(?:\b' + _NAMED_WRAPPERS + r'){1,4}'
        # A path-invoked executable: ../../node_modules/.bin/vitest
        r'|\S*/'
        r')'
    )
    heavy_re = re.compile(
        anchor + r'(?:'
        r'(?:npx\s+|pnpm\s+|bunx\s+)?vitest(?=\s|$)'
        r'|(?:npx\s+)?tsc(?=\s|$)'
        # The negative lookahead is what makes a sanctioned root entrypoint
        # non-heavy at EVERY command position, matching the (a2) skip-check
        # above (EI-19419178369405401). Bare `npm test` / `npm run test` /
        # `npm run test:unit` are unaffected — none of them is in the set — so
        # a workspace's own raw vitest stays gated exactly as before.
        r'|npm\s+(?:run\s+)?(?!(?:' + _ROOT_NPM_ENTRYPOINT_ALT + r')(?=\s|$))test(?::[\w-]+)?(?=\s|$)'
        r'|npm\s+run\s+build(?=\s|$)'
        r'|turbo\s+run\s+(?:test|build|typecheck)\b'
        r')',
        re.IGNORECASE,
    )
    # Use the same peeled command used for the pc-heavy bypass check so benign
    # wrappers such as `timeout 90` cannot hide a raw heavy command from the
    # admission gate while still allowing the blessed wrapper above through.
    if not heavy_re.search(_pc_lead):
        return
    # WI-10003344: raw TypeScript compiles can consume 11.2 GiB EACH while
    # load1 still looks healthy (reclaim stalls lower it). The load threshold
    # below cannot protect memory, and a raw compile never enters pc-heavy's
    # MemAvailable/PSI semaphore. Require the existing wrapper or root lint:tsc
    # entrypoint for compiler-shaped commands at every load level.
    raw_tsc_re = re.compile(anchor + r'(?:npx\s+)?tsc(?=\s|$)', re.IGNORECASE)
    if raw_tsc_re.search(_pc_lead):
        _pc_heavy_root = _canonical_tree_root() or os.path.realpath(
            os.environ.get('PAPERCUSP_CANONICAL_TREE')
            or os.path.join(os.path.expanduser('~/papercupai-workspace'), 'papercusp')
        )
        _pc_heavy = shlex.quote(os.path.join(_pc_heavy_root, 'scripts', 'pc-heavy.sh'))
        deny(
            f'heavy-command admission (WI-10003344): bare tsc bypasses the memory '
            f'slot budget even when host load is low. Run it under `{_pc_heavy} -- '
            f'<your command>` or use the self-throttling root `npm run lint:tsc` entrypoint.'
        )
    # Local load signal — captures ALL contributors (vitest+tsc+onnx+…), more
    # robust than counting only wrapped runs. Env overrides for tests.
    try:
        _ov = os.environ.get('PC_HEAVY_LOAD1_OVERRIDE')
        load1 = float(_ov) if _ov not in (None, '') else os.getloadavg()[0]
        cores = os.cpu_count() or 1
        _mx = os.environ.get('PC_HEAVY_MAX_LOAD1')
        # 1.0x cores, down from 1.5x (EI-19296434833105508, measured 2026-08-01):
        # under the old 192 threshold a 52-vitest + 35-tsc herd formed at load
        # ~111 and drove load1 to 216 — and the operator's heartbeat starts
        # failing from ~171 (EI-19294517824914302), so "healthy 1.0-1.3x" was
        # not in fact harmless. A denied caller loses nothing: the remedy
        # (pc-heavy / the wrapped root npm entrypoints, allowed above) QUEUES
        # for a slot instead of failing.
        max_load1 = float(_mx) if _mx not in (None, '') else round(1.0 * cores)
    except Exception:
        return  # can't read load/cores → fail-open
    if load1 > max_load1:
        _pc_heavy_root = _canonical_tree_root() or os.path.realpath(
            os.environ.get('PAPERCUSP_CANONICAL_TREE')
            or os.path.join(os.path.expanduser('~/papercupai-workspace'), 'papercusp')
        )
        _pc_heavy = shlex.quote(os.path.join(_pc_heavy_root, 'scripts', 'pc-heavy.sh'))
        deny(
            f'heavy-command admission (WI-3821): host load1={load1:.0f} is over the '
            f'{max_load1:.0f} threshold (~1x cores) — starting another bare vitest/tsc/'
            f'test build now piles onto a box whose operator liveness degrades past '
            f'~1.3x (this class melted the host to load 3000+ and triggered MCP-dark '
            f'cascades). Run it under `{_pc_heavy} -- <your command>` (waits '
            f'for a free build slot, runs niced), or use the self-throttling root '
            f'entrypoints (`npm run test:affected` / `test:file` / `lint:tsc`), which '
            f'pass this gate and queue politely. Kill-switch (prepend inline): '
            f'`PC_HEAVY_ADMISSION=off <your command>`.'
        )

try:
    _heavy_admission()
except Exception:
    pass  # admission control must never wedge a command

# ── Substitution pre-filter (bash-to-tool-substitution-2026-07-26, P-016) ───
# The bash→tool substitution registry claims commands by the VERB at the head
# of a command atom (`sed -n '1,80p' f`, `cat f`, `psql -c "SELECT …"`). Testing
# those verbs as bare substrings would be a disaster: `re.search('cat', cmd)`
# matches "concatenate", "duplicate", "categories" — so nearly every command
# would pay the HTTP round-trip this pre-filter exists to avoid.
#
# So this is a direct port of the server's own atomizer
# (packages/operator-core/lib/bash-substitution/atomize.ts): split on the same
# separators, peel the same runner/env prefixes, take the first token with any
# leading path stripped. Matching the server's definition of an ATOM here is not
# tidiness — a pre-filter that disagrees with the matcher silently drops the
# very commands a rule was written for, and that failure is invisible (no error,
# just an advisory that never fires).
_SUBST_SPLIT_RE = re.compile(r'\|\||&&|\||;|\n')
_SUBST_RUNNER_RE = re.compile(
    r'^(?:sudo\s+(?:-n\s+)?|nohup\s+|timeout\s+\S+\s+|time\s+|env\s+|command\s+|exec\s+)+')
_SUBST_ENV_RE = re.compile(r'^(?:[A-Za-z_][A-Za-z0-9_]*=\S*\s+)+')

# Atom heads any enabled registry row can claim. A SET (not a regex alternation)
# keeps this a cheap hash lookup on the hot path. The shell and TypeScript hooks
# cannot import application code, so `npm run gen:tool-routing` derives both
# copies from `BASH_GATE_PAIRS` plus their committed fixtures. Check mode refuses
# drift before CI; the fixture-replay tests independently prove every actionable
# atom still clears this prefilter. Broad `npm` remains phrase-routed below.
_SUBSTITUTION_HEADS = frozenset((
    # BEGIN GENERATED gen:tool-routing prefilter heads — do not edit by hand
    'cat',
    'curl',
    'date',
    'free',
    'git',
    'grep',
    'head',
    'journalctl',
    'lsof',
    'netstat',
    'nproc',
    'npx',
    'pgrep',
    'ps',
    'psql',
    'sed',
    'ss',
    'systemctl',
    'tail',
    'tsc',
    'uptime',
    'vitest',
    # END GENERATED gen:tool-routing prefilter heads
))

# Narrow phrases a substitution row claims whose bare head is too common for the
# set above (see the P-021 note). Byte-for-byte twin of the TS hook's
# SUBSTITUTION_PHRASE_RE; tested against the atom AFTER runner/env stripping.
#
# P-028 adds `npm install|ci|i` for the same reason `npm run test:file` is here
# rather than in the head set: `npm` fronts nearly every command in this repo,
# and `npm run lint` must keep paying nothing. The pair's own pattern is far
# narrower still (flags-only whole-tree reifies); this phrase only decides which
# atoms pay the operator round-trip at all.
_SUBSTITUTION_PHRASE_RE = re.compile(r'^npm\s+run\s+test:file\b|^npm\s+(?:install|ci|i)(?=\s|$)')


def _substitution_prefilter_hit(cmd):
    for part in _SUBST_SPLIT_RE.split(cmd):
        atom = part.strip()
        while True:
            stripped = _SUBST_ENV_RE.sub('', _SUBST_RUNNER_RE.sub('', atom))
            if stripped == atom:
                break
            atom = stripped
        if not atom:
            continue
        if _SUBSTITUTION_PHRASE_RE.search(atom):
            return True
        head = atom.split()[0].split('/')[-1].strip('({`$\'"')
        if head in _SUBSTITUTION_HEADS:
            return True
    return False


# Cheap local pre-filter — skip the HTTP round-trip for the commands that can
# touch neither a registered resource nor a substitution rule. Tokens mirror the
# seeded patterns.
try:
    _needs_check = bool(
        re.search(r'systemctl|overmind|psql|astro|build-desktop-sidecar|release-local|npm\s+run\s+(dev|build)', command)
    ) or _substitution_prefilter_hit(command) or _TRACKED_MUTATION
except Exception:
    _needs_check = False  # a pre-filter bug must never wedge a command
if not _needs_check:
    allow()

# Per-session owner (so the caller's OWN exclusive doesn't gate their own
# commands) — same precedence the file-lock hook uses.
env_sid = os.environ.get('PAPERCUSP_SID')
session_id = payload.get('session_id')
owner = (
    env_sid if isinstance(env_sid, str) and env_sid
    else session_id if isinstance(session_id, str) and session_id
    else agent_id
)

# `_meta.format = 'json'` is REQUIRED, not a nicety. `locks:check_command`
# returns a tabular `substitutions[]`, so the agent transport serializes the
# result as TOON by default — and the parse below is `json.loads`. Without this
# the parse throws, `inner` stays None, and the fail-open at the bottom of this
# block does exactly what it promises: every resource hold and every
# substitution row silently stops being enforced, with no error anywhere.
#
# That is not hypothetical — it is the state this call was in when P-028 tried
# to ship the registry's first `deny` and found the gate had been dead on BOTH
# hook paths. The suites never caught it because they stub the operator with
# JSON, which is the one thing it does not send. `_meta.format` is the
# documented negotiation channel for exactly this (a MACHINE parser declaring
# what it can decode); the OMP hook declares the same thing on its own call.
_payload_cwd = payload.get('cwd')
_request_cwd = _payload_cwd if isinstance(_payload_cwd, str) and _payload_cwd.strip() else os.getcwd()
# ── SCHEMA-SKEW TOLERANCE (WI-40602) ───────────────────────────────────────
# THIS HOOK AND THE TOOL IT CALLS SHIP ON DIFFERENT CLOCKS. The hook client is
# read live from the staging tree, so an edit here takes effect immediately;
# `locks:check_command` is served by the RELEASE CHECKOUT pinned to green `main`
# (git-pipeline-position.ts:335), so its schema only moves on deploy. Adding an
# argument therefore breaks the call the instant it lands and keeps it broken
# for as long as the green gate is red.
#
# That is not hypothetical: staging commit 8b824cae7f (2026-08-22T06:59:34Z)
# added `cwd` to both halves, and every hook call failed `invalid_args:
# Unrecognized key: "cwd"` from 08:31Z onward — 549 rejections across 8 agents
# in ~4h. Because an error response carries no `result`, all of them fell
# through to the fail-open `allow()` below, so the resource-gate stopped
# blocking real collisions and NOTHING surfaced it. The only symptom reached
# individual agents as "you called locks:check_command 16× and it failed",
# which reads as a detector bug about themselves and gets dismissed.
#
# So: send the optional arg, but never let it be load-bearing. On a rejection,
# retry once WITHOUT it. `cwd` only refines substitution path-matching, so the
# retry preserves the safety-critical exclusive-hold check in full and degrades
# only the advisory substitution half. Every failure path still ends at
# allow(), exactly as before — this can restore blocking, never invent it.
def _gate_request(include_optional_context):
    """POST one locks:check_command call. Returns the raw body, or None on transport failure."""
    _arguments = {'command': command}
    if include_optional_context:
        _arguments['cwd'] = _request_cwd
        if _TRACKED_MUTATION:
            _arguments['tracked_mutation'] = True
    body = json.dumps({
        'jsonrpc': '2.0', 'id': 1, 'method': 'tools/call',
        'params': {
            'name': 'locks:check_command',
            'arguments': _arguments,
            '_meta': {'format': 'json'},
        },
    }).encode()

    req = urllib.request.Request(
        operator_url.rstrip('/') + '/api/mcp?superuser=1&origin=hook&client='
        + urllib.parse.quote(owner, safe=''),
        data=body,
        headers={
            'Authorization': 'Bearer ' + token,
            'Content-Type': 'application/json',
            'Accept': 'application/json, text/event-stream',
        },
        method='POST',
    )
    try:
        resp = urllib.request.urlopen(req, timeout=4)
        return resp.read().decode('utf-8', errors='replace')
    except Exception as e:
        print(f'[resource-gate] operator unreachable ({e}); allowing (fail-open)', file=sys.stderr)
        return None


def _gate_result(raw):
    """Extract the JSON-RPC `result` from a raw (possibly SSE-framed) body, or None."""
    if not raw:
        return None
    for line in raw.splitlines():
        line = line.strip()
        if not line or line.startswith('event:'):
            continue
        if line.startswith('data:'):
            line = line[5:].strip()
        try:
            cand = json.loads(line)
            if isinstance(cand, dict) and 'result' in cand:
                return cand['result']
        except Exception:
            pass
    return None


raw_resp = _gate_request(True)
if raw_resp is None:
    allow()

result = _gate_result(raw_resp)
_schema_skew = (
    'Unrecognized key' in (raw_resp or '')
    and (
        result is None
        or (isinstance(result, dict) and result.get('isError') is True)
    )
)
if _schema_skew:
    print('[resource-gate] operator rejected an argument (schema skew — hook is ahead of '
          'the deployed tool; see WI-40602); retrying without optional context (`cwd` / '
          '`tracked_mutation`). Cwd-scoped substitution and GOAL Bash-mutation enforcement '
          'are degraded until the green gate deploys; resource-gate intact.', file=sys.stderr)
    raw_resp = _gate_request(False)
    if raw_resp is None:
        allow()
    result = _gate_result(raw_resp)

if not result:
    allow()

inner = None
for item in (result.get('content') or []):
    if item.get('type') == 'text':
        try:
            inner = json.loads(item['text'])
            break
        except Exception:
            continue
if not inner:
    allow()

if isinstance(inner.get('frozenLineageDenyReason'), str) and inner.get('frozenLineageDenyReason'):
    deny(inner['frozenLineageDenyReason'])

if isinstance(inner.get('goalModeEditDenyReason'), str) and inner.get('goalModeEditDenyReason'):
    deny(inner['goalModeEditDenyReason'])

# ── Substitution verdict (bash-to-tool-substitution-2026-07-26, P-016) ──────
# Same round-trip, second question: did a registry rule claim this command?
# This is a new matched CLASS inside the existing three-tier design, NOT a
# fourth mechanism (plan D-003) — `advise` reuses the ADVISORY channel three
# guards above already ride on, and `deny` reuses deny().
#
# The resource verdict is evaluated FIRST and wins: an exclusive hold means a
# peer is mid restart/migration right now, which is a live collision, whereas a
# substitution is a lasting suggestion about tool choice. Telling an agent
# "prefer capability:read" while its command would collide with a migration
# would bury the urgent message under the educational one.
#
# Wrapped whole in try/except: a malformed substitutions payload must degrade to
# the resource-only behaviour this file had before, never wedge a command.
try:
    _subs = inner.get('substitutions') or []
    _stier = inner.get('substitutionTier')
except Exception:
    _subs, _stier = [], None

if inner.get('decision') == 'block':
    matched = inner.get('matched') or []
    names = ', '.join(m.get('resource', '?') for m in matched) or 'a registered resource'
    deny(
        f"resource-gate: this command touches {names}, which has an exclusive hold "
        f"in flight (a peer is restarting/migrating it). Wait for the 'back up' "
        f"broadcast, or coordinate via locks:list / locks:acquire_resource. "
        f"Use the blessed wrapper (dev:restart / db:migrate) instead of a raw command."
    )

# How to call a tool that is not in the caller's loaded set (EI-18810711449496523).
# On a trimmed launch most advised tools are absent from the session surface
# entirely — 8 of the 10 the registry names, measured live — so an agent reads
# the row, spends a ToolSearch discovering the dead end, and falls back to bash.
# A PreToolUse payload never carries the tool surface, so this cannot be fixed by
# suppressing the row; it is fixed by naming the convention that always works.
#
# Kept BYTE-IDENTICAL to TOOLS_INVOKE_FALLBACK_HINT in the OMP hook
# (scripts/hooks/omp/coord-hook.ts) — the two hooks are asserted to teach the
# same thing, and coord-hook.test.ts pins this exact wording.
_INVOKE_HINT = (
    'Not in your loaded tool set? `tools:invoke { name, args }` dispatches any '
    'catalog tool server-side — a ToolSearch miss is not a dead end.'
)

try:
    if _stier in ('advise', 'deny') and _subs:
        # One line per claimed intent: the advisory_text is authored per row and
        # is the whole point of the registry — a tier that fires without it
        # teaches nothing, which is the dev:processes outcome migration 665's
        # CHECK constraint exists to prevent.
        # P-009: `invokeLine` is the EXECUTABLE form of the same advice — the
        # tool call with args already derived from THIS command, rendered
        # server-side. It is rendered there, not here, precisely so this Python
        # block and the OMP hook's TypeScript cannot format the same envelope
        # two different ways; both just print the string they were handed.
        #
        # It goes last in the block, after the prose: the advisory says why the
        # tool is better, `run:` says what to type.
        _lines = []
        _has_invoke = False
        for _s in _subs:
            _tool = _s.get('toolName') or '?'
            _text = (_s.get('advisoryText') or '').strip()
            _atom = (_s.get('atom') or '').strip()
            _invoke = (_s.get('invokeLine') or '').strip()
            _block = (
                '  • `%s` → %s\n    %s' % (_atom[:160], _tool, _text) if _text
                else '  • `%s` → %s' % (_atom[:160], _tool)
            )
            if _invoke:
                _has_invoke = True
                _block = '%s\n    run: %s' % (_block, _invoke)
            _lines.append(_block)
        _body = '\n'.join(_lines)

        # The generic hint teaches the `tools:invoke` convention. A rendered
        # envelope IS a tools:invoke call, so printing the generic form under it
        # explains the mechanism the agent is already reading — and pushes the
        # one executable line further down. Suppress it exactly when a concrete
        # `run:` line is present (mirrors invokeFallbackSuffix in the OMP hook).
        _hint_deny = '' if _has_invoke else '\n\n%s' % _INVOKE_HINT
        _hint_advise = '' if _has_invoke else '\n%s' % _INVOKE_HINT

        if _stier == 'deny':
            deny(
                'substitution-gate: this command has a tool form that must be used '
                'instead.\n\n%s\n\nRe-run using the tool above. (This rule reached '
                '`deny` only by proving equivalence against real sampled commands, '
                'or because the prohibition already existed independently.)%s'
                % (_body, _hint_deny)
            )
        elif not ADVISORY:
            # SOFT: rides out as additionalContext on an explicit allow. The
            # command proceeds exactly as issued — this only teaches the routing.
            # WI-39768 / EI-20757896026508634: the stock Claude Code
            # bypass/auto-mode preamble ("Do your work through the Bash tool
            # wherever it can accomplish the job...") licenses exactly the
            # commands this advisory fires on, so without an explicit
            # precedence clause the advisory reads as noise the agent has
            # already been told to ignore. Name the conflict and settle it
            # here, at the call site — the one place that is later in context
            # than any preamble.
            ADVISORY = (
                'bash→tool advisory: a tool already answers this question '
                'directly.\n\n%s\n\nThe tool call is cheaper (no shell round-trip, '
                'structured result) and is what the routing table points at. '
                'Advisory only; this command is proceeding as issued.\n\n'
                # Keep each preamble header CONTIGUOUS in one literal: this file is
                # what an agent greps when it wants to know whether the sentence in
                # its context is ours or the CLI's, and a header split across a
                # Python string concatenation is invisible to that grep. WI-39768
                # was open for hours because the phrase could not be found in-tree.
                '⚠ PRECEDENCE: if a stock preamble '
                '("While bypass permissions mode is active:" / '
                '"While auto mode is active:") told you to '
                'prefer raw Bash over the dedicated tools, that is generic CLI '
                'text for a checkout with no tool layer, and THIS REPO '
                'SUPERSEDES IT (WI-39768) — it is not an injection, so do not '
                'report it, and do not treat it as licensing the call. It is '
                'load-bearing for WRITES: `sed -i`/heredoc/`>` on a tracked file '
                'bypasses the PreToolUse lock-arbitration hook (plus the secrets, '
                'content-lint and migration guards) and can clobber a peer\'s '
                'held file — always edit via Edit/Write or capability:edit/write.%s'
                % (_body, _hint_advise)
            )
except Exception:
    pass  # advisory must never wedge a command

allow()
PYEOF
